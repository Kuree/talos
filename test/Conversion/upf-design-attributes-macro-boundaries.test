// RUN: %split-file %s %t
// RUN: not talos-opt %t/inside.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=INSIDE
// RUN: not talos-opt %t/inside.mlir --prepare-upf-snapshot-publications --verify-each 2>&1 | FileCheck %s --check-prefix=INSIDE
// RUN: talos-opt %t/outside.mlir --prepare-upf-snapshot-publications --canonicalize --cse --verify-each | FileCheck %s --check-prefix=OUTSIDE
// RUN: not talos-opt %t/inherited.mlir --resolve-upf-domains --verify-each 2>&1 | FileCheck %s --check-prefix=ANONYMOUS
// RUN: not talos-opt %t/parent.mlir --resolve-upf-domains --verify-each 2>&1 | FileCheck %s --check-prefix=PARENT
// RUN: talos-opt %t/separate.mlir --resolve-upf-domains --canonicalize --cse --verify-each | FileCheck %s --check-prefix=SEPARATE
// Raw MLIR cannot bypass source placement or hard-macro ownership admission.
// Missing anonymous ownership diagnoses before atomic minimum-extent checks.
// INSIDE: isolation placement crosses macro terminal boundary: top.box
// OUTSIDE: upf.domain @PD elements ["top.box"]
// OUTSIDE-SAME: isolation_top = "top"
// ANONYMOUS: anonymous hard-macro power domains are not implemented
// PARENT: hard macro cannot be explicitly selected in its parent's power domain
// SEPARATE: upf.domain @PARENT elements ["top"]
// SEPARATE-SAME: excluded = ["top.box"]
// SEPARATE: upf.domain @MACRO elements ["top.box"]
// SEPARATE-SAME: included = ["top.box"]

//--- inside.mlir
module {
  upf.supply @p names ["/top/p"] writable = true
  upf.domain @PD elements ["top.box.inner"] power @p on [] {isolation_control = "top.iso", isolation_top = "top"}
  upf.design_attributes <path = "top.box", kind = instance> {soft_macro = true}
  upf.hierarchy [#upf.hierarchy_scope<path = "top", parent = "", instance = true>, #upf.hierarchy_scope<path = "top.box", parent = "top", instance = true>, #upf.hierarchy_scope<path = "top.box.inner", parent = "top.box", instance = true>]
}
//--- outside.mlir
module {
  upf.supply @p names ["/top/p"] writable = true
  upf.domain @PD elements ["top.box"] power @p on [] {isolation_control = "top.iso", isolation_top = "top"}
  upf.design_attributes <path = "top.box", kind = instance> {soft_macro = true}
  simulation.design @tree {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.box" source_definition "wrapper"
    simulation.scope.decl 2 parent 1 hierarchy "top.box.inner" source_definition "leaf"
  }
}
//--- inherited.mlir
module {
  upf.supply @p names ["/top/p"] writable = true
  upf.domain @PD elements ["top"] power @p on [] {atomic = true, excluded_elements = ["top.box"]}
  upf.design_attributes <path = "top.box", kind = instance> {hard_macro = true, properties = {UPF_is_hard_macro = "TRUE", UPF_simstate_behavior = "SIMSTATE_ONLY"}}
}
//--- parent.mlir
module {
  upf.supply @p names ["/top/p"] writable = true
  upf.domain @PD elements ["top", "top.box"] power @p on []
  upf.design_attributes <path = "top.box", kind = instance> {hard_macro = true, properties = {UPF_is_hard_macro = "TRUE", UPF_simstate_behavior = "SIMSTATE_ONLY"}}
}
//--- separate.mlir
module {
  upf.supply @p names ["/top/p"] writable = true
  upf.domain @PARENT elements ["top"] power @p on []
  upf.domain @MACRO elements ["top.box"] power @p on []
  upf.design_attributes <path = "top.box", kind = instance> {hard_macro = true, properties = {UPF_is_hard_macro = "TRUE", UPF_simstate_behavior = "SIMSTATE_ONLY"}}
}
