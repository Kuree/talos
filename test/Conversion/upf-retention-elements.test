// RUN: %split-file %s %t
// RUN: talos-opt %t/nested.mlir --canonicalize --cse --verify-each -o %t.intent && talos-opt %t.intent | FileCheck %s --check-prefix=INTENT
// RUN: talos-opt %t.intent --elaborate-upf --prepare-upf-snapshot-publications --verify-each -o %t.lower && FileCheck %s --check-prefix=LOWER --input-file=%t.lower --implicit-check-not=upf.retention_elements
// RUN: talos-opt %t.lower --canonicalize --cse --verify-each --canonicalize --cse --verify-each -o /dev/null
// RUN: not talos-opt %t/alias.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=ALIAS
// RUN: talos-opt %t/rootless.mlir --split-input-file --elaborate-upf --verify-each | FileCheck %s --check-prefix=ROOTLESS --implicit-check-not=upf. --implicit-check-not=__upf --implicit-check-not=simulation.event.snapshot
// Dense parent-before-child IDs do not define DenseMap traversal order. Preserve
// typed symbol references and origin granularity through CSE/roundtrips, then
// consume constraints once. Global list aliases may be outside the state PD.
// INTENT: upf.retention_elements @G scope "top" elements [#upf.retention_element<path = "top.cluster", kind = instance>]
// INTENT: elements = [@G]
// LOWER-DAG: "__upf_retention.PD.KEEP.backing.0"
// LOWER-DAG: "__upf_retention.PD.KEEP.backing.1"
// LOWER-DAG: "__upf_retention.PD.KEEP.backing.2"
// ALIAS: collective retention list has uncovered state while another member is retained
// ALIAS-SAME: top.cluster.middle.q
// ROOTLESS: simulation.design @empty
// ROOTLESS: simulation.design @dormant

//--- nested.mlir
#rtc = #upf.expression<[#upf.token<opcode = control, control = "top.rtc">]>
module {
  upf.retention_elements @G scope "top" elements [#upf.retention_element<path = "top.cluster", kind = instance>] {excluded = []}
  upf.supply @p names ["/top/P"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/G"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @primary functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, associated = [@local]}
  upf.supply_set @local functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "KEEP", associated = [@primary]}
  upf.supply_set @ret functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "KEEP"}
  upf.domain @PD elements ["top.cluster"] power @p on [] {ground = @g, primary = @primary, policies = [@primary], retentions = [#upf.retention<name = "KEEP", scope = "top", elements = [@G], excluded = [], retentionSupply = @ret, primarySupply = @local, condition = #rtc>]}
  simulation.design @nested {
    simulation.scope.decl 1 parent 0 hierarchy "top.padding1" source_definition "empty"
    simulation.scope.decl 2 parent 0 hierarchy "top.padding2" source_definition "empty"
    simulation.scope.decl 3 parent 0 hierarchy "top.padding3" source_definition "empty"
    simulation.scope.decl 4 parent 0 hierarchy "top.padding4" source_definition "empty"
    simulation.scope.decl 5 parent 0 hierarchy "top.padding5" source_definition "empty"
    simulation.scope.decl 6 parent 0 hierarchy "top.padding6" source_definition "empty"
    simulation.scope.decl 7 parent 0 hierarchy "top.padding7" source_definition "empty"
    simulation.scope.decl 8 parent 0 hierarchy "top.padding8" source_definition "empty"
    simulation.scope.decl 9 parent 0 hierarchy "top.padding9" source_definition "empty"
    simulation.scope.decl 10 parent 0 hierarchy "top.padding10" source_definition "empty"
    simulation.scope.decl 11 parent 0 hierarchy "top.padding11" source_definition "empty"
    simulation.scope.decl 12 parent 0 hierarchy "top.padding12" source_definition "empty"
    simulation.scope.decl 14 parent 13 hierarchy "top.cluster.middle" source_definition "middle"
    simulation.scope.decl 15 parent 14 hierarchy "top.cluster.middle.leaf" source_definition "leaf"
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 13 parent 0 hierarchy "top.cluster" source_definition "cluster"
    simulation.storage.decl 0 in 13 : i8 design hierarchy "top.cluster.q"
    simulation.storage.decl 1 in 14 : i8 design hierarchy "top.cluster.middle.q"
    simulation.storage.decl 2 in 15 : i8 design hierarchy "top.cluster.middle.leaf.q"
    simulation.storage.decl 3 in 0 : i1 design hierarchy "top.clk"
    simulation.storage.decl 4 in 0 : i1 design hierarchy "top.rtc"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 55 in 15 always hierarchy "top.cluster.middle.leaf.writer"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @writer(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @writer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 55 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %r = simulation.context.storage %ctx[1] : !simulation.ref<i8>
      %s = simulation.context.storage %ctx[2] : !simulation.ref<i8>
      %clk = simulation.context.storage %ctx[3] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^body {schedule.repeating_always_wait} : !simulation.ref<i1>
    ^body:
      %value = arith.constant 1 : i8
      simulation.nba.enqueue %value to %q : (i8, !simulation.ref<i8>) -> ()
      simulation.nba.enqueue %value to %r : (i8, !simulation.ref<i8>) -> ()
      simulation.nba.enqueue %value to %s : (i8, !simulation.ref<i8>) -> ()
      cf.br ^wait
    }
  }
}

//--- alias.mlir
#rtc = #upf.expression<[#upf.token<opcode = control, control = "top.rtc">]>
module {
  upf.retention_elements @G scope "top" elements [#upf.retention_element<path = "top.q_alias", kind = signal>, #upf.retention_element<path = "top.cluster.middle.q", kind = signal>] {excluded = [], purpose = 1 : i32}
  upf.supply @p names ["/top/P"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/G"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @primary functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, associated = [@local]}
  upf.supply_set @local functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "KEEP", associated = [@primary]}
  upf.supply_set @ret functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "KEEP"}
  upf.domain @PD elements ["top.cluster"] power @p on [] {ground = @g, primary = @primary, policies = [@primary], retentions = [#upf.retention<name = "KEEP", scope = "top", elements = [#upf.retention_element<path = "top.cluster.q", kind = signal>], excluded = [], retentionSupply = @ret, primarySupply = @local, condition = #rtc>]}
  simulation.design @nested {
    simulation.scope.decl 1 parent 0 hierarchy "top.padding1" source_definition "empty"
    simulation.scope.decl 2 parent 0 hierarchy "top.padding2" source_definition "empty"
    simulation.scope.decl 3 parent 0 hierarchy "top.padding3" source_definition "empty"
    simulation.scope.decl 4 parent 0 hierarchy "top.padding4" source_definition "empty"
    simulation.scope.decl 5 parent 0 hierarchy "top.padding5" source_definition "empty"
    simulation.scope.decl 6 parent 0 hierarchy "top.padding6" source_definition "empty"
    simulation.scope.decl 7 parent 0 hierarchy "top.padding7" source_definition "empty"
    simulation.scope.decl 8 parent 0 hierarchy "top.padding8" source_definition "empty"
    simulation.scope.decl 9 parent 0 hierarchy "top.padding9" source_definition "empty"
    simulation.scope.decl 10 parent 0 hierarchy "top.padding10" source_definition "empty"
    simulation.scope.decl 11 parent 0 hierarchy "top.padding11" source_definition "empty"
    simulation.scope.decl 12 parent 0 hierarchy "top.padding12" source_definition "empty"
    simulation.scope.decl 14 parent 13 hierarchy "top.cluster.middle" source_definition "middle"
    simulation.scope.decl 15 parent 14 hierarchy "top.cluster.middle.leaf" source_definition "leaf"
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 13 parent 0 hierarchy "top.cluster" source_definition "cluster"
    simulation.storage.decl 0 in 13 : i8 design hierarchy "top.cluster.q"
    simulation.port.decl 0 in 0 source 0 net = false at 0 : i8 output ordinal 0 hierarchy "top.q_alias"
    simulation.storage.decl 1 in 14 : i8 design hierarchy "top.cluster.middle.q"
    simulation.storage.decl 2 in 15 : i8 design hierarchy "top.cluster.middle.leaf.q"
    simulation.storage.decl 3 in 0 : i1 design hierarchy "top.clk"
    simulation.storage.decl 4 in 0 : i1 design hierarchy "top.rtc"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 55 in 15 always hierarchy "top.cluster.middle.leaf.writer"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @writer(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @writer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 55 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %r = simulation.context.storage %ctx[1] : !simulation.ref<i8>
      %s = simulation.context.storage %ctx[2] : !simulation.ref<i8>
      %clk = simulation.context.storage %ctx[3] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^body {schedule.repeating_always_wait} : !simulation.ref<i1>
    ^body:
      %value = arith.constant 1 : i8
      simulation.nba.enqueue %value to %q : (i8, !simulation.ref<i8>) -> ()
      simulation.nba.enqueue %value to %r : (i8, !simulation.ref<i8>) -> ()
      simulation.nba.enqueue %value to %s : (i8, !simulation.ref<i8>) -> ()
      cf.br ^wait
    }
  }
}

//--- rootless.mlir
module {
  upf.hierarchy [#upf.hierarchy_scope<path = "top", parent = "", instance = true>]
  upf.retention_elements @EMPTY scope "top" elements [] {excluded = []}
  simulation.design @empty {
    simulation.scope.decl 0 hierarchy "top"
  }
}
// -----
module {
  upf.retention_elements @G scope "top" elements [#upf.retention_element<path = "top", kind = instance>] {excluded = []}
  upf.design_attributes <path = "top", kind = instance> {retention = 0 : i32}
  simulation.design @dormant {
    simulation.scope.decl 0 hierarchy "top"
    simulation.storage.decl 0 in 0 : i8 design hierarchy "top.q"
  }
}
