// RUN: %split-file %s %t
// RUN: talos-opt %t/valid.mlir --elaborate-upf --canonicalize --cse --verify-each | FileCheck %s --check-prefix=VALID --implicit-check-not=upf.
// RUN: talos-opt %t/binding.mlir --elaborate-upf --verify-each | FileCheck %s --check-prefix=BINDING --implicit-check-not=upf.
// RUN: not talos-opt %t/disabled.mlir --prepare-upf-snapshot-publications --verify-each 2>&1 | FileCheck %s --check-prefix=DISABLED
// RUN: not talos-opt %t/partial.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=PARTIAL
// RUN: not talos-opt %t/opaque.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=OPAQUE
// RUN: not talos-opt %t/sideeffect.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=EFFECT
// The executable IR shares the source preflight. Preserve immutable formal
// identities and clamp only the marked publication, never incidental writes.
// VALID: arith.select
// VALID: simulation.ref.store
// BINDING: simulation.design @design
// DISABLED: per-object disabled simstate semantics are not implemented
// PARTIAL: partial predefined port policies are not implemented
// OPAQUE: isolation of opaque output ports requires logical port views
// EFFECT: isolation of side-effectful or split output connections requires publication views

//--- valid.mlir
module {
  upf.supply @p names ["/top/p"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/g"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @CORE functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"]
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @CORE, isolation_control = "top.iso", isolation_top = "top.dut", isolation_diff_supply_only = false}
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : !simulation.logic<1> design hierarchy "top.out"
    simulation.storage.decl 2 in 0 : !simulation.logic<1> design hierarchy "top.iso"
    simulation.storage.decl 3 in 0 : !simulation.logic<1> design hierarchy "top.mark"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @connection(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @connection(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 10 : i32, code_unit_id = 1 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %out = simulation.context.storage %ctx[1] : !simulation.ref<!simulation.logic<1>>
      %data = simulation.ref.load %q : !simulation.ref<!simulation.logic<1>> -> !simulation.logic<1>
      %value = upf.port_value %data actor 1 : !simulation.logic<1>
      simulation.ref.store %value to %out : !simulation.logic<1>, !simulation.ref<!simulation.logic<1>>
      simulation.return
    }
  }
}
//--- binding.mlir
module {
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} { simulation.return }
  }
}
//--- disabled.mlir
module {
 upf.supply @p names ["/top/P"] writable = true
 upf.domain @PD elements ["top.dut"] power @p on []
 upf.port_attributes "top.dut.q" at 0 width 1 of 1 properties {UPF_simstate_behavior = "DISABLE"} scope "top" top "top"
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} { simulation.return }
  }
}
//--- partial.mlir
module {
 upf.port_attributes "top.dut.q" at 0 width 1 of 2 properties {UPF_simstate_behavior = "ENABLE"} scope "top" top "top"
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} { simulation.return }
  }
}
//--- opaque.mlir
module {
  upf.supply @p names ["/top/p"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/g"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @CORE functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"]
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @CORE, isolation_control = "top.iso", isolation_top = "top.dut", isolation_diff_supply_only = false}
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : !simulation.logic<1> design hierarchy "top.out"
    simulation.storage.decl 2 in 0 : !simulation.logic<1> design hierarchy "top.iso"
    simulation.storage.decl 3 in 0 : !simulation.logic<1> design hierarchy "top.mark"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1 {opaque = true}
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @connection(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @connection(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 10 : i32, code_unit_id = 1 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %out = simulation.context.storage %ctx[1] : !simulation.ref<!simulation.logic<1>>
      %data = simulation.ref.load %q : !simulation.ref<!simulation.logic<1>> -> !simulation.logic<1>
      %value = upf.port_value %data actor 1 : !simulation.logic<1>
      simulation.ref.store %value to %out : !simulation.logic<1>, !simulation.ref<!simulation.logic<1>>
      simulation.return
    }
  }
}
//--- sideeffect.mlir
module {
  upf.supply @p names ["/top/p"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/g"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @CORE functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"]
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @CORE, isolation_control = "top.iso", isolation_top = "top.dut", isolation_diff_supply_only = false}
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : !simulation.logic<1> design hierarchy "top.out"
    simulation.storage.decl 2 in 0 : !simulation.logic<1> design hierarchy "top.iso"
    simulation.storage.decl 3 in 0 : !simulation.logic<1> design hierarchy "top.mark"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @connection(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @connection(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 10 : i32, code_unit_id = 1 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %out = simulation.context.storage %ctx[1] : !simulation.ref<!simulation.logic<1>>
      %data = simulation.ref.load %q : !simulation.ref<!simulation.logic<1>> -> !simulation.logic<1>
      %value = upf.port_value %data actor 1 : !simulation.logic<1>
      %mark = simulation.context.storage %ctx[3] : !simulation.ref<!simulation.logic<1>>
      simulation.ref.store %data to %mark : !simulation.logic<1>, !simulation.ref<!simulation.logic<1>>
      simulation.ref.store %value to %out : !simulation.logic<1>, !simulation.ref<!simulation.logic<1>>
      simulation.return
    }
  }
}
