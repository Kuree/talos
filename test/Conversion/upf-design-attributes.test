  upf.domain @PD elements ["top.cluster"] power @p on [] {ground = @g, primary = @primary, policies = [@primary], retentions = [#upf.retention<name = "KEEP", scope = "top.cluster", top = "top.cluster", elements = [], domainDefault = true, excluded = [], retentionSupply = @ret, primarySupply = @local, condition = #rtc>]}
  upf.design_attributes <path = "top.cluster", kind = instance> {soft_macro = true}
  simulation.design @nested {
    simulation.scope.decl 1 parent 0 hierarchy "top.padding1" source_definition "empty"
    simulation.scope.decl 2 parent 0 hierarchy "top.padding2" source_definition "empty"
    simulation.scope.decl 3 parent 0 hierarchy "top.padding3" source_definition "empty"
