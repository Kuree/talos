// RUN: %split-file %s %t
// RUN: talos-opt %t/active.mlir --prepare-upf-snapshot-publications -o %t.once.mlir
// RUN: FileCheck %s --check-prefix=ACTIVE --implicit-check-not=simulation.publication.batch < %t.once.mlir
// RUN: talos-opt %t.once.mlir --prepare-upf-snapshot-publications -o %t.twice.mlir
// RUN: diff %t.once.mlir %t.twice.mlir
// RUN: talos-opt %t/inactive.mlir --prepare-upf-snapshot-publications | FileCheck %s --check-prefix=OFF --implicit-check-not=snapshot
// RUN: talos-opt %t/cfg.mlir --prepare-upf-snapshot-publications | FileCheck %s --check-prefix=CFG
// RUN: talos-opt %t/argref.mlir --prepare-upf-snapshot-publications | FileCheck %s --check-prefix=ARG
// IEEE 1801-2018 6.50: barriers precede optimization, including in helpers
// and root initializers. Only proven automatic destinations may omit them.
// The marker enables rescanning; it does not mean preparation is complete.
// ACTIVE: simulation.snapshot_publications
// ACTIVE-LABEL: simulation.func @root
// ACTIVE: simulation.ref.store
// ACTIVE-NEXT: simulation.event.snapshot.flush
// ACTIVE-LABEL: simulation.func private @helper
// ACTIVE: simulation.ref.store
// ACTIVE-NEXT: simulation.event.snapshot.flush
// ACTIVE-NEXT: simulation.ref.store
// ACTIVE-NEXT: simulation.event.snapshot.flush
// ACTIVE-NEXT: simulation.return
// ACTIVE-LABEL: simulation.func private @local_observer
// ACTIVE: simulation.ref.store
// ACTIVE-NEXT: simulation.ref.load
// ACTIVE-NOT: simulation.event.snapshot.flush
// ACTIVE: simulation.return
// OFF: simulation.ref.store
// OFF-NEXT: simulation.return
// CFG-LABEL: simulation.func @local_join
// CFG: simulation.ref.store
// CFG-NEXT: simulation.return
// CFG-LABEL: simulation.func @mixed_join
// CFG: simulation.ref.store
// CFG-NEXT: simulation.event.snapshot.flush
// CFG-NEXT: simulation.return
// CFG-LABEL: simulation.func @rootless
// CFG: simulation.ref.store
// CFG-NEXT: simulation.event.snapshot.flush
// ARG-LABEL: simulation.func @aliases
// ARG: simulation.argument_ref.store
// ARG-NEXT: simulation.argument_ref.store
// ARG-NEXT: simulation.event.snapshot.flush
// ARG-NEXT: simulation.return

//--- active.mlir
module attributes {simulation.snapshot_publications} {
  simulation.design @active {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : i8 design
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 function hierarchy "top.helper"
    simulation.code_unit.decl 3 in 0 observer hierarchy "top.local"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %ref = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %a = arith.constant 17 : i8
      %b = arith.constant 34 : i8
      simulation.publication.batch_begin %ctx
      simulation.ref.store %a to %ref : i8, !simulation.ref<i8>
      cf.br ^end
    ^end:
      simulation.publication.batch_end %ctx
      simulation.call @helper(%ctx, %ref, %a, %b) : (!simulation.context, !simulation.ref<i8>, i8, i8) -> ()
      simulation.return
    }
    simulation.func private @helper(%ctx: !simulation.context {simulation.capture_kind = 0 : i32},
        %ref: !simulation.ref<i8> {simulation.capture_kind = 1 : i32},
        %a: i8 {simulation.capture_kind = 1 : i32}, %b: i8 {simulation.capture_kind = 1 : i32})
        attributes {entry_kind = 8 : i32, code_unit_id = 2 : i64} {
      simulation.ref.store %a to %ref : i8, !simulation.ref<i8>
      simulation.ref.store %b to %ref : i8, !simulation.ref<i8>
      simulation.return
    }
    simulation.func private @local_observer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) -> i1
        attributes {entry_kind = 14 : i32, code_unit_id = 3 : i64} {
      %false = arith.constant false
      %true = arith.constant true
      %local = simulation.ref.alloc %false : i1 -> !simulation.ref<i1>
      simulation.ref.store %true to %local : i1, !simulation.ref<i1>
      %value = simulation.ref.load %local : !simulation.ref<i1> -> i1
      simulation.return %value : i1
    }
  }
}

//--- inactive.mlir
module {
  simulation.design @inactive {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : i8 design
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %ref = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %a = arith.constant 17 : i8
      simulation.ref.store %a to %ref : i8, !simulation.ref<i8>
      simulation.return
    }
  }
}

//--- cfg.mlir
module attributes {simulation.snapshot_publications} {
  simulation.design @cfg {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : i8 design
    simulation.storage.decl 1 in 0 : i8 automatic
    simulation.code_unit.decl 1 in 0 function hierarchy "top.local_join"
    simulation.code_unit.decl 2 in 0 function hierarchy "top.mixed_join"
    simulation.code_unit.decl 3 in 0 function hierarchy "top.rootless"
    simulation.func @local_join(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}, %cond: i1 {simulation.capture_kind = 1 : i32})
        attributes {entry_kind = 8 : i32, code_unit_id = 1 : i64} {
      %a = simulation.context.storage %ctx[1] : !simulation.ref<i8>
      %zero = arith.constant 0 : i8
      %b = simulation.ref.alloc %zero : i8 -> !simulation.ref<i8>
      cf.cond_br %cond, ^join(%a : !simulation.ref<i8>), ^join(%b : !simulation.ref<i8>)
    ^join(%ref: !simulation.ref<i8>):
      %slice = simulation.ref.extract %ref from 0 : !simulation.ref<i8> -> !simulation.ref<i4>
      %value = arith.constant 3 : i4
      simulation.ref.store %value to %slice : i4, !simulation.ref<i4>
      simulation.return
    }
    simulation.func @mixed_join(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}, %cond: i1 {simulation.capture_kind = 1 : i32})
        attributes {entry_kind = 8 : i32, code_unit_id = 2 : i64} {
      %a = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %zero = arith.constant 0 : i8
      %b = simulation.ref.alloc %zero : i8 -> !simulation.ref<i8>
      cf.cond_br %cond, ^join(%a : !simulation.ref<i8>), ^join(%b : !simulation.ref<i8>)
    ^join(%ref: !simulation.ref<i8>):
      %value = arith.constant 3 : i8
      simulation.ref.store %value to %ref : i8, !simulation.ref<i8>
      simulation.return
    }
    simulation.func @rootless(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 8 : i32, code_unit_id = 3 : i64} {
      simulation.return
    ^cycle(%ref: !simulation.ref<i8>):
      %value = arith.constant 3 : i8
      simulation.ref.store %value to %ref : i8, !simulation.ref<i8>
      cf.br ^cycle(%ref : !simulation.ref<i8>)
    }
  }
}

//--- argref.mlir
module attributes {simulation.snapshot_publications} {
  simulation.design @argref {
    simulation.scope.decl 0
    simulation.code_unit.decl 1 in 0 function hierarchy "top.aliases"
    simulation.func @aliases(%ctx: !simulation.context {simulation.capture_kind = 0 : i32},
        %formal: !simulation.argument_ref<i8> {simulation.capture_kind = 1 : i32})
        attributes {entry_kind = 8 : i32, code_unit_id = 1 : i64} {
      %value = arith.constant 17 : i8
      %local = simulation.ref.alloc %value : i8 -> !simulation.ref<i8>
      %erased = simulation.argument_ref.from_ref %local : !simulation.ref<i8> -> !simulation.argument_ref<i8>
      %again = simulation.argument_ref.retype %erased : !simulation.argument_ref<i8> -> !simulation.argument_ref<i8>
      simulation.argument_ref.store %value to %again : i8, !simulation.argument_ref<i8>
      simulation.argument_ref.store %value to %formal : i8, !simulation.argument_ref<i8>
      simulation.return
    }
  }
}
