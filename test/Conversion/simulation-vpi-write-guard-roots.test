// RUN: talos-opt %S/simulation-native-group-external-clock.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph{vpi=full},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),encode-talos-sim-to-bytecode{vpi=full},convert-talos-sim-processes-to-llvm-coroutines)' -o %t.mlir
// RUN: FileCheck %s < %t.mlir
// RUN: talos-opt %t.mlir --emit-bytecode -o %t.mlirbc
// RUN: talos-translate --mlir-to-llvmir %t.mlirbc | opt -passes=verify -disable-output

// LRM 38.34/10.6.2: keep each owner's exact root dependencies and clean
// fast-flag test. Use the shared runtime scan instead of generating a call
// sequence per owner. The scan still visits every root for diagnostics.
