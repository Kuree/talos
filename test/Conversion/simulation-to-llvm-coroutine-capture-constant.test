// RUN: %split-file %s %t
// RUN: talos-opt %t/native.mlir --convert-talos-sim-processes-to-llvm-coroutines --verify-each -o %t/native.lowered.mlir
// RUN: talos-opt %t/wasm.mlir --convert-talos-sim-processes-to-llvm-coroutines --verify-each -o %t/wasm.lowered.mlir
// RUN: FileCheck %s < %t/native.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t/native.lowered.mlir | opt -S -passes='verify,coro-early,coro-split<reuse-storage>,verify' -o %t/native.ll
// A known-bit payload spawns a four-state capture. Packed ABI specialization
// introduces a constant zero unknown plane after continuation CFG threading.
// The resume dispatch bypasses the original entry, so that constant must
// dominate the resumed NBA as well. Verify native64/wasm32 MLIR and LLVM's
// coroutine splitting. IEEE 1800-2023 4.4.2.4: retain the sampled NBA payload.
// CHECK-LABEL: llvm.func @child.__talos_coro_ramp
// CHECK: llvm.call @talos_rt_v1_scheduler_nba
// CHECK: llvm.intr.coro.begin
// CHECK-LABEL: llvm.func @child.__talos_native_requirements

//--- native.mlir
module attributes {
  llvm.data_layout = "e-p:64:64-i64:64-i32:32-i16:16-i8:8",
  llvm.target_triple = "x86_64-unknown-linux-gnu"
} {
  simulation.design @capture_zero {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : !simulation.logic<1> design
    simulation.storage.decl 1 in 0 : i1 design
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 fork hierarchy "top.child"
    simulation.func @root(
        %ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {code_unit_id = 1 : i64, entry_kind = 0 : i32} {
      %dst = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %src = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %bits = simulation.ref.load %src : !simulation.ref<i1> -> i1
      %logic = simulation.logic.from_bits %bits : i1 -> !simulation.logic<1>
      %child = simulation.spawn @child(%ctx, %dst, %logic) :
          !simulation.context, !simulation.ref<!simulation.logic<1>>, !simulation.logic<1>
          -> !simulation.process
      simulation.return
    }
    simulation.func private @child(
        %ctx: !simulation.context {simulation.capture_kind = 0 : i32},
        %dst: !simulation.ref<!simulation.logic<1>> {simulation.capture_kind = 1 : i32},
        %value: !simulation.logic<1> {simulation.capture_kind = 1 : i32})
        attributes {code_unit_id = 2 : i64, entry_kind = 13 : i32} {
      %delay = simulation.time.constant 1
      simulation.suspend.delay %delay to ^resume
    ^resume:
      simulation.nba.enqueue %value to %dst :
          (!simulation.logic<1>, !simulation.ref<!simulation.logic<1>>) -> ()
      simulation.return
    }
  }
}

//--- wasm.mlir
module attributes {
  llvm.data_layout = "e-p:32:32-i64:64-i32:32-i16:16-i8:8",
  llvm.target_triple = "wasm32-unknown-emscripten"
} {
  simulation.design @capture_zero {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : !simulation.logic<1> design
    simulation.storage.decl 1 in 0 : i1 design
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 fork hierarchy "top.child"
    simulation.func @root(
        %ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {code_unit_id = 1 : i64, entry_kind = 0 : i32} {
      %dst = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %src = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %bits = simulation.ref.load %src : !simulation.ref<i1> -> i1
      %logic = simulation.logic.from_bits %bits : i1 -> !simulation.logic<1>
      %child = simulation.spawn @child(%ctx, %dst, %logic) :
          !simulation.context, !simulation.ref<!simulation.logic<1>>, !simulation.logic<1>
          -> !simulation.process
      simulation.return
    }
    simulation.func private @child(
        %ctx: !simulation.context {simulation.capture_kind = 0 : i32},
        %dst: !simulation.ref<!simulation.logic<1>> {simulation.capture_kind = 1 : i32},
        %value: !simulation.logic<1> {simulation.capture_kind = 1 : i32})
        attributes {code_unit_id = 2 : i64, entry_kind = 13 : i32} {
      %delay = simulation.time.constant 1
      simulation.suspend.delay %delay to ^resume
    ^resume:
      simulation.nba.enqueue %value to %dst :
          (!simulation.logic<1>, !simulation.ref<!simulation.logic<1>>) -> ()
      simulation.return
    }
  }
}
