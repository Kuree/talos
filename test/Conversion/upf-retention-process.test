// RUN: %split-file %s %t
// RUN: talos-opt %t/process.mlir --canonicalize --cse --verify-each | talos-opt | FileCheck %s --check-prefix=INTENT
// RUN: talos-opt %t/process.mlir --prepare-upf-snapshot-publications --elaborate-upf --prepare-upf-snapshot-publications --canonicalize --cse --verify-each -o %t/lowered.mlir
// RUN: FileCheck %s --input-file=%t/lowered.mlir --check-prefix=LOWER --implicit-check-not=upf.domain --implicit-check-not=backing.2
// RUN: talos-opt %t/lowered.mlir --canonicalize --cse --verify-each -o /dev/null
// RUN: not talos-opt %t/missing.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=MISSING
// The exact source-process binding is independent of immutable code-unit ID
// and synthetic executable hierarchy. q is not a descendant of either name.
// Only inferred state intersecting the domain receives a hidden backing.
// INTENT: path = "top.P", kind = process
// INTENT: simulation.code_unit.decl 55 in 0 always hierarchy "top.stable_55" {source_process = "top.P"}
// LOWER-DAG: simulation.code_unit.decl 55 in 0 always hierarchy "top.stable_55" {source_process = "top.P"}
// LOWER-DAG: simulation.storage.decl {{.*}} "__upf_retention.PD.R.backing.0"
// LOWER-LABEL: simulation.func private @writer
// LOWER: simulation.power.nba.enqueue
// LOWER: simulation.nba.enqueue {{.*}} to %{{.*}} : (i8, !simulation.ref<i8>) -> ()
// MISSING: retention process selector has no source-code-unit binding: top.missing

//--- process.mlir
#rtc = #upf.expression<[#upf.token<opcode = control, control = "top.rtc">]>
module {
  upf.supply @p names ["/top/P"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/G"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @primary functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, associated = [@local]}
  upf.supply_set @local functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "R", associated = [@primary]}
  upf.supply_set @ret functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "R"}
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @primary, policies = [@primary], retentions = [#upf.retention<name = "R", scope = "top", elements = [#upf.retention_element<path = "top.P", kind = process>], excluded = [], retentionSupply = @ret, primarySupply = @local, condition = #rtc>]}
  simulation.design @process {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : i8 design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : i1 design hierarchy "top.clk"
    simulation.storage.decl 2 in 0 : i8 design hierarchy "top.outside"
    simulation.storage.decl 3 in 0 : i1 design hierarchy "top.rtc"
    simulation.code_unit.decl 2 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 55 in 0 always hierarchy "top.stable_55" {source_process = "top.P"}
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 2 : i64} {
      %process = simulation.spawn @writer(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @writer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 55 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %clk = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %outside = simulation.context.storage %ctx[2] : !simulation.ref<i8>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^body {schedule.repeating_always_wait} : !simulation.ref<i1>
    ^body:
      %value = arith.constant 1 : i8
      simulation.nba.enqueue %value to %q : (i8, !simulation.ref<i8>) -> ()
      simulation.nba.enqueue %value to %outside : (i8, !simulation.ref<i8>) -> ()
      cf.br ^wait
    }
  }
}

//--- missing.mlir
#one = #upf.expression<[#upf.token<opcode = constant, value = true, unknown = false>]>
module {
  upf.supply @p names ["/top/P"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/G"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @primary functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, associated = [@local]}
  upf.supply_set @local functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "R", associated = [@primary]}
  upf.supply_set @ret functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "R"}
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @primary, policies = [@primary], retentions = [#upf.retention<name = "R", scope = "top", elements = [#upf.retention_element<path = "top.missing", kind = process>], excluded = [], retentionSupply = @ret, primarySupply = @local, condition = #one>]}
  simulation.design @missing {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : i8 design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : i1 design hierarchy "top.clk"
    simulation.code_unit.decl 2 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 55 in 1 always hierarchy "top.dut.stable_55" {source_process = "top.dut.P"}
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 2 : i64} {
      %process = simulation.spawn @writer(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @writer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 55 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %clk = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^body {schedule.repeating_always_wait} : !simulation.ref<i1>
    ^body:
      %value = arith.constant 1 : i8
      simulation.nba.enqueue %value to %q : (i8, !simulation.ref<i8>) -> ()
      cf.br ^wait
    }
  }
}
