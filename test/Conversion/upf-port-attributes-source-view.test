// RUN: %split-file %s %t
// RUN: not talos-opt %t/mismatch.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=MISMATCH
// RUN: not talos-opt %t/debug.mlir --prepare-upf-snapshot-publications --verify-each 2>&1 | FileCheck %s --check-prefix=DEBUG
// A same-width publication from another source must not inherit the bound
// formal's supply proof or be rewritten as though it came from that formal.
// MISMATCH: isolation requires a marked value from its exact logical port source view
// A display name can provide an HDL escaped spelling only when it is the
// reflected formal name, not a second arbitrary semantic identity.
// DEBUG: port attribute consumer requires a reflected packed port

//--- mismatch.mlir
module {
  upf.supply @p names ["/top/p"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/g"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @CORE functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"]
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @CORE, isolation_control = "top.iso", isolation_top = "top.dut", isolation_diff_supply_only = true}
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : !simulation.logic<1> design hierarchy "top.out"
    simulation.storage.decl 2 in 0 : !simulation.logic<1> design hierarchy "top.iso"
    simulation.storage.decl 3 in 0 : !simulation.logic<1> design hierarchy "top.mark"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @connection(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @connection(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 10 : i32, code_unit_id = 1 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %out = simulation.context.storage %ctx[1] : !simulation.ref<!simulation.logic<1>>
      %data = simulation.ref.load %out : !simulation.ref<!simulation.logic<1>> -> !simulation.logic<1>
      %value = upf.port_value %data actor 1 : !simulation.logic<1>
      simulation.ref.store %value to %out : !simulation.logic<1>, !simulation.ref<!simulation.logic<1>>
      simulation.return
    }
  }
}

//--- debug.mlir
module {
  upf.supply @p names ["/top/p"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/g"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @CORE functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"]
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @CORE, isolation_control = "top.iso", isolation_top = "top.dut", isolation_diff_supply_only = true}
  upf.port_attributes "top.dut.\\other " at 0 width 1 of 1 properties {UPF_receiver_supply = "CORE"} scope "top.dut" top "top.dut" {receiver_supply = @CORE}
  simulation.design @design {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : !simulation.logic<1> design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : !simulation.logic<1> design hierarchy "top.out"
    simulation.storage.decl 2 in 0 : !simulation.logic<1> design hierarchy "top.iso"
    simulation.storage.decl 3 in 0 : !simulation.logic<1> design hierarchy "top.mark"
    simulation.port.decl 0 in 1 source 0 net = false at 0 : !simulation.logic<1> output ordinal 0 hierarchy "top.dut.q" debug "other"
    simulation.code_unit.decl 8 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 0 port_output hierarchy "top.dut.$port_connection_0"
    upf.port_binding scope 1 ordinal 0 actor 1
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 8 : i64} {
      %process = simulation.spawn @connection(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @connection(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 10 : i32, code_unit_id = 1 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<1>>
      %out = simulation.context.storage %ctx[1] : !simulation.ref<!simulation.logic<1>>
      %data = simulation.ref.load %out : !simulation.ref<!simulation.logic<1>> -> !simulation.logic<1>
      %value = upf.port_value %data actor 1 : !simulation.logic<1>
      simulation.ref.store %value to %out : !simulation.logic<1>, !simulation.ref<!simulation.logic<1>>
      simulation.return
    }
  }
}
