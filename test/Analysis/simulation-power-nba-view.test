// RUN: %split-file %s %t
// RUN: talos-opt %t/domain.mlir --test-talos-sim-state-domain -o /dev/null 2>&1 | FileCheck %s --check-prefix=DOMAIN
// RUN: talos-opt %t/domain.mlir --test-talos-local-unknown -o /dev/null 2>&1 | FileCheck %s --check-prefix=LOCAL
// RUN: talos-opt %t/domain.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph,talos-sim-verify-compute-graph),test-talos-native-aot-analysis)' -o %t.graph.mlir 2>&1 | FileCheck %s --check-prefix=AOT
// RUN: FileCheck %s --check-prefix=GRAPH < %t.graph.mlir
// RUN: talos-opt %t/steady.mlir --test-talos-steady-unknown -o /dev/null 2>&1 | FileCheck %s --check-prefix=STEADY
// IEEE 1801-2018 9.5.3: one partial, possibly deferred write may introduce
// X/Z, and remains on the runtime frontier. It cannot be treated as a whole
// overwrite of unknown state or as a write to its read-only epoch references.
// DOMAIN: state-domain @guarded_view_unknown
// DOMAIN-NOT: root storage
// DOMAIN: func @drive
// LOCAL: local-unknown @drive
// LOCAL: read after_guarded_view: written
// AOT: native-aot eligible=false fully=false
// AOT: reason retention NBA guards require runtime commit ordering
// GRAPH: nba_commit
// GRAPH-SAME: frontierSites = [0]
// GRAPH: effect_summary =
// GRAPH-SAME: effect = nba, resource = storage, target = descriptor, descriptor = 0
// GRAPH-SAME: dynamic = true, deferred = true
// STEADY: steady-unknown @guarded_view_partial
// STEADY-NOT: root 0:

//--- domain.mlir
module {
  simulation.design @guarded_view_unknown {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : !simulation.logic<8> design
    simulation.storage.decl 1 in 0 : i64 design
    simulation.code_unit.decl 1 in 0 initial hierarchy "top.drive"
    simulation.code_unit.decl 2 in 0 observer hierarchy "top.guard"
    simulation.func @drive(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 1 : i32, code_unit_id = 1 : i64} {
      %root = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<8>>
      %epoch = simulation.context.storage %ctx[1] : !simulation.ref<i64>
      %initial = simulation.logic.constant 0 : i8, 0 : i8 : !simulation.logic<8>
      simulation.ref.store %initial to %root : !simulation.logic<8>, !simulation.ref<!simulation.logic<8>>
      %data = simulation.logic.constant 0 : i4, -1 : i4 : !simulation.logic<4>
      %zero = arith.constant 0 : i64
      %upper = arith.constant 4 : i64
      %valid = arith.constant true
      %delay = simulation.time.constant 1
      %guard = simulation.observer.bind @guard values (%root : !simulation.ref<!simulation.logic<8>>) captures 0 : !simulation.observer<i1>
      simulation.power.nba.enqueue_view %ctx, %data in %root window (%zero, %upper) at %zero when %valid guard %guard epochs (%epoch, %zero, %epoch, %zero) after %delay : (!simulation.context, !simulation.logic<4>, !simulation.ref<!simulation.logic<8>>, i64, i64, i64, i1, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64, !simulation.time) -> ()
      %read = simulation.ref.load %root {test.read = "after_guarded_view"} : !simulation.ref<!simulation.logic<8>> -> !simulation.logic<8>
      simulation.return
    }
    simulation.func private @guard(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) -> i1 attributes {entry_kind = 14 : i32, code_unit_id = 2 : i64} {
      %one = arith.constant true
      simulation.return %one : i1
    }
  }
}

//--- steady.mlir
module {
  simulation.design @guarded_view_partial {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : !simulation.logic<8> design
    simulation.storage.decl 1 in 0 : i64 design
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 always hierarchy "top.repeat"
    simulation.code_unit.decl 3 in 0 observer hierarchy "top.guard"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %root = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<8>>
      %x = simulation.logic.constant 0 : i8, -1 : i8 : !simulation.logic<8>
      simulation.ref.store %x to %root : !simulation.logic<8>, !simulation.ref<!simulation.logic<8>>
      %p = simulation.spawn @repeat(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func @repeat(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 2 : i64} {
      %root = simulation.context.storage %ctx[0] : !simulation.ref<!simulation.logic<8>>
      %epoch = simulation.context.storage %ctx[1] : !simulation.ref<i64>
      %data = simulation.logic.constant 10 : i4, 0 : i4 : !simulation.logic<4>
      %zero = arith.constant 0 : i64
      %upper = arith.constant 4 : i64
      %valid = arith.constant true
      %guard = simulation.observer.bind @guard values (%root : !simulation.ref<!simulation.logic<8>>) captures 0 : !simulation.observer<i1>
      simulation.power.nba.enqueue_view %ctx, %data in %root window (%zero, %upper) at %zero when %valid guard %guard epochs (%epoch, %zero, %epoch, %zero) : (!simulation.context, !simulation.logic<4>, !simulation.ref<!simulation.logic<8>>, i64, i64, i64, i1, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.return
    }
    simulation.func private @guard(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) -> i1 attributes {entry_kind = 14 : i32, code_unit_id = 3 : i64} {
      %one = arith.constant true
      simulation.return %one : i1
    }
  }
}
