// RUN: %split-file %s %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.opt.o
// RUN: %target_cxx %t.opt.o %runtime_link_flags -o %t.opt.exe && %t.opt.exe | FileCheck %s
// IEEE 1801-2018 9.7.3: RTC already asserted at NBA commit suppresses
// both values and all output edge occurrences. A later assertion preserves
// data already committed. Captured epochs and cancellation apply to the pair.
// CHECK: before 0 0 0
// CHECK: after 1 1 1
// CHECK: epoch 1 1 1
// CHECK: cancel 1 1 1
// CHECK: cancel_backing 1 1 1 1 1 1
// CHECK: atomic 1 1 2

//--- design.mlir
module attributes {
  llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128",
  llvm.target_triple = "x86_64-unknown-linux-gnu"
} {
  simulation.design @power_nba {
    simulation.scope.decl 0 hierarchy "top"
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 initial hierarchy "top.drive"
    simulation.code_unit.decl 3 in 0 fork hierarchy "top.observe"
    simulation.code_unit.decl 4 in 0 observer hierarchy "top.guard"
    simulation.code_unit.decl 5 in 0 observer hierarchy "top.atomic_guard"
    simulation.storage.decl 0 in 0 : i1 design hierarchy "top.backing"
    simulation.storage.decl 1 in 0 : i1 design hierarchy "top.q"
    simulation.storage.decl 2 in 0 : i1 design hierarchy "top.rtc"
    simulation.storage.decl 3 in 0 : i64 design hierarchy "top.epoch"
    simulation.storage.decl 4 in 0 : i32 design hierarchy "top.edges"
    simulation.storage.decl 5 in 0 : i1 design hierarchy "top.aux_backing"
    simulation.storage.decl 6 in 0 : i1 design hierarchy "top.aux_q"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %b = simulation.context.storage %ctx[0] : !simulation.ref<i1>
      %q = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %rtc = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      %epoch = simulation.context.storage %ctx[3] : !simulation.ref<i64>
      %edges = simulation.context.storage %ctx[4] : !simulation.ref<i32>
      %auxb = simulation.context.storage %ctx[5] : !simulation.ref<i1>
      %auxq = simulation.context.storage %ctx[6] : !simulation.ref<i1>
      %zero = arith.constant false
      %z64 = arith.constant 0 : i64
      %z32 = arith.constant 0 : i32
      simulation.ref.store %zero to %b : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %q : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %rtc : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %auxb : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %auxq : i1, !simulation.ref<i1>
      simulation.ref.store %z64 to %epoch : i64, !simulation.ref<i64>
      simulation.ref.store %z32 to %edges : i32, !simulation.ref<i32>
      %o = simulation.spawn @observe(%ctx) : !simulation.context -> !simulation.process
      %d = simulation.spawn @drive(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func private @guard(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) -> i1
        attributes {entry_kind = 14 : i32, code_unit_id = 4 : i64, schedule.observer_width = 1 : i32, schedule.observer_four_state = false} {
      %rtc = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      %value = simulation.ref.load %rtc : !simulation.ref<i1> -> i1
      %one = arith.constant true
      %allowed = arith.xori %value, %one : i1
      simulation.return %allowed : i1
    }
    // The second half must reuse the decision made before backing changed.
    simulation.func private @atomic_guard(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) -> i1
        attributes {entry_kind = 14 : i32, code_unit_id = 5 : i64, schedule.observer_width = 1 : i32, schedule.observer_four_state = false} {
      %b = simulation.context.storage %ctx[0] : !simulation.ref<i1>
      %value = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %one = arith.constant true
      %allowed = arith.xori %value, %one : i1
      simulation.return %allowed : i1
    }
    simulation.func private @observe(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 13 : i32, code_unit_id = 3 : i64, internal, simulation.power_monitor, schedule.detached_controls, schedule.priority_signal_resume} {
      %q = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %edges = simulation.context.storage %ctx[4] : !simulation.ref<i32>
      %auxb = simulation.context.storage %ctx[5] : !simulation.ref<i1>
      %auxq = simulation.context.storage %ctx[6] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %q to ^body : !simulation.ref<i1>
    ^body:
      %old = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %one = arith.constant 1 : i32
      %next = arith.addi %old, %one : i32
      simulation.ref.store %next to %edges : i32, !simulation.ref<i32>
      cf.br ^wait
    }
    simulation.func private @drive(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 1 : i32, code_unit_id = 2 : i64} {
      %b = simulation.context.storage %ctx[0] : !simulation.ref<i1>
      %q = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %rtc = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      %epoch = simulation.context.storage %ctx[3] : !simulation.ref<i64>
      %edges = simulation.context.storage %ctx[4] : !simulation.ref<i32>
      %auxb = simulation.context.storage %ctx[5] : !simulation.ref<i1>
      %auxq = simulation.context.storage %ctx[6] : !simulation.ref<i1>
      %guard = simulation.observer.bind @guard values (%rtc : !simulation.ref<i1>) captures 0 : !simulation.observer<i1>
      %one = arith.constant true
      %zero = arith.constant false
      %z64 = arith.constant 0 : i64
      %one64 = arith.constant 1 : i64
      %stdout = arith.constant 1 : i32
      %delay = simulation.time.constant 1
      simulation.suspend.delay %delay to ^before
    ^before:
      simulation.nba.enqueue %one to %rtc : (i1, !simulation.ref<i1>) -> ()
      simulation.power.nba.enqueue %ctx, %one to %b, %q guard %guard epochs (%epoch, %z64, %epoch, %z64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.suspend.delay %delay to ^check_before
    ^check_before:
      %b0 = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %q0 = simulation.ref.load %q : !simulation.ref<i1> -> i1
      %e0 = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %fmt0 = simulation.bytes.constant "before %0d %0d %0d"
      simulation.display %ctx to %stdout(%fmt0, %b0, %q0, %e0) newline = true radix = <decimal> flags = [0,0,0,0] : !simulation.bytes, i1, i1, i32
      simulation.ref.store %zero to %rtc : i1, !simulation.ref<i1>
      simulation.power.nba.enqueue %ctx, %one to %b, %q guard %guard epochs (%epoch, %z64, %epoch, %z64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.nba.enqueue %one to %rtc : (i1, !simulation.ref<i1>) -> ()
      simulation.suspend.delay %delay to ^check_after
    ^check_after:
      %b1 = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %q1 = simulation.ref.load %q : !simulation.ref<i1> -> i1
      %e1 = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %fmt1 = simulation.bytes.constant "after %0d %0d %0d"
      simulation.display %ctx to %stdout(%fmt1, %b1, %q1, %e1) newline = true radix = <decimal> flags = [0,0,0,0] : !simulation.bytes, i1, i1, i32
      simulation.ref.store %zero to %rtc : i1, !simulation.ref<i1>
      simulation.power.nba.enqueue %ctx, %zero to %b, %q guard %guard epochs (%epoch, %z64, %epoch, %z64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.ref.store %one64 to %epoch : i64, !simulation.ref<i64>
      simulation.suspend.delay %delay to ^check_epoch
    ^check_epoch:
      %b2 = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %q2 = simulation.ref.load %q : !simulation.ref<i1> -> i1
      %e2 = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %fmt2 = simulation.bytes.constant "epoch %0d %0d %0d"
      simulation.display %ctx to %stdout(%fmt2, %b2, %q2, %e2) newline = true radix = <decimal> flags = [0,0,0,0] : !simulation.bytes, i1, i1, i32
      simulation.power.nba.enqueue %ctx, %zero to %b, %q guard %guard epochs (%epoch, %one64, %epoch, %one64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.power.cancel_nba %ctx, %q width 1 : !simulation.ref<i1>
      simulation.suspend.delay %delay to ^check_cancel
    ^check_cancel:
      %b3 = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %q3 = simulation.ref.load %q : !simulation.ref<i1> -> i1
      %e3 = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %fmt3 = simulation.bytes.constant "cancel %0d %0d %0d"
      simulation.display %ctx to %stdout(%fmt3, %b3, %q3, %e3) newline = true radix = <decimal> flags = [0,0,0,0] : !simulation.bytes, i1, i1, i32
      simulation.power.nba.enqueue %ctx, %zero to %b, %q guard %guard epochs (%epoch, %one64, %epoch, %one64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.power.cancel_nba %ctx, %b width 1 : !simulation.ref<i1>
      simulation.power.nba.enqueue %ctx, %one to %auxb, %auxq guard %guard epochs (%epoch, %one64, %epoch, %one64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.nba.enqueue %one to %rtc : (i1, !simulation.ref<i1>) -> ()
      simulation.suspend.delay %delay to ^check_backing
    ^check_backing:
      %b4 = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %q4 = simulation.ref.load %q : !simulation.ref<i1> -> i1
      %e4 = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %r4 = simulation.ref.load %rtc : !simulation.ref<i1> -> i1
      %ab4 = simulation.ref.load %auxb : !simulation.ref<i1> -> i1
      %aq4 = simulation.ref.load %auxq : !simulation.ref<i1> -> i1
      %fmt4 = simulation.bytes.constant "cancel_backing %0d %0d %0d %0d %0d %0d"
      simulation.display %ctx to %stdout(%fmt4, %b4, %q4, %e4, %r4, %ab4, %aq4) newline = true radix = <decimal> flags = [0,0,0,0,0,0,0] : !simulation.bytes, i1, i1, i32, i1, i1, i1
      simulation.ref.store %zero to %b : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %q : i1, !simulation.ref<i1>
      %atomic = simulation.observer.bind @atomic_guard values (%b : !simulation.ref<i1>) captures 0 : !simulation.observer<i1>
      simulation.power.nba.enqueue %ctx, %one to %b, %q guard %atomic epochs (%epoch, %one64, %epoch, %one64) : (!simulation.context, i1, !simulation.ref<i1>, !simulation.ref<i1>, !simulation.observer<i1>, !simulation.ref<i64>, i64, !simulation.ref<i64>, i64) -> ()
      simulation.suspend.delay %delay to ^check_atomic
    ^check_atomic:
      %b5 = simulation.ref.load %b : !simulation.ref<i1> -> i1
      %q5 = simulation.ref.load %q : !simulation.ref<i1> -> i1
      %e5 = simulation.ref.load %edges : !simulation.ref<i32> -> i32
      %fmt5 = simulation.bytes.constant "atomic %0d %0d %0d"
      simulation.display %ctx to %stdout(%fmt5, %b5, %q5, %e5) newline = true radix = <decimal> flags = [0,0,0,0] : !simulation.bytes, i1, i1, i32
      %status = arith.constant 0 : i32
      simulation.finish %ctx, %status
      simulation.return
    }
  }
}
