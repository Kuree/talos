// RUN: %split-file %S/simulation-process-event-pending.test %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off require-bytecode=true},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: FileCheck %s --check-prefix=TIER < %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe && %t.exe | FileCheck %S/simulation-process-event-pending.test
// RUN: %llvm_dist/bin/llvm-nm --undefined-only %t.o | FileCheck %s --check-prefix=SYMBOLS --implicit-check-not=talos_rt_v1_process_event_pending
// IEEE 1801-2018 9.7.3: require interpreter execution of the internal query.
// In particular the active bytecode task has already left the calendar vector.
// TIER: runtime.execution_flags = #runtime.execution_flags<has_bytecode|require_bytecode>
// SYMBOLS: talos_rt_v1_
