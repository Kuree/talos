// RUN: %split-file %s %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(elaborate-upf,simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe && %t.exe | FileCheck %s
// IEEE 1801-2018 9.2.1/9.7.3: every initialization store updates the
// retained backing too, including stores in later root blocks after startup.
// CHECK: late root init 1
//--- design.mlir
#one = #upf.expression<[#upf.token<opcode = control, control = "top.rtc">]>
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu"} {
  upf.supply @p names ["/top/P"] writable = false {always_on = true, initial_value = 4000001 : i64}
  upf.supply @g names ["/top/G"] writable = false {always_on = true, initial_value = 1 : i64}
  upf.supply_set @primary functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, associated = [@local]}
  upf.supply_set @local functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "R", associated = [@primary]}
  upf.supply_set @ret functions {power = @p, ground = @g, nwell = @g, pwell = @g, deepnwell = @g, deeppwell = @g} required ["power", "ground"] {owner = @PD, strategy = "R"}
  upf.domain @PD elements ["top.dut"] power @p on [] {ground = @g, primary = @primary, policies = [@primary], retentions = [#upf.retention<name = "R", scope = "top", elements = [], excluded = [], retentionSupply = @ret, primarySupply = @local, domainDefault = true, condition = #one>]}
  simulation.design @probe {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.storage.decl 0 in 1 : i8 design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : i1 design hierarchy "top.clk"
    simulation.storage.decl 2 in 0 : i1 design hierarchy "top.rtc"
    simulation.code_unit.decl 2 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 1 always hierarchy "top.dut.writer"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 2 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %clk = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %zero = arith.constant 0 : i8
      %false = arith.constant false
      simulation.ref.store %zero to %q : i8, !simulation.ref<i8>
      simulation.ref.store %false to %clk : i1, !simulation.ref<i1>
      %rtc = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      %true = arith.constant true
      simulation.ref.store %true to %rtc : i1, !simulation.ref<i1>
      %p = simulation.spawn @writer(%ctx) : !simulation.context -> !simulation.process
      %delay = simulation.time.constant 1
      simulation.suspend.delay %delay to ^late
    ^late:
      %value = arith.constant 1 : i8
      simulation.ref.store %value to %q : i8, !simulation.ref<i8>
      simulation.suspend.delay %delay to ^release
    ^release:
      simulation.ref.store %false to %rtc : i1, !simulation.ref<i1>
      simulation.suspend.delay %delay to ^check
    ^check:
      %sample = simulation.ref.load %q : !simulation.ref<i8> -> i8
      %out = arith.constant 1 : i32
      %fmt = simulation.bytes.constant "late root init %0d"
      simulation.display %ctx to %out(%fmt, %sample) newline = true radix = <decimal> flags = [0,0] : !simulation.bytes, i8
      %success = arith.constant 0 : i32
      simulation.finish %ctx, %success
      simulation.return
    }
    simulation.func private @writer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 1 : i64} {
      %q_base = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %clk = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^pre {schedule.repeating_always_wait} : !simulation.ref<i1>
    ^pre:
      cf.br ^body
    ^body():
      %value = arith.constant 1 : i8
      simulation.nba.enqueue %value to %q_base : (i8, !simulation.ref<i8>) -> ()
      cf.br ^wait
    }
  }
}
