// RUN: %split-file %s %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.opt.o
// RUN: %target_cxx %t.opt.o %runtime_link_flags -o %t.opt.exe && %t.opt.exe | FileCheck %s
// IEEE 1800-2023 4.4/4.5 and IEEE 1801-2018 6.50/9.7: pending sibling
// #0 resumptions share the promoted batch. A serial second #0 follows every
// sibling. The first query occurs inside a batch, testing lazy bookkeeping.
// CHECK: inactive batch same 1, serial next 1
// CHECK: reactive batch same 1, serial next 1

//--- design.mlir
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu"} {
  simulation.design @cohort_inactive_batch {
    simulation.scope.decl 0 hierarchy "top"
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 initial hierarchy "top.first"
    simulation.code_unit.decl 3 in 0 initial hierarchy "top.sibling"
    simulation.code_unit.decl 4 in 0 initial hierarchy "top.check"
    simulation.storage.decl 0 in 0 : i64 design
    simulation.storage.decl 1 in 0 : i64 design
    simulation.storage.decl 2 in 0 : i64 design
    simulation.storage.decl 3 in 0 : i64 design
    simulation.storage.decl 4 in 0 : i64 design
    simulation.storage.decl 5 in 0 : i64 design
    simulation.code_unit.decl 5 in 0 initial hierarchy "top.reactive_first"
    simulation.code_unit.decl 6 in 0 initial hierarchy "top.reactive_sibling"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %a = simulation.spawn @first(%ctx) : !simulation.context -> !simulation.process
      %b = simulation.spawn @sibling(%ctx) : !simulation.context -> !simulation.process
      %r0 = simulation.spawn @reactive_first(%ctx) : !simulation.context -> !simulation.process
      %r1 = simulation.spawn @reactive_sibling(%ctx) : !simulation.context -> !simulation.process
      %c = simulation.spawn @check(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func @first(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 1 : i32, code_unit_id = 2 : i64} {
      %d = simulation.time.constant 1
      simulation.suspend.delay %d to ^active
    ^active:
      %z = simulation.time.constant 0
      simulation.suspend.delay %z to ^inactive
    ^inactive:
      %s = simulation.context.storage %ctx[0] : !simulation.ref<i64>
      %before = simulation.scheduler.cohort %ctx
      simulation.ref.store %before to %s : i64, !simulation.ref<i64>
      %zero = simulation.time.constant 0
      simulation.suspend.delay %zero to ^later
    ^later:
      %serial_storage = simulation.context.storage %ctx[2] : !simulation.ref<i64>
      %later = simulation.scheduler.cohort %ctx
      simulation.ref.store %later to %serial_storage : i64, !simulation.ref<i64>
      simulation.return
    }
    simulation.func @sibling(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 1 : i32, code_unit_id = 3 : i64} {
      %d = simulation.time.constant 1
      simulation.suspend.delay %d to ^active
    ^active:
      %z = simulation.time.constant 0
      simulation.suspend.delay %z to ^inactive
    ^inactive:
      %s = simulation.context.storage %ctx[1] : !simulation.ref<i64>
      %c = simulation.scheduler.cohort %ctx
      simulation.ref.store %c to %s : i64, !simulation.ref<i64>
      simulation.return
    }
    simulation.func @reactive_first(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 1 : i32, code_unit_id = 5 : i64, home_region = 10 : i32} {
      %d = simulation.time.constant 1
      simulation.suspend.delay %d to ^active
    ^active:
      %z = simulation.time.constant 0
      simulation.suspend.delay %z to ^inactive
    ^inactive:
      %s = simulation.context.storage %ctx[3] : !simulation.ref<i64>
      %before = simulation.scheduler.cohort %ctx
      simulation.ref.store %before to %s : i64, !simulation.ref<i64>
      %zero = simulation.time.constant 0
      simulation.suspend.delay %zero to ^later
    ^later:
      %serial_storage = simulation.context.storage %ctx[5] : !simulation.ref<i64>
      %later = simulation.scheduler.cohort %ctx
      simulation.ref.store %later to %serial_storage : i64, !simulation.ref<i64>
      simulation.return
    }
    simulation.func @reactive_sibling(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 1 : i32, code_unit_id = 6 : i64, home_region = 10 : i32} {
      %d = simulation.time.constant 1
      simulation.suspend.delay %d to ^active
    ^active:
      %z = simulation.time.constant 0
      simulation.suspend.delay %z to ^inactive
    ^inactive:
      %s = simulation.context.storage %ctx[4] : !simulation.ref<i64>
      %c = simulation.scheduler.cohort %ctx
      simulation.ref.store %c to %s : i64, !simulation.ref<i64>
      simulation.return
    }
    simulation.func @check(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 1 : i32, code_unit_id = 4 : i64} {
      %d = simulation.time.constant 2
      simulation.suspend.delay %d to ^show
    ^show:
      %s0 = simulation.context.storage %ctx[0] : !simulation.ref<i64>
      %s1 = simulation.context.storage %ctx[1] : !simulation.ref<i64>
      %s2 = simulation.context.storage %ctx[2] : !simulation.ref<i64>
      %c0 = simulation.ref.load %s0 : !simulation.ref<i64> -> i64
      %c1 = simulation.ref.load %s1 : !simulation.ref<i64> -> i64
      %c2 = simulation.ref.load %s2 : !simulation.ref<i64> -> i64
      %same = arith.cmpi eq, %c0, %c1 : i64
      %next = arith.cmpi ne, %c0, %c2 : i64
      %fmt = simulation.bytes.constant "inactive batch same %0d, serial next %0d (first %0d sibling %0d serial %0d)"
      %stdout = arith.constant 1 : i32
      simulation.display %ctx to %stdout(%fmt, %same, %next, %c0, %c1, %c2) newline = true radix = <decimal> flags = [0,0,0,0,0,0] : !simulation.bytes, i1, i1, i64, i64, i64
      %reactive_s0 = simulation.context.storage %ctx[3] : !simulation.ref<i64>
      %reactive_s1 = simulation.context.storage %ctx[4] : !simulation.ref<i64>
      %reactive_s2 = simulation.context.storage %ctx[5] : !simulation.ref<i64>
      %reactive_c0 = simulation.ref.load %reactive_s0 : !simulation.ref<i64> -> i64
      %reactive_c1 = simulation.ref.load %reactive_s1 : !simulation.ref<i64> -> i64
      %reactive_c2 = simulation.ref.load %reactive_s2 : !simulation.ref<i64> -> i64
      %reactive_same = arith.cmpi eq, %reactive_c0, %reactive_c1 : i64
      %reactive_next = arith.cmpi ne, %reactive_c0, %reactive_c2 : i64
      %reactive_fmt = simulation.bytes.constant "reactive batch same %0d, serial next %0d (first %0d sibling %0d serial %0d)"
      %reactive_stdout = arith.constant 1 : i32
      simulation.display %ctx to %reactive_stdout(%reactive_fmt, %reactive_same, %reactive_next, %reactive_c0, %reactive_c1, %reactive_c2) newline = true radix = <decimal> flags = [0,0,0,0,0,0] : !simulation.bytes, i1, i1, i64, i64, i64
      %z = arith.constant 0 : i32
      simulation.finish %ctx, %z
      simulation.return
    }
  }
}
