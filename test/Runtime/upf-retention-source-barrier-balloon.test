// RUN: %split-file %S/../Conversion/upf-retention-source-lifetimes.test %t
// RUN: talos-opt %t/balloon.mlir --pass-pipeline='builtin.module(prepare-upf-snapshot-publications,elaborate-upf,prepare-upf-snapshot-publications,simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe && %t.exe | FileCheck %s
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.opt.o
// RUN: %target_cxx %t.opt.o %runtime_link_flags -o %t.opt.exe && %t.opt.exe | FileCheck %s
// A source publication occurs after the actor's outer entry gate. Every
// remaining modeled publication is a retained statement group. No power-on,
// IO or unrelated helper effects continue in the powered-off source actor.
// Its retained blocking and NBA publications must both remain suppressed.
// CHECK: retained source barrier 1 1 1
