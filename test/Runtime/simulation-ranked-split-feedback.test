// RUN: talos-opt %S/../Conversion/simulation-ranked-group-routing.mlir --test-talos-simulation-to-native='max-inline-ops=300' | talos-translate --mlir-to-llvmir -o %t.ll
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.o0.ll && %target_cxx -O0 %t.o0.ll %runtime_link_flags -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.o3.ll && %target_cxx -O3 %t.o3.ll %runtime_link_flags -o %t.o3
// RUN: %t.o3 | FileCheck %s
// Check the value written by the earlier helper, as well as the final sink:
// losing a backward publication could otherwise leave the sink correct.
// CHECK: chain 4 feedback 2
// CHECK-NEXT: chain 3 feedback 1
