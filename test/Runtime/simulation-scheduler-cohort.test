// RUN: %split-file %s %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.opt.o
// RUN: %target_cxx %t.opt.o %runtime_link_flags -o %t.opt.exe && %t.opt.exe | FileCheck %s
// IEEE 1800-2023 4.4/4.5 and IEEE 1801-2018 6.50/9.7: ordering is finer
// than numeric time. Active routing and primed children keep the cohort;
// real #0, NBA, and time boundaries change it. Priming in Inactive must not
// create a second boundary. Compare identities, never implementation IDs.
// CHECK: scheduler cohorts 1 1 1 1 1 1 1 1

//--- design.mlir
module attributes {
  llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128",
  llvm.target_triple = "x86_64-unknown-linux-gnu"
} {
  simulation.design @cohorts {
    simulation.scope.decl 0 hierarchy "top"
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 initial hierarchy "top.parent"
    simulation.code_unit.decl 3 in 0 always hierarchy "top.route"
    simulation.code_unit.decl 4 in 0 always hierarchy "top.observe"
    simulation.code_unit.decl 5 in 0 fork hierarchy "top.prime"
    simulation.storage.decl 0 in 0 : i1 design hierarchy "top.input"
    simulation.storage.decl 1 in 0 : i1 design hierarchy "top.mid"
    simulation.storage.decl 2 in 0 : i1 design hierarchy "top.nba"
    simulation.storage.decl 3 in 0 : i64 design hierarchy "top.routed_cohort"
    simulation.storage.decl 4 in 0 : i1 design hierarchy "top.primed_equal"
    simulation.storage.decl 5 in 0 : i1 design hierarchy "top.never_changes"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %input = simulation.context.storage %ctx[0] : !simulation.ref<i1>
      %mid = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %nba = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      %primed = simulation.context.storage %ctx[4] : !simulation.ref<i1>
      %never = simulation.context.storage %ctx[5] : !simulation.ref<i1>
      %zero = arith.constant false
      simulation.ref.store %zero to %input : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %mid : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %nba : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %primed : i1, !simulation.ref<i1>
      simulation.ref.store %zero to %never : i1, !simulation.ref<i1>
      %r = simulation.spawn @route(%ctx) : !simulation.context -> !simulation.process
      %o = simulation.spawn @observe(%ctx) : !simulation.context -> !simulation.process
      %p = simulation.spawn @parent(%ctx) : !simulation.context -> !simulation.process
      simulation.return
    }
    simulation.func @parent(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 1 : i32, code_unit_id = 2 : i64} {
      %delay = simulation.time.constant 1
      simulation.suspend.delay %delay to ^active
    ^active:
      %input = simulation.context.storage %ctx[0] : !simulation.ref<i1>
      %nba = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      %routed = simulation.context.storage %ctx[3] : !simulation.ref<i64>
      %primed = simulation.context.storage %ctx[4] : !simulation.ref<i1>
      %before = simulation.scheduler.cohort %ctx
      %again = simulation.scheduler.cohort %ctx
      %stable = arith.cmpi eq, %before, %again : i64
      %child1 = simulation.spawn @prime(%ctx, %before) : !simulation.context, i64 -> !simulation.process
      %prime_active = simulation.ref.load %primed : !simulation.ref<i1> -> i1
      %one = arith.constant true
      simulation.ref.store %one to %input : i1, !simulation.ref<i1>
      %after_write = simulation.scheduler.cohort %ctx
      %publication_stable = arith.cmpi eq, %before, %after_write : i64
      %zero_delay = simulation.time.constant 0
      simulation.suspend.delay %zero_delay to ^inactive
    ^inactive:
      %after_zero = simulation.scheduler.cohort %ctx
      %new_inactive = arith.cmpi ne, %before, %after_zero : i64
      %route_cohort = simulation.ref.load %routed : !simulation.ref<i64> -> i64
      %same_routing = arith.cmpi eq, %before, %route_cohort : i64
      %false = arith.constant false
      simulation.ref.store %false to %primed : i1, !simulation.ref<i1>
      %child2 = simulation.spawn @prime(%ctx, %after_zero) : !simulation.context, i64 -> !simulation.process
      %prime_inactive = simulation.ref.load %primed : !simulation.ref<i1> -> i1
      simulation.nba.enqueue %one to %nba : (i1, !simulation.ref<i1>) -> ()
      simulation.suspend.change %nba to ^after_nba : !simulation.ref<i1>
    ^after_nba:
      %nba_cohort = simulation.scheduler.cohort %ctx
      %new_nba = arith.cmpi ne, %after_zero, %nba_cohort : i64
      %next = simulation.time.constant 2
      simulation.suspend.delay %next to ^done
    ^done:
      %next_cohort = simulation.scheduler.cohort %ctx
      %new_time = arith.cmpi ne, %nba_cohort, %next_cohort : i64
      %fmt = simulation.bytes.constant "scheduler cohorts %0d %0d %0d %0d %0d %0d %0d %0d"
      %stdout = arith.constant 1 : i32
      simulation.display %ctx to %stdout(%fmt, %stable, %prime_active, %publication_stable, %new_inactive, %same_routing, %prime_inactive, %new_nba, %new_time)
          newline = true radix = <decimal> flags = [0,0,0,0,0,0,0,0,0] : !simulation.bytes, i1, i1, i1, i1, i1, i1, i1, i1
      %zero = arith.constant 0 : i32
      simulation.finish %ctx, %zero
      simulation.return
    }
    simulation.func private @route(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 3 : i32, code_unit_id = 3 : i64} {
      %input = simulation.context.storage %ctx[0] : !simulation.ref<i1>
      %mid = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.change %input to ^body : !simulation.ref<i1>
    ^body:
      %value = simulation.ref.load %input : !simulation.ref<i1> -> i1
      simulation.ref.store %value to %mid : i1, !simulation.ref<i1>
      cf.br ^wait
    }
    simulation.func private @observe(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 3 : i32, code_unit_id = 4 : i64} {
      %mid = simulation.context.storage %ctx[1] : !simulation.ref<i1>
      %routed = simulation.context.storage %ctx[3] : !simulation.ref<i64>
      cf.br ^wait
    ^wait:
      simulation.suspend.change %mid to ^body : !simulation.ref<i1>
    ^body:
      %cohort = simulation.scheduler.cohort %ctx
      simulation.ref.store %cohort to %routed : i64, !simulation.ref<i64>
      cf.br ^wait
    }
    simulation.func private @prime(%ctx: !simulation.context {simulation.capture_kind = 0 : i32},
        %expected: i64 {simulation.capture_kind = 1 : i32})
        attributes {entry_kind = 13 : i32, code_unit_id = 5 : i64, internal, schedule.detached_controls, schedule.prime_on_spawn} {
      %same = simulation.context.storage %ctx[4] : !simulation.ref<i1>
      %never = simulation.context.storage %ctx[5] : !simulation.ref<i1>
      %cohort = simulation.scheduler.cohort %ctx
      %equal = arith.cmpi eq, %cohort, %expected : i64
      simulation.ref.store %equal to %same : i1, !simulation.ref<i1>
      simulation.suspend.change %never to ^done : !simulation.ref<i1>
    ^done:
      simulation.return
    }
  }
}
