// RUN: %split-file %s %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(elaborate-upf,simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe && %t.exe | FileCheck %s
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.opt.o
// RUN: %target_cxx %t.opt.o %runtime_link_flags -o %t.opt.exe && %t.opt.exe | FileCheck %s
// RUN: not talos-opt %t/conflict.mlir --elaborate-upf --verify-each 2>&1 | FileCheck %s --check-prefix=CONFLICT
// IEEE 1801-2018 9.5.2/9.5.3 preserve normal HDL assignment semantics.
// IEEE 1800-2023 7.4.5/11.5.1: every ancestor bounds a projected reference.
// Two simultaneous invocations share a root but capture different windows.
// Duplicate CFG edges and mutually forwarded loop arguments must carry the
// matching window, across selector mutation and a clock suspension. A nested
// selection outside its ancestor cannot become valid inside the root.
// CHECK: reference windows 37763 640
// CONFLICT: guarded UPF NBA reference selects different persistent roots
// CONFLICT: first root
// CONFLICT: other root

//--- design.mlir
!c = !simulation.context
!r = !simulation.ref<i16>
!b = !simulation.ref<i8>
!n = !simulation.ref<i4>
!clk = !simulation.ref<i1>
module attributes {llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128", llvm.target_triple = "x86_64-unknown-linux-gnu"} {
  upf.supply @VDD names ["/top/VDD"] writable = false {initial_value = 1 : i64, always_on = true}
  upf.domain @PD elements ["top.dut"] power @VDD on []
  upf.domain @OTHER elements ["top.other"] power @VDD on []
  simulation.design @reference_windows {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.scope.decl 2 parent 0 hierarchy "top.other" source_definition "leaf"
    simulation.code_unit.decl 2 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 1 in 1 always hierarchy "top.dut.writer"
    simulation.code_unit.decl 3 in 2 always hierarchy "top.other.writer"
    simulation.storage.decl 0 in 1 : i16 design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 0 : i1 design hierarchy "top.clk"
    simulation.storage.decl 2 in 0 : i64 design hierarchy "top.index"
    simulation.storage.decl 3 in 2 : i16 design hierarchy "top.other.q"
    simulation.func @root(%ctx: !c {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 2 : i64} {
      %q = simulation.context.storage %ctx[0] : !r
      %clk = simulation.context.storage %ctx[1] : !clk
      %index = simulation.context.storage %ctx[2] : !simulation.ref<i64>
      %initial = arith.constant 4096 : i16
      %false = arith.constant false
      %true = arith.constant true
      %zero = arith.constant 0 : i64
      %eight = arith.constant 8 : i64
      %six = arith.constant 6 : i64
      %sixteen = arith.constant 16 : i64
      %q2 = simulation.context.storage %ctx[3] : !r
      %zero16 = arith.constant 0 : i16
      simulation.ref.store %zero16 to %q2 : i16, !r
      %slice2 = simulation.ref.extract %q2 from 4 : !r -> !b
      simulation.ref.store %initial to %q : i16, !r
      simulation.ref.store %false to %clk : i1, !clk
      simulation.ref.store %zero to %index : i64, !simulation.ref<i64>
      %a_index = simulation.ref.load %index : !simulation.ref<i64> -> i64
      %a = simulation.ref.dyn_extract %q from %a_index : (!r, i64) -> !b
      simulation.ref.store %eight to %index : i64, !simulation.ref<i64>
      %b_index = simulation.ref.load %index : !simulation.ref<i64> -> i64
      %b = simulation.ref.dyn_extract %q from %b_index : (!r, i64) -> !b
      %outer = simulation.ref.extract %q from 4 : !r -> !b
      %bad = simulation.ref.dyn_extract %outer from %six : (!b, i64) -> !b
      %p0 = simulation.spawn @writer(%ctx, %clk, %a, %b, %bad, %true) : !c, !clk, !b, !b, !b, i1 -> !simulation.process
      %p1 = simulation.spawn @writer(%ctx, %clk, %a, %b, %bad, %false) : !c, !clk, !b, !b, !b, i1 -> !simulation.process
      // The next domain extends a different function after the first domain
      // has already rewritten this caller's capture operand lists.
      %p2 = simulation.spawn @other(%ctx, %clk, %slice2) : !c, !clk, !b -> !simulation.process
      // Captures already exist: these later indices cannot change them.
      simulation.ref.store %sixteen to %index : i64, !simulation.ref<i64>
      %delay = simulation.time.constant 1
      simulation.suspend.delay %delay to ^clock
    ^clock:
      simulation.ref.store %true to %clk : i1, !clk
      simulation.suspend.delay %delay to ^check
    ^check:
      %value = simulation.ref.load %q : !r -> i16
      %value2 = simulation.ref.load %q2 : !r -> i16
      %out = arith.constant 1 : i32
      %fmt = simulation.bytes.constant "reference windows %0d %0d"
      simulation.display %ctx to %out(%fmt, %value, %value2) newline = true radix = <decimal> flags = [0,0,0] : !simulation.bytes, i16, i16
      %success = arith.constant 0 : i32
      simulation.finish %ctx, %success
      simulation.return
    }
    simulation.func private @writer(%ctx: !c {simulation.capture_kind = 0 : i32}, %clk: !clk {simulation.capture_kind = 1 : i32}, %a: !b {simulation.capture_kind = 1 : i32}, %b: !b {simulation.capture_kind = 1 : i32}, %bad: !b {simulation.capture_kind = 1 : i32}, %pick: i1 {simulation.capture_kind = 1 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 1 : i64} {
      %zero = arith.constant 0 : i32
      %one = arith.constant 1 : i32
      %two = arith.constant 2 : i32
      cf.cond_br %pick, ^loop(%a, %b, %zero : !b, !b, i32), ^loop(%b, %a, %zero : !b, !b, i32)
    ^loop(%left: !b, %right: !b, %i: i32):
      %more = arith.cmpi slt, %i, %two : i32
      cf.cond_br %more, ^swap, ^wait
    ^swap:
      %next = arith.addi %i, %one : i32
      cf.br ^loop(%right, %left, %next : !b, !b, i32)
    ^wait:
      simulation.suspend.edge posedge %clk to ^write {schedule.repeating_always_wait} : !clk
    ^write:
      %six = arith.constant 6 : i64
      %minus_two = arith.constant -2 : i64
      %a4 = simulation.ref.dyn_extract %left from %six : (!b, i64) -> !n
      %b4 = simulation.ref.dyn_extract %right from %minus_two : (!b, i64) -> !n
      %bad4 = simulation.ref.extract %bad from 2 : !b -> !n
      %ten = arith.constant 10 : i4
      %thirteen = arith.constant 13 : i4
      %all = arith.constant -1 : i4
      simulation.nba.enqueue %ten to %a4 : (i4, !n) -> ()
      simulation.nba.enqueue %thirteen to %b4 : (i4, !n) -> ()
      simulation.nba.enqueue %all to %bad4 : (i4, !n) -> ()
      cf.br ^wait
    }
    simulation.func private @other(%ctx: !c {simulation.capture_kind = 0 : i32}, %clk: !clk {simulation.capture_kind = 1 : i32}, %slice: !b {simulation.capture_kind = 1 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 3 : i64} {
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^write {schedule.repeating_always_wait} : !clk
    ^write:
      %part = simulation.ref.extract %slice from 2 : !b -> !n
      %ten = arith.constant 10 : i4
      simulation.nba.enqueue %ten to %part : (i4, !n) -> ()
      cf.br ^wait
    }
  }
}

//--- conflict.mlir
module {
  upf.supply @VDD names ["/top/VDD"] writable = false {initial_value = 1 : i64, always_on = true}
  upf.domain @PD elements ["top.dut"] power @VDD on []
  simulation.design @conflict {
    simulation.scope.decl 0 hierarchy "top"
    simulation.scope.decl 1 parent 0 hierarchy "top.dut" source_definition "leaf"
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 1 always hierarchy "top.dut.writer"
    simulation.storage.decl 0 in 1 : i8 design hierarchy "top.dut.q"
    simulation.storage.decl 1 in 1 : i8 design hierarchy "top.dut.other"
    simulation.storage.decl 2 in 0 : i1 design hierarchy "top.clk"
    simulation.func @root(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}) attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %q = simulation.context.storage %ctx[0] : !simulation.ref<i8>
      %other = simulation.context.storage %ctx[1] : !simulation.ref<i8>
      %p0 = simulation.spawn @writer(%ctx, %q) : !simulation.context, !simulation.ref<i8> -> !simulation.process
      %p1 = simulation.spawn @writer(%ctx, %other) : !simulation.context, !simulation.ref<i8> -> !simulation.process
      simulation.return
    }
    simulation.func private @writer(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}, %q: !simulation.ref<i8> {simulation.capture_kind = 1 : i32}) attributes {entry_kind = 3 : i32, code_unit_id = 2 : i64} {
      %clk = simulation.context.storage %ctx[2] : !simulation.ref<i1>
      cf.br ^wait
    ^wait:
      simulation.suspend.edge posedge %clk to ^write {schedule.repeating_always_wait} : !simulation.ref<i1>
    ^write:
      %value = arith.constant 1 : i8
      simulation.nba.enqueue %value to %q : (i8, !simulation.ref<i8>) -> ()
      cf.br ^wait
    }
  }
}
