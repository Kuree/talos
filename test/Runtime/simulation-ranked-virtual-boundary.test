// RUN: talos-opt %S/../Conversion/simulation-ranked-virtual-boundary.mlir --test-talos-simulation-to-native | talos-translate --mlir-to-llvmir -o %t.ll
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' -S -o %t.o0.ll && %target_cxx -O0 %t.o0.ll %runtime_link_flags -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: opt %t.ll -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' -S -o %t.o3.ll && %target_cxx -O3 %t.o3.ll %runtime_link_flags -o %t.o3
// RUN: %t.o3 | FileCheck %s
// A runtime-only initial procedure retains its loop-carried state and report
// order while separating the native blocks before and after its publication.
// CHECK: boundary 3 count 1
// CHECK-NEXT: chain 8
// CHECK-NEXT: boundary 2 count 0
// CHECK-NEXT: chain 6
// CHECK-NOT: boundary
