// RUN: %split-file %s %t
// RUN: talos-opt %t/design.mlir --pass-pipeline='builtin.module(simulation.design(simulation.func(talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O0>' | %llc -filetype=obj -relocation-model=pic -o %t.o
// RUN: %target_cxx %t.o %runtime_link_flags -o %t.exe
// RUN: %t.exe | FileCheck %s
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llc -filetype=obj -relocation-model=pic -o %t.opt.o
// RUN: %target_cxx %t.opt.o %runtime_link_flags -o %t.opt.exe && %t.opt.exe | FileCheck %s
// IEEE 1801-2018 9.7.3: preserve all 65 data/X/Z bits, and independently
// invalidate captured domain and retention-strategy epochs before commit.
// CHECK: wide 1 1
// CHECK: domain 1 1
// CHECK: strategy 1 1

//--- design.mlir
!c = !simulation.context
!v = !simulation.logic<65>
!r = !simulation.ref<!v>
!e = !simulation.ref<i64>
!o = !simulation.observer<i1>
module attributes {
  llvm.data_layout = "e-m:e-p:64:64-i64:64-n8:16:32:64-S128",
  llvm.target_triple = "x86_64-unknown-linux-gnu"
} {
  simulation.design @wide_power_nba {
    simulation.scope.decl 0
    simulation.storage.decl 0 in 0 : !v design
    simulation.storage.decl 1 in 0 : !v design
    simulation.storage.decl 2 in 0 : i64 design
    simulation.storage.decl 3 in 0 : i64 design
    simulation.code_unit.decl 1 in 0 root_initializer hierarchy "top.root"
    simulation.code_unit.decl 2 in 0 initial hierarchy "top.drive"
    simulation.code_unit.decl 3 in 0 observer hierarchy "top.allow"
    simulation.func @root(%ctx: !c {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 0 : i32, code_unit_id = 1 : i64} {
      %d = simulation.context.storage %ctx[2] : !e
      %s = simulation.context.storage %ctx[3] : !e
      %zero = arith.constant 0 : i64
      simulation.ref.store %zero to %d : i64, !e
      simulation.ref.store %zero to %s : i64, !e
      %p = simulation.spawn @drive(%ctx) : !c -> !simulation.process
      simulation.return
    }
    simulation.func private @allow(%ctx: !c {simulation.capture_kind = 0 : i32}) -> i1
        attributes {entry_kind = 14 : i32, code_unit_id = 3 : i64,
                    schedule.observer_width = 1 : i32, schedule.observer_four_state = false} {
      %one = arith.constant true
      simulation.return %one : i1
    }
    simulation.func private @drive(%ctx: !c {simulation.capture_kind = 0 : i32})
        attributes {entry_kind = 1 : i32, code_unit_id = 2 : i64} {
      %b = simulation.context.storage %ctx[0] : !r
      %q = simulation.context.storage %ctx[1] : !r
      %d = simulation.context.storage %ctx[2] : !e
      %s = simulation.context.storage %ctx[3] : !e
      %zero = arith.constant 0 : i64
      %one = arith.constant 1 : i64
      %stdout = arith.constant 1 : i32
      %delay = simulation.time.constant 1
      %data = simulation.logic.constant 18446744073709551617 : i65, 5 : i65 : !v
      %other = simulation.logic.constant 0 : i65, 0 : i65 : !v
      %guard = simulation.observer.bind @allow values (%q : !r) captures 0 : !o
      simulation.power.nba.enqueue %ctx, %data to %b, %q guard %guard epochs (%d, %zero, %s, %zero) : (!c, !v, !r, !r, !o, !e, i64, !e, i64) -> ()
      simulation.suspend.delay %delay to ^wide
    ^wide:
      %b0 = simulation.ref.load %b : !r -> !v
      %q0 = simulation.ref.load %q : !r -> !v
      %okb0 = simulation.logic.compare case_eq %b0, %data : (!v, !v) -> i1
      %okq0 = simulation.logic.compare case_eq %q0, %data : (!v, !v) -> i1
      %fmt0 = simulation.bytes.constant "wide %0d %0d"
      simulation.display %ctx to %stdout(%fmt0, %okb0, %okq0) newline = true radix = <decimal> flags = [0,0,0] : !simulation.bytes, i1, i1
      simulation.power.nba.enqueue %ctx, %other to %b, %q guard %guard epochs (%d, %zero, %s, %zero) : (!c, !v, !r, !r, !o, !e, i64, !e, i64) -> ()
      simulation.ref.store %one to %d : i64, !e
      simulation.suspend.delay %delay to ^domain
    ^domain:
      %b1 = simulation.ref.load %b : !r -> !v
      %q1 = simulation.ref.load %q : !r -> !v
      %okb1 = simulation.logic.compare case_eq %b1, %data : (!v, !v) -> i1
      %okq1 = simulation.logic.compare case_eq %q1, %data : (!v, !v) -> i1
      %fmt1 = simulation.bytes.constant "domain %0d %0d"
      simulation.display %ctx to %stdout(%fmt1, %okb1, %okq1) newline = true radix = <decimal> flags = [0,0,0] : !simulation.bytes, i1, i1
      simulation.power.nba.enqueue %ctx, %other to %b, %q guard %guard epochs (%d, %one, %s, %zero) : (!c, !v, !r, !r, !o, !e, i64, !e, i64) -> ()
      simulation.ref.store %one to %s : i64, !e
      simulation.suspend.delay %delay to ^strategy
    ^strategy:
      %b2 = simulation.ref.load %b : !r -> !v
      %q2 = simulation.ref.load %q : !r -> !v
      %okb2 = simulation.logic.compare case_eq %b2, %data : (!v, !v) -> i1
      %okq2 = simulation.logic.compare case_eq %q2, %data : (!v, !v) -> i1
      %fmt2 = simulation.bytes.constant "strategy %0d %0d"
      simulation.display %ctx to %stdout(%fmt2, %okb2, %okq2) newline = true radix = <decimal> flags = [0,0,0] : !simulation.bytes, i1, i1
      %status = arith.constant 0 : i32
      simulation.finish %ctx, %status
      simulation.return
    }
  }
}
