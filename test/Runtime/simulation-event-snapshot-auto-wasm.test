// RUN: %split-file %S/simulation-event-snapshot.test %t
// RUN: talos-opt %t/auto.mlir '--test-talos-set-module-attributes=attrs="{llvm.data_layout = \"e-p:32:32-i64:64-i32:32-i16:16-i8:8\", llvm.target_triple = \"wasm32-unknown-emscripten\"}"' -o %t.wasm.mlir
// RUN: talos-opt %t.wasm.mlir --pass-pipeline='builtin.module(prepare-upf-snapshot-publications,simulation.design(simulation.func(canonicalize,cse,talos-sim-thread-suspension),talos-sim-build-compute-graph,talos-sim-verify-compute-graph),encode-talos-sim-to-bytecode{vpi=off},convert-talos-sim-processes-to-llvm-coroutines)' --verify-each -o %t.lowered.mlir
// RUN: talos-translate --mlir-to-llvmir %t.lowered.mlir | opt -passes='coro-early,coro-split<reuse-storage>,coro-cleanup,default<O3>' | %llvm_dist/bin/llc -mtriple=wasm32-unknown-emscripten -mattr=+atomics,+bulk-memory -filetype=obj -o %t.o
// RUN: %llvm_dist/bin/llvm-readobj --file-headers %t.o | FileCheck %s
// IEEE 1801-2018 6.50: snapshot target records retain 64-bit handles and
// 32-bit width/flag fields on wasm32. The mask remains i64, not intptr_t.
// CHECK: AddressSize: 32bit
