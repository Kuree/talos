// RUN: %split-file %S/../Conversion/simulation-eval-conditional-promotion-poison.mlir %t
// RUN: talos-opt %t/nsw.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph{vpi=off},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),convert-talos-sim-processes-to-llvm-coroutines,test-talos-export-llvm-symbols{i32-predicates=__talos_eval_kernel_conditional_ready_0_v1 globals=__talos_state_value,__talos_state_unknown,__talos_eval_step_four_state_fallback_v1 main=model_main})' | talos-translate --mlir-to-llvmir -o %t.nsw.ll
// RUN: %target_cxx -O0 %t.nsw.ll %S/Inputs/check-conditional-poison.cpp %runtime_link_flags -o %t.nsw.O0 && %t.nsw.O0
// RUN: %target_cxx -O3 %t.nsw.ll %S/Inputs/check-conditional-poison.cpp %runtime_link_flags -o %t.nsw.O3 && %t.nsw.O3
// RUN: talos-opt %t/nuw.mlir --pass-pipeline='builtin.module(simulation.design(talos-sim-build-compute-graph{vpi=off},talos-sim-verify-compute-graph,talos-sim-materialize-graph-regions,talos-sim-materialize-compute-fusion,talos-sim-specialize-static-state-nba,talos-sim-plan-static-superstep),convert-talos-sim-processes-to-llvm-coroutines,test-talos-export-llvm-symbols{i32-predicates=__talos_eval_kernel_conditional_ready_0_v1 globals=__talos_state_value,__talos_state_unknown,__talos_eval_step_four_state_fallback_v1 main=model_main})' | talos-translate --mlir-to-llvmir -o %t.nuw.ll
// RUN: %target_cxx -O0 %t.nuw.ll %S/Inputs/check-conditional-poison.cpp %runtime_link_flags -o %t.nuw.O0 && %t.nuw.O0
// RUN: %target_cxx -O3 %t.nuw.ll %S/Inputs/check-conditional-poison.cpp %runtime_link_flags -o %t.nuw.O3 && %t.nuw.O3
