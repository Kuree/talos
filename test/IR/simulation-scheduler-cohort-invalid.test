// RUN: %split-file %s %t
// RUN: talos-opt --split-input-file --verify-diagnostics %t/invalid.mlir
// Cohort identities are fixed u64 values on native and wasm32. Reject malformed
// compiler IR before either backend can misencode a host-sized query.

//--- invalid.mlir
module {
  simulation.func @wrong_result(%ctx: !simulation.context {simulation.capture_kind = 0 : i32})
      attributes {entry_kind = 8 : i32} {
    // expected-error @+1 {{result #0}}
    %bad = "simulation.scheduler.cohort"(%ctx) : (!simulation.context) -> i32
    simulation.return
  }
}
// -----
module {
  simulation.func @wrong_context(%ctx: !simulation.context {simulation.capture_kind = 0 : i32}, %bits: i64 {simulation.capture_kind = 1 : i32})
      attributes {entry_kind = 8 : i32} {
    // expected-error @+1 {{operand #0}}
    %bad = "simulation.scheduler.cohort"(%bits) : (i64) -> i64
    simulation.return
  }
}
