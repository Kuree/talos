// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// Global identity survives partitioning. Canonical supplies and identical
// storage behavior are sufficient even with different domain/strategy names.
// CHECK: collective domain partition passed

//--- design.sv
module leaf(input logic clk,d);
  logic q=0; always @(posedge clk) q<=d;
endmodule
module top;
  import UPF::*;
  logic clk=0,d=0,hold=0;
  leaf a(clk,d),b(clk,d);
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground",0.0))
      $fatal(1,"supplies");
    if (!supply_on("/top/RET.power") || !supply_on("/top/RET.ground",0.0))
      $fatal(1,"retention supplies");
    #1 d=1; clk=1;
    #1 hold=1; clk=0; d=0;
    #1 clk=1;
    #1;
    if (a.q !== 1 || b.q !== 1) $fatal(1,"collective hold");
    if (!supply_off("/top/CORE.power")) $fatal(1,"power off");
    #1;
    if (a.q !== 'x || b.q !== 'x) $fatal(1,"power masking");
    if (!supply_on("/top/CORE.power")) $fatal(1,"power on");
    #1;
    if (a.q !== 1 || b.q !== 1) $fatal(1,"collective restoration");
    $display("collective domain partition passed");
    $finish;
  end
endmodule
//--- design.upf
create_supply_set CORE
create_supply_set RET
create_power_domain A -elements a -supply {primary CORE}
create_power_domain B -elements b -supply {primary CORE}
set_retention_elements VECTOR -elements {a b}
set_retention FIRST -domain A -elements VECTOR -retention_condition hold -retention_supply RET
set_retention SECOND -domain B -elements VECTOR -retention_condition hold -retention_supply RET
