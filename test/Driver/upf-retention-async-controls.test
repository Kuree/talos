// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 9.7.3: RTC True takes priority over clocks and asynchronous
// set/reset. Table 12 still masks primary-OFF outputs and restores surviving
// backing without a clock. 9.6.7 does not invent an edge activation on NORMAL.
// Exercise always_ff NBAs and always blocking writes, mixed edge senses,
// active-low reset, active-high set, and two-/four-state retained registers.
// CHECK: asynchronous retention controls passed

//--- design.sv
module leaf #(parameter bit BLOCKING = 0)
    (input logic clk, rst_n, aset, input logic [7:0] d,
     output logic [7:0] q = 8'h13, output bit [7:0] qb = 8'h17,
     output logic [7:0] plain = 0);
  if (BLOCKING) begin
    always @(posedge clk or negedge rst_n or posedge aset) begin
      if (!rst_n) begin q = 0; qb = 0; plain = 0; end
      else if (aset) begin q = '1; qb = '1; plain = '1; end
      else begin q = d; qb = d; plain = d; end
    end
  end else begin
    always_ff @(posedge clk or negedge rst_n or posedge aset) begin
      if (!rst_n) begin q <= 0; qb <= 0; plain <= 0; end
      else if (aset) begin q <= '1; qb <= '1; plain <= '1; end
      else begin q <= d; qb <= d; plain <= d; end
    end
  end
endmodule
module top;
  import UPF::*;
  logic clk = 0, rst_n = 1, aset = 0, enable = 1, rtc = 0;
  logic [7:0] d = 8'h31;
  wire [7:0] q, qb, plain, bq, bqb, bplain;
  leaf dut(clk, rst_n, aset, d, q, qb, plain);
  leaf #(1) blocking_dut(clk, rst_n, aset, d, bq, bqb, bplain);
  task check(logic [7:0] retained, logic [7:0] ordinary);
    if (q !== retained || qb !== retained || bq !== retained || bqb !== retained ||
        plain !== ordinary || bplain !== ordinary)
      $fatal(1, "retained %h %h %h %h ordinary %h %h expected %h %h",
             q, qb, bq, bqb, plain, bplain, retained, ordinary);
  endtask
  initial begin
    if (!supply_on("/top/AON.power") || !supply_on("/top/AON.ground", 0.0))
      $fatal(1, "initial supplies");
    #1 clk = 1;
    #1 check(8'h31, 8'h31);
    clk = 0;
    rst_n = 0;
    #1 check(0, 0); // Reset without a clock.
    rst_n = 1;
    aset = 1;
    #1 check('1, '1); // Set without a clock.
    aset = 0;
    d = 8'h42;
    #1 clk = 1;
    #1 check(8'h42, 8'h42);
    clk = 0;
    rtc = 1;
    #1 rst_n = 0;
    #1 check(8'h42, 0);
    rst_n = 1;
    aset = 1;
    #1 check(8'h42, '1);
    aset = 0;
    rst_n = 0;
    #1 check(8'h42, 0);
    rtc = 0;
    #1 check(8'h42, 0); // RTC release alone is not a new reset edge.
    rst_n = 1;
    #1 rst_n = 0;
    #1 check(0, 0);
    rst_n = 1;
    d = 8'h65;
    #1 clk = 1;
    #1 check(8'h65, 8'h65);
    rtc = 1;
    enable = 0;
    #1;
    if (q !== 'x || bq !== 'x || qb !== 0 || bqb !== 0)
      $fatal(1, "primary OFF mask");
    rst_n = 0;
    aset = 1;
    #1;
    aset = 0;
    enable = 1;
    #1;
    if (q !== 8'h65 || qb !== 8'h65 || bq !== 8'h65 || bqb !== 8'h65)
      $fatal(1, "reset during OFF changed backing");
    rtc = 0;
    #1;
    if (q !== 8'h65 || qb !== 8'h65 || bq !== 8'h65 || bqb !== 8'h65)
      $fatal(1, "held reset invented restoration/release activation");
    clk = 0;
    rst_n = 1;
    #1;
    rst_n = 0;
    clk = 1;
    #1 check(0, 0); // Simultaneous reset and clock obey the HDL branch priority.
    $display("asynchronous retention controls passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_net VDD
create_supply_set AON -function {power VDD}
create_supply_set SW -function {ground AON.ground}
create_power_domain PD -elements {dut blocking_dut} -supply {primary SW}
create_power_switch PS -domain PD \
    -input_supply_port {vin AON.power} -output_supply_port {vout PD.primary.power} \
    -control_port {en enable} -on_state {ON vin en}
set_retention KEEP -domain PD -elements {dut/q dut/qb blocking_dut/q blocking_dut/qb} \
    -retention_condition rtc
