// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: not talos --upf %t/design.upf -O0 -emit-sim --mlir-verify-each %t/design.sv -o %t.bad.mlir 2>&1 | FileCheck %s
// Fail closed until a shared helper's initialization read context can be
// specialized without changing its other, externally powered callers.
// CHECK: balloon retention initialization readback through helpers is not implemented

//--- design.sv
module leaf(input logic clk, output logic [7:0] q);
  always @(posedge clk) q <= 8'h55;
endmodule
module top;
  logic clk = 0, restore = 0;
  wire [7:0] q;
  leaf dut(clk,q);
  function automatic logic [7:0] read_q();
    return dut.q;
  endfunction
  function automatic logic [7:0] indirect_read();
    return read_q();
  endfunction
  initial begin
    dut.q = 8'h13;
    if (dut.q !== indirect_read()) $fatal(1, "inconsistent initialization reads");
  end
endmodule

//--- design.upf
create_supply_set CORE
create_power_domain PD -elements dut -supply {primary CORE}
set_retention KEEP -domain PD -elements dut/q -restore_signal {restore high}
