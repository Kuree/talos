// REQUIRES: upf
// RUN: %split-file %S/upf-supply-query-initializers.test %t
// RUN: talos --upf %t/design.upf --target=wasm32 -O3 --mlir-verify-each -c %t/design.sv -o %t/standard.o
// RUN: talos --upf-assume-powered-inputs --upf %t/design.upf -DASSUME --target=wasm32 -O3 --mlir-verify-each -c %t/design.sv -o %t/assumed.o
// RUN: %llvm_dist/bin/llvm-readobj --file-headers %t/standard.o %t/assumed.o | FileCheck %s
// IEEE 1801-2018 9.2.1/11.2.3.2.6: initialization order does not depend on
// target pointer width, including the configured compatibility initial values.
// CHECK-COUNT-2: AddressSize: 32bit
