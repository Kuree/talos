// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.exe && %t.exe | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc && %t.bc | FileCheck %s
// IEEE 1801-2018 9.2.1/9.7.2(d)(2): an exempt normal initialization
// cannot bypass output corruption from default RET_SUP_COR while RET is OFF.
// CHECK: retention-off initialization passed

//--- design.sv
module leaf(input logic clk, output logic [7:0] q);
  always @(posedge clk) q <= 8'h55;
endmodule
module top;
  import UPF::*;
  logic clk = 0, restore = 0;
  wire [7:0] q;
  leaf dut(clk,q);
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground", 0.0) ||
        !supply_on("/top/RET.ground", 0.0)) $fatal(1, "supplies");
    dut.q = 8'h13;
    if (dut.q !== 8'h13) $fatal(1, "initial normal readback");
  end
  initial begin
    #1;
    if (q !== 'x) $fatal(1, "initial write bypassed RET output corruption");
    if (!supply_on("/top/RET.power")) $fatal(1, "retention on");
    #1;
    if (q !== 8'h13) $fatal(1, "exempt normal initialization lost");
    restore = 1; #1 restore = 0; #1;
    if (q !== 'x) $fatal(1, "exempt initialization manufactured save");
    $display("retention-off initialization passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_set CORE
create_supply_set RET
create_power_domain PD -elements dut -supply {primary CORE}
set_retention KEEP -domain PD -elements dut/q -retention_supply RET -restore_signal {restore high}
