// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --vpi=off --upf %t/design.upf --saif=%t.saif --mlir-verify-each -O3 %t/design.sv -o %t.o3 && %t.o3 && FileCheck %s --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif | talos-opt | FileCheck %s --check-prefix=IR
// IEEE 1801-2018 9.5/9.6.7 and I.3.5.1: power loss publishes X and
// supply restoration does not invent a sequential update or a known toggle.
// CHECK: (TIMESCALE 1 fs) (DURATION 12000000)
// CHECK: (INSTANCE dut
// CHECK: (q (T0 4000000) (T1 3000000) (TX 5000000) (TZ 0) (TC 1))
// IR: saif.file

//--- design.sv
module leaf;
  timeunit 1ns; timeprecision 1ns;
  logic q = 0;
endmodule
module top;
  timeunit 1ns; timeprecision 1ns;
  import UPF::*;
  leaf dut();
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground", 0.0))
      $fatal(1, "supplies");
    #0 dut.q = 0;
    #2 dut.q = 1;
    #3;
    if (!supply_off("/top/CORE.power")) $fatal(1, "OFF");
    if (dut.q !== 'x) $fatal(1, "corruption");
    #4;
    if (!supply_on("/top/CORE.power")) $fatal(1, "ON");
    #1;
    if (dut.q !== 'x) $fatal(1, "power-up invented a clock");
    dut.q = 0;
    #2 $finish;
  end
endmodule
//--- design.upf
create_supply_set CORE
create_power_domain PD -elements dut -supply {primary CORE}
