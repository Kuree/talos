// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 9.5.3/9.7.3: async reset NBAs capture RHS and epochs at
// the original statement. RTC/primary/retention-power loss cancels pending
// writes before a false known edge, even after recovery. A fresh reset event
// can repopulate corrupt state without a clock. Include ascending 65-bit
// two-/four-state registers and an ordinary delayed sibling.
// CHECK: delayed asynchronous retention passed

//--- design.sv
module leaf(input logic clk, rst_n, input logic [0:64] d, reset_value,
            output logic [0:64] q = 0, output bit [0:64] qb = 0,
            output logic [0:64] plain = 0);
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin
      plain <= #2 reset_value;
      q <= #2 reset_value;
      qb <= #2 reset_value;
    end else begin
      plain <= #2 d;
      q <= #2 d;
      qb <= #2 d;
    end
  end
endmodule
module top;
  import UPF::*;
  logic clk = 0, rst_n = 1, enable = 1, rtc = 0;
  logic [0:64] d = 0, reset_value = 65'h10000000000000001;
  wire [0:64] q, qb, plain;
  int hits = 0;
  leaf dut(clk, rst_n, d, reset_value, q, qb, plain);
  always @(posedge dut.q[64]) if (dut.q[64] === 1) hits++;
  initial begin
    if (!supply_on("/top/AON.power") || !supply_on("/top/AON.ground", 0.0) ||
        !supply_on("/top/RET.power")) $fatal(1, "initial supplies");
    #1 clk = 1;
    #3;
    if (q !== 0 || qb !== 0 || plain !== 0) $fatal(1, "initial capture");
    clk = 0;
    rst_n = 0;
    #0;
    reset_value = 65'h10000000000000033;
    rtc = 1;
    #0 rtc = 0;
    #3;
    if (q !== 0 || qb !== 0 || plain !== 65'h10000000000000001 || hits !== 0)
      $fatal(1, "RTC revived reset or RHS was reloaded");
    rst_n = 1;
    #1 rst_n = 0;
    #3;
    if (q !== 65'h10000000000000033 || qb !== q || plain !== q || hits !== 1)
      $fatal(1, "fresh reset after RTC");
    rst_n = 1;
    #1 clk = 1;
    #0 enable = 0;
    #1 enable = 1;
    #3;
    if (q !== 'x || qb !== 0 || plain !== 'x || hits !== 1)
      $fatal(1, "primary loss revived old clock NBA");
    reset_value = 65'h10000000000000045;
    rst_n = 0;
    #3;
    if (q !== 65'h10000000000000045 || qb !== q || plain !== q || hits !== 2)
      $fatal(1, "reset did not recover corrupt state");
    rst_n = 1;
    reset_value = 65'h10000000000000077;
    #1 rst_n = 0;
    #0;
    if (!supply_off("/top/RET.power")) $fatal(1, "retention OFF");
    #0;
    if (!supply_on("/top/RET.power")) $fatal(1, "retention ON");
    #3;
    if (q !== 'x || qb !== 0 || plain !== 65'h10000000000000077 || hits !== 2)
      $fatal(1, "retention loss revived old reset NBA");
    rst_n = 1;
    reset_value = 65'h10000000000000089;
    #1 rst_n = 0;
    #3;
    if (q !== 65'h10000000000000089 || qb !== q || plain !== q || hits !== 3)
      $fatal(1, "fresh reset after retention loss");
    $display("delayed asynchronous retention passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_net VDD
create_supply_set AON -function {power VDD}
create_supply_set SW -function {ground AON.ground}
create_supply_net VRET
create_supply_set RET -function {power VRET} -function {ground AON.ground}
create_power_domain PD -elements dut -supply {primary SW}
create_power_switch PS -domain PD \
    -input_supply_port {vin AON.power} -output_supply_port {vout PD.primary.power} \
    -control_port {en enable} -on_state {ON vin en}
set_retention KEEP -domain PD -elements {dut/q dut/qb} -retention_supply RET \
    -retention_condition rtc
