// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/save.upf -O3 --vpi=off --coverage=functional -emit-sim --dump-ir-after=prepare-upf-snapshot-publications --dump-ir-path=%t.prepared.mlir %t/design.sv -o %t.mlir
// RUN: FileCheck %s < %t.prepared.mlir
// RUN: not talos --upf %t/save.upf -O3 --vpi=off --coverage=functional -emit-sim %t/design.sv -o %t.mlir 2>&1 | FileCheck %s --check-prefix=ERROR
// IEEE 1801-2018 6.50: preparation must run before the first canonicalizer,
// CSE or mem2reg in the real driver pipeline, preserving an untimed save pulse.
// Balloon strategy elaboration remains a diagnosed, separate milestone.
// CHECK: simulation.snapshot_publications
// CHECK: simulation.func @{{.*}}
// CHECK: simulation.covergroup.clock_event.register
// CHECK: simulation.ref.store {{.*}} : !simulation.covergroup_handle
// CHECK-NEXT: simulation.event.snapshot.flush
// CHECK-NEXT: %[[A:[a-zA-Z0-9_]+]] = arith.constant 17 : i32
// CHECK-NEXT: simulation.ref.store %[[A]] to %[[DATA:[a-zA-Z0-9_]+]] : i32,
// CHECK-NEXT: simulation.event.snapshot.flush
// CHECK: simulation.ref.store {{.*}} : i1,
// CHECK-NEXT: simulation.event.snapshot.flush
// CHECK-NEXT: %[[B:[a-zA-Z0-9_]+]] = arith.constant 34 : i32
// CHECK-NEXT: simulation.ref.store %[[B]] to %[[DATA]] : i32,
// CHECK-NEXT: simulation.event.snapshot.flush
// ERROR: retention simulation lowering is not implemented for balloon-style strategies

//--- save.upf
create_supply_set CORE
create_power_domain PD -elements dut -supply {primary CORE}
set_retention KEEP -domain PD -save_signal {save high}
//--- design.sv
module leaf(input bit clk, input int d, output int q = 0);
  always @(posedge clk) q <= d;
endmodule
module top;
  bit clk = 0, save = 0;
  int d = 0;
  wire [31:0] q;
  leaf dut(clk, d, q);
  covergroup clocked @(posedge clk);
    point: coverpoint d { bins values[] = {17,34}; }
  endgroup
  clocked coverage;
  initial begin
    coverage = new;
    d = 17;
    save = 1;
    d = 34;
    #1 clk = 1;
    #1 $display("%d %b", q, save);
  end
endmodule
