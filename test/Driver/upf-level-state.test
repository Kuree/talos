// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf-assume-powered-inputs --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf-assume-powered-inputs --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf-assume-powered-inputs --upf %t/design.upf -O0 --execution-tier=bytecode %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 9.6.7: reevaluate constant and level-sensitive logic on
// restoration; a closed latch cannot recover its lost state.
// CHECK: latches and constant logic passed

//--- design.sv
module leaf(input logic d, en, en_b, output logic [3:0] q);
  always_latch if (en) q[0] = d;
  always_latch if (en_b) q[1] = d;
  always_comb q[2] = 1'b1;
  assign q[3] = 1'b0;
endmodule
module top;
  logic d = 1, en = 1, en_b = 1, power_en = 1;
  wire [3:0] q;
  leaf dut(d, en, en_b, q);
  initial begin
    #1;
    if (q !== 4'b0111) $fatal(1, "initial latch/constant evaluation failed");
    en_b = 0; power_en = 0;
    #1 d = 0;
    #1;
    if (q !== 'x) $fatal(1, "OFF latch/constant state was not corrupted");
    power_en = 1;
    #1;
    if (q !== 4'b01x0) $fatal(1, "open or closed latch restored incorrectly");
    en_b = 1;
    #1;
    if (q !== 4'b0100) $fatal(1, "new enable failed to update restored latch");
    en = 0; en_b = 0; power_en = 0;
    #1 d = 1;
    #1 power_en = 1;
    #1;
    if (q !== 4'b01xx) $fatal(1, "closed latches resurrected pre-loss state");
    $display("latches and constant logic passed");
    $finish;
  end
endmodule

//--- design.upf
create_power_domain PD -elements dut
foreach net {VDD VDD_SW} {create_supply_net $net}
create_power_switch SW -domain PD \
    -input_supply_port {vin VDD} -output_supply_port {vout VDD_SW} \
    -control_port {en power_en} -on_state {ON vin en}
