// REQUIRES: upf
// RUN: %split-file %S/upf-legacy-supply-policy.test %t
// RUN: talos --upf %t/modern.upf --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %S/upf-legacy-supply-policy.test
// RUN: talos --upf %t/modern.upf --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %S/upf-legacy-supply-policy.test
// RUN: talos --upf %t/modern.upf --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %S/upf-legacy-supply-policy.test
// IEEE 1801-2018 6.43's modern reference for supplying-set policy behavior.
