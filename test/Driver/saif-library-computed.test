// RUN: %split-file %s %t
// RUN: talos --vpi=off --saif=%t.saif --saif-input=%t/library.saif -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 && FileCheck %s --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif -o /dev/null
// Computed change and edge waits retain the original A transition, even
// when another pin changes before the procedural output delay completes.
// CHECK-COUNT-3: (Y (T0 8000000) (T1 2000000) (TX 0) (TZ 0) (TC 1)(COND (!B) (RISE) (IOPATH A (TC 1)
//--- design.sv
module computed_gate(input logic A, B, C, output logic Y = 0);
  timeunit 1ns; timeprecision 1ns;
  always @(A ^ C) begin #3 Y = A; end
endmodule
module edge_gate(input logic A, B, C, output logic Y = 0);
  timeunit 1ns; timeprecision 1ns;
  always @(posedge (A ^ C)) begin #3 Y = A; end
endmodule
module iff_gate(input logic A, B, C, output logic Y = 0);
  timeunit 1ns; timeprecision 1ns;
  always @(posedge A iff !B) begin #3 Y = A; end
endmodule
module top;
  timeunit 1ns; timeprecision 1ns;
  logic A = 0, B = 0, C = 0;
  wire Y1, Y2, Y3;
  computed_gate u1(A, B, C, Y1);
  edge_gate u2(A, B, C, Y2);
  iff_gate u3(A, B, C, Y3);
  initial begin #5 A = 1; #1 B = 1; #3 C = 1; #1 $finish; end
endmodule
//--- library.saif
(SAIFILE (SAIFVERSION "2.0" "lib") (DIRECTION "forward")
  (DESIGN) (DATE) (VENDOR) (PROGRAM_NAME) (PROGRAM_VERSION) (DIVIDER /)
  (LIBRARY "L"
    (MODULE computed_gate (PORT Y (COND !B RISE_FALL (IOPATH A IOPATH_DEFAULT)
      COND_DEFAULT RISE_FALL (IOPATH A IOPATH_DEFAULT))))
    (MODULE edge_gate (PORT Y (COND !B RISE_FALL (IOPATH A IOPATH_DEFAULT)
      COND_DEFAULT RISE_FALL (IOPATH A IOPATH_DEFAULT))))
    (MODULE iff_gate (PORT Y (COND !B RISE_FALL (IOPATH A IOPATH_DEFAULT)
      COND_DEFAULT RISE_FALL (IOPATH A IOPATH_DEFAULT))))))
