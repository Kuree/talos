// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: not talos --upf %t/excluded.upf -O0 --mlir-verify-each %t/design.sv -o %t.excluded 2>&1 | FileCheck %s
// RUN: not talos --upf %t/overridden.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.overridden 2>&1 | FileCheck %s
// RUN: not talos --upf %t/none.upf -O3 --mlir-verify-each %t/design.sv -o %t.none 2>&1 | FileCheck %s
// RUN: not talos --upf %t/exclude-process.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.exclude-process 2>&1 | FileCheck %s
// Staged boundary: retained external writes have per-target power handling;
// excluded/overridden writes still require ordinary domain issue/epoch guards.
// Never accept that mixture and let r update during CORRUPT (1801 9.5.3), or
// gate P's AON neighbors. Diagnose from final membership, before rewriting.
// CHECK: retention process selection with external writes to unretained domain state is not implemented: top.dut.{{[qr]}} from top.P

//--- design.sv
module leaf; logic [7:0] q, r; endmodule
module top;
  logic clk, hold;
  logic [7:0] d, outside;
  leaf dut();
  always @(posedge clk) begin : P
    dut.q <= d;
    dut.r <= d + 1;
    outside <= d;
  end
  initial begin #10; $display("%h %h %h",dut.q,dut.r,outside); $finish; end
endmodule
//--- common.upf
create_power_domain PD -elements dut
//--- excluded.upf
source [file join [file dirname [info script]] common.upf]
set_retention R -domain PD -elements P -exclude_elements dut/r -retention_condition hold
//--- overridden.upf
source [file join [file dirname [info script]] common.upf]
set_retention R -domain PD -elements P -retention_condition hold
set_retention N -domain PD -elements dut/r -no_retention
//--- none.upf
source [file join [file dirname [info script]] common.upf]
set_retention N -domain PD -elements P -no_retention
//--- exclude-process.upf
source [file join [file dirname [info script]] common.upf]
set_retention R -domain PD -elements dut -exclude_elements P -retention_condition hold
