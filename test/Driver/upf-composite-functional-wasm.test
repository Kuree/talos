// REQUIRES: upf
// RUN: %split-file %S/upf-composite-functional.test %t
// RUN: talos --upf %t/sets.upf --target=wasm32 -O3 --execution-tier=native --mlir-verify-each -c %t/design.sv -o %t.native
// RUN: talos --upf %t/nets.upf --target=wasm32 -O3 --execution-tier=bytecode --mlir-verify-each -c %t/design.sv -o %t.bc
// RUN: %llvm_dist/bin/llvm-readobj --file-headers %t.native %t.bc | FileCheck %s
// Compile-only target coverage; supplied I rails remain distinct in both tiers.
// CHECK-COUNT-2: AddressSize: 32bit
