# IEEE 1801-2018 6.33/8.3.1(a): '/' and '..' use the load's design-top instance.
assert_equal [set_scope /] /
expect_error {set_scope ..} {*cannot leave the design top*}
assert_equal [lsort [find_objects . -pattern * -object_type port]] {d q}
incr scoped_loads
set_design_top leaf_written_for_a_different_module_name
set child_result should_not_be_returned
