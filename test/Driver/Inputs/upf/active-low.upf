# IEEE 1801-2018 6.22/6.45: negated switch control, low isolation sense and
# clamp-one exercise the supported truth-table alternatives.
create_power_domain PD -elements dut
foreach net {VDD VSS VDD_SW} {create_supply_net $net}
create_power_switch SW -domain PD \
    -input_supply_port {vin VDD} -output_supply_port {vout VDD_SW} \
    -control_port {en power_en} -on_state {ON vin {!en}} -off_state {OFF en}
set_isolation ISO -domain PD -isolation_signal iso -isolation_sense low \
    -clamp_value 1 -applies_to outputs -location parent
