// RUN: %split-file %s %t
// RUN: talos -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// RUN: talos -O0 -emit-sim --mlir-verify-each %t/design.sv -o - | FileCheck %s --check-prefix=SIM --implicit-check-not=schedule.repeating_always_wait --implicit-check-not=__upf --implicit-check-not=simulation.power
// IEEE 1800-2023 9.2.2.4: ordinary always_ff repeats its outer event control.
// Keep the same single/OR-list waits and initialization behavior without UPF.
// The repeating marker is a proof for UPF gating and changes a wait's self-wake
// flag, so only designs with power intent carry it on always_ff (upf-* tests).
// CHECK: always_ff repeating controls passed
// SIM-DAG: simulation.suspend.edge posedge
// SIM-DAG: simulation.suspend.any {{.*}}edges [1, 2]

//--- design.sv
module top;
  logic clk = 0, rst_n = 1;
  logic [7:0] d = 8'h22, single = 8'h13, async_q = 8'h17;
  always_ff @(posedge clk) single <= d;
  always_ff @(posedge clk or negedge rst_n)
    if (!rst_n) async_q <= 0;
    else async_q <= d;
  initial begin
    #1 rst_n = 0;
    #1;
    if (single !== 8'h13 || async_q !== 0) $fatal(1, "reset without clock");
    rst_n = 1;
    #1 clk = 1;
    #1;
    if (single !== 8'h22 || async_q !== 8'h22) $fatal(1, "first clock");
    clk = 0;
    d = 8'h33;
    #1 clk = 1;
    #1;
    if (single !== 8'h33 || async_q !== 8'h33) $fatal(1, "repeated clock");
    rst_n = 0;
    #1;
    if (single !== 8'h33 || async_q !== 0) $fatal(1, "repeated reset");
    $display("always_ff repeating controls passed");
    $finish;
  end
endmodule
