// REQUIRES: upf
// RUN: %split-file %S/upf-domain-published-loss.test %t
// RUN: talos --upf %t/design.upf -DRAW_INITIAL -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %S/upf-domain-published-loss.test
// RUN: talos --upf %t/design.upf -DRAW_INITIAL -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 | FileCheck %S/upf-domain-published-loss.test
// RUN: talos --upf %t/design.upf -DRAW_INITIAL -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0 && %t.bc0 | FileCheck %S/upf-domain-published-loss.test
// RUN: talos --upf %t/design.upf -DRAW_INITIAL -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %S/upf-domain-published-loss.test
