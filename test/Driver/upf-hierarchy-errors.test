# REQUIRES: upf
# RUN: %split-file %s %t
# RUN: not talos --upf %t/switch.upf --upf %t/always-on-child.upf %t/design.sv -o %t/child 2>&1 | FileCheck %s --check-prefix=CHILD
# RUN: not talos --upf %t/multiple.upf --upf %t/switch.upf %t/design.sv -o %t/multiple 2>&1 | FileCheck %s --check-prefix=PATHS
# RUN: not talos --upf %t/switch.upf %t/collapsed.sv -o %t/collapsed 2>&1 | FileCheck %s --check-prefix=NET
# RUN: talos --upf %t/always-on-parent.upf --upf %t/switch.upf -emit-sim --mlir-verify-each %t/design.sv -o - | FileCheck %s --check-prefix=PARENT
# RUN: talos --upf %t/multiple.upf --upf %t/no-isolation.upf --upf %t/switch.upf -emit-sim --mlir-verify-each %t/design.sv -o - | FileCheck %s --check-prefix=PARENT
# IEEE 1801-2018 6.20: effective extent excludes explicitly assigned children.
# IEEE 1801-2018 6.45: same-domain traffic and mixed fanout require per-path isolation.
# CHILD: always-on subdomains inside switchable domains are not implemented
# PATHS: isolation across multiple boundary instances requires per-path handling and is not implemented
# NET: isolation on collapsed output nets is not implemented
# PARENT: __upf_top.PD.monitor

#--- design.sv
module child(input logic d, output logic q);
  always_comb q = d;
endmodule
module wrapper(input logic d, output logic q);
  wire internal_wire;
  child u(d, internal_wire), u2(internal_wire, q);
endmodule
module top;
  logic d, power_en, iso;
  wire q;
  wrapper dut(d, q);
endmodule

#--- collapsed.sv
module leaf(input logic d, output wire q);
  assign q = d;
endmodule
module top;
  logic d, power_en, iso;
  wire q;
  leaf dut(d, q);
endmodule

#--- switch.upf
if {![info exists elements]} {set elements dut}
create_power_domain PD -elements $elements
foreach net {VDD VSS VDD_SW} {create_supply_net $net}
create_power_switch SW -domain PD \
    -input_supply_port {vin VDD} -output_supply_port {vout VDD_SW} \
    -control_port {en power_en} -on_state {ON vin en}
if {![info exists omit_isolation]} {
    set_isolation ISO -domain PD -isolation_signal iso -clamp_value 0 \
        -applies_to outputs -location parent
}

#--- always-on-child.upf
create_power_domain Child -elements dut/u

#--- always-on-parent.upf
create_power_domain Parent -elements .

#--- multiple.upf
set elements {dut/u dut/u2}

#--- no-isolation.upf
set omit_isolation 1
