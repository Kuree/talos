// RUN: %split-file %s %t
// RUN: talos --vpi=off --saif=%t.saif --saif-input=%t/map.saif --mlir-verify-each -O3 %t/design.sv -o %t.exe && %t.exe && FileCheck %s --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif | talos-opt | FileCheck %s --check-prefix=IR
// CHECK: (INSTANCE top
// CHECK: (NET
// CHECK-DAG: (mapped[7] (T0 2000000) (T1 3000000) (TX 0) (TZ 0) (TC 1))
// CHECK-DAG: (out\.dot (T0 2000000) (T1 3000000) (TX 0) (TZ 0) (TC 1))
// CHECK-DAG: (mapped_scalar (T0 2000000) (T1 3000000) (TX 0) (TZ 0) (TC 1))
// CHECK: (VIRTUAL_INSTANCE "seq\foo" gate
// CHECK: (PORT
// CHECK: (Q (T0 2000000) (T1 3000000) (TX 0) (TZ 0) (TC 1))
// IR: cell = "seq\\foo", is_virtual = true

//--- design.sv
module top;
  timeunit 1ns; timeprecision 1ns;
  logic q = 0;
  logic [3:1] descending = 0;
  bit \literal.dot = 0;
  initial begin
    #2 q = 1; descending = 1; \literal.dot = 1;
    #3 $finish;
  end
endmodule
//--- map.saif
(SAIFILE
  (SAIFVERSION "2.0") (DIRECTION "forward")
  (DESIGN) (DATE) (VENDOR) (PROGRAM_NAME) (PROGRAM_VERSION) (DIVIDER .)
  (INSTANCE top
    (PORT (q gate.Q "seq\foo"))
    (NET (descending[1] mapped[7]) (descending[1] mapped_scalar) (literal\.dot out\.dot))))
