// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0 && %t.bc0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// IEEE 1801-2018 9.2.3/9.5.3/9.6.2: freeze actual primary eligibility
// and the domain epoch at the first qualified clock publication. Suppress
// invalid activations before blocking writes, helper/RHS effects, or NBA issue.
// CHECK-NOT: forbidden pending body
// CHECK: domain pending clock passed
// CHECK-NOT: forbidden pending body

//--- design.sv
module leaf;
  logic [7:0] q = 0, blocking_value = 0;
  always @(posedge top.clk) begin
    top.effects += 1;
    blocking_value = top.d;
    q <= top.rhs();
    if (top.forbid) $display("forbidden pending body");
  end
endmodule
module internal_leaf;
  logic clk, q;
  always @(posedge clk) q <= 1;
endmodule
module top;
  import UPF::*;
  logic clk = 0, forbid = 0;
  logic [7:0] d = 8'h11;
  int effects = 0, calls = 0;
  leaf dut();
  internal_leaf internal_dut();
  function logic [7:0] rhs();
    calls += 1;
    return d;
  endfunction
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground",0.0)) $fatal(1,"supplies");
    internal_dut.clk = 0;
    #1;
    forbid = 1;
    clk = 1; internal_dut.clk = 1;
    if (!supply_off("/top/CORE.power") || !supply_on("/top/CORE.power")) $fatal(1,"pulse");
    clk = 0; clk = 1; // Cannot relabel the first still-pending occurrence.
    #0;
    if (dut.q !== 'x || dut.blocking_value !== 'x || internal_dut.q !== 'x || effects != 0 || calls != 0)
      $fatal(1,"pre-loss body revived");
    forbid = 0; d = 8'h22;
    clk = 0;
    #0 clk = 1; // Fresh rearmed edge in the same simulation time is valid.
    #1;
    if (dut.q !== d || dut.blocking_value !== d || effects != 1 || calls != 1) $fatal(1,"rearmed clock");
    clk = 0; #1;
    if (!supply_off("/top/CORE.power") || !supply_on("/top/CORE.power")) $fatal(1,"clockless pulse");
    d = 8'h33; clk = 1;
    #1;
    if (dut.q !== d || effects != 2 || calls != 2) $fatal(1,"clockless pulse consumed arm");
    clk = 0; #1;
    forbid = 1;
    if (!supply_off("/top/CORE.power")) $fatal(1,"OFF");
    clk = 1; // A powered-off edge consumes the arm with eligibility false.
    if (!supply_on("/top/CORE.power")) $fatal(1,"ON");
    clk = 0; clk = 1;
    #1;
    if (dut.q !== 'x || dut.blocking_value !== 'x || effects != 2 || calls != 2) $fatal(1,"off-edge relabelled");
    forbid = 0; d = 8'h44;
    clk = 0; #0 clk = 1; #1;
    if (dut.q !== d || effects != 3 || calls != 3) $fatal(1,"fresh post-loss clock");
    $display("domain pending clock passed"); $finish;
  end
endmodule

//--- design.upf
create_supply_set CORE
create_power_domain PD -elements {dut internal_dut} -supply {primary CORE}
