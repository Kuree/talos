// REQUIRES: wasm-execution
// RUN: %split-file %S/saif-aggregates.test %t
// RUN: talos --vpi=off --target=wasm32 --saif=%t.saif -O3 -c %t/design.sv -o %t.o
// RUN: %wasm_cxx %t.o %wasm_runtime -sNODERAWFS=1 -sALLOW_MEMORY_GROWTH=1 -sEXIT_RUNTIME=1 -sENVIRONMENT=node -o %t.js && %node %t.js && FileCheck %S/saif-aggregates.test --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif -o /dev/null
// Aggregate observations keep canonical indices and per-bit initial state on
// wasm32; inputs and checks are shared with saif-aggregates.test.
