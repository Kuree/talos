# REQUIRES: upf
# RUN: talos --upf %S/Inputs/upf/switchable.upf --target=wasm32 -O0 -emit-llvm %S/upf-switchable-domain.sv -o %t.ll
# RUN: FileCheck %s --check-prefix=WASM < %t.ll
# RUN: talos --upf %S/Inputs/upf/switchable.upf --target=wasm32 -O3 -c %S/upf-switchable-domain.sv -o %t.o
# RUN: %llvm_dist/bin/llvm-readobj --file-headers %t.o | FileCheck %s --check-prefix=OBJECT
# WASM: target datalayout = "e-m:e-p:32:32-
# WASM: target triple = "wasm32-unknown-emscripten"
# WASM: declare i32 @talos_rt_v1_power_cancel_nba(ptr, i64, i64)
# WASM: call i32 @talos_rt_v1_power_cancel_nba(ptr {{.*}}, i64 {{.*}}, i64 1)
# OBJECT: Format: WASM
# OBJECT-NEXT: Arch: wasm32
# OBJECT-NEXT: AddressSize: 32bit
