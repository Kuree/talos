// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 9.7.3: master/slave RTC has priority while True. Its
// deassertion admits a later clock in the same Active batch. The balloon
// level-sensitive restore rule in 6.50 does not extend this master RTC hold.
// CHECK: RTC release passed

//--- design.sv
module leaf(input logic clk, input logic [7:0] d, output logic [7:0] q = 0);
  always @(posedge clk) q <= d;
endmodule
module top;
  import UPF::*;
  logic clk = 0, enable = 1, rtc = 0;
  logic [7:0] d = 8'h11;
  wire [7:0] q;
  leaf dut(clk, d, q);
  initial begin
    if (!supply_on("/top/AON.power") || !supply_on("/top/AON.ground", 0.0))
      $fatal(1, "initial supplies");
    #1 clk = 1;
    #1;
    if (q !== 8'h11) $fatal(1, "normal capture");
    clk = 0;
    #0; // Deliver the low level through the child input before its next edge.
    rtc = 1;
    rtc = 0;
    d = 8'h22;
    clk = 1;
    #1;
    if (q !== 8'h22) $fatal(1, "clock after RTC pulse");
    clk = 0;
    rtc = 1;
    #1;
    rtc = 0;
    d = 8'h33;
    clk = 1;
    #1;
    if (q !== 8'h33) $fatal(1, "clock after held RTC release");
    $display("RTC release passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_net VDD
create_supply_set AON -function {power VDD}
create_supply_set SW -function {ground AON.ground}
create_power_domain PD -elements dut -supply {primary SW}
create_power_switch PS -domain PD \
    -input_supply_port {vin AON.power} -output_supply_port {vout PD.primary.power} \
    -control_port {en enable} -on_state {ON vin en}
set_retention KEEP -domain PD -elements dut/q -retention_condition rtc
