// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0 && %t.bc0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// IEEE 1801-2018 6.50/9.7.3: B-only corruption cannot invalidate N's
// pending or future timed writes. A restore while R is OFF consumes corrupt B.
// CHECK: balloon NO_RET_SUP_COR epochs passed

//--- design.sv
module leaf(input logic clk, input logic [64:0] d,
            output logic [64:0] q = 0, output bit [64:0] qb = 0);
  always @(posedge clk) begin
    q <= #(top.delay_ticks) d;
    qb <= #(top.delay_ticks) d;
  end
endmodule
module top;
  import UPF::*;
  logic clk = 0, save = 0, restore = 0;
  logic [64:0] d = 0;
  int unsigned delay_ticks = 0;
  wire [64:0] q, qb;
  leaf dut(clk,d,q,qb);
  task automatic tick(input logic [64:0] v);
    clk = 0; d = v; #1 clk = 1; #1 clk = 0; #1;
  endtask
  task automatic restore_value;
    restore = 1; #1 restore = 0; #1;
  endtask
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground", 0.0) ||
        !supply_on("/top/RET.power") || !supply_on("/top/RET.ground", 0.0))
      $fatal(1, "supplies");
    tick(65'h10000000000000011);
    save = 1; #1 save = 0; #1;
    delay_ticks = 4;
    tick(65'h10000000000000022);
    if (!supply_off("/top/RET.power") || !supply_on("/top/RET.power"))
      $fatal(1, "short retention pulse");
    #5;
    if (q !== 65'h10000000000000022 || qb !== q)
      $fatal(1, "B-only loss cancelled delayed N write");
    restore_value();
    if (q !== 'x || qb !== 0) $fatal(1, "short pulse did not destroy B");
    delay_ticks = 0;
    tick(65'h10000000000000033);
    save = 1; #1 save = 0; #1;
    delay_ticks = 5;
    tick(65'h10000000000000044);
    if (!supply_off("/top/RET.power")) $fatal(1, "retention off");
    #5;
    if (q !== 65'h10000000000000044 || qb !== q)
      $fatal(1, "R-off commit was wrongly suppressed");
    restore_value();
    if (q !== 'x || qb !== 0) $fatal(1, "R-off restore resurrected B");
    if (!supply_on("/top/RET.power")) $fatal(1, "retention on");
    #1;
    if (q !== 'x || qb !== 0) $fatal(1, "powerup manufactured restore");
    $display("balloon NO_RET_SUP_COR epochs passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_set CORE
create_supply_set RET
create_power_domain PD -elements dut -supply {primary CORE}
set_retention KEEP -domain PD -elements {dut/q dut/qb} -retention_supply RET \
    -save_signal {save high} -restore_signal {restore high} -parameters NO_RET_SUP_COR
