// RUN: %split-file %s %t
// RUN: talos --vpi=off --saif=%t.saif -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 && FileCheck %s --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif -o /dev/null
// CHECK-DAG: (equal_strength (T0 2000000) (T1 0) (TX 3000000) (TZ 2000000) (TC 0) (TB 3000000))
// CHECK-DAG: (unequal_strength (T0 5000000) (T1 0) (TX 0) (TZ 2000000) (TC 1) (TB 3000000))
// CHECK-DAG: (one_unknown (T0 0) (T1 0) (TX 7000000) (TZ 0) (TC 0))
//--- design.sv
module top;
  timeunit 1ns; timeprecision 1ns;
  logic a = 0, b = 'z;
  wire equal_strength, unequal_strength, one_unknown;
  assign equal_strength = a;
  assign equal_strength = b;
  assign (strong0,strong1) unequal_strength = a;
  assign (weak0,weak1) unequal_strength = b;
  assign one_unknown = 1'bx;
  initial begin #2 b = 1; #3 a = 'z; b = 'z; #2 $finish; end
endmodule
