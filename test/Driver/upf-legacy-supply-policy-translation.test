// REQUIRES: upf
// RUN: %split-file %S/upf-legacy-supply-policy.test %t
// RUN: talos --upf %t/translate.upf --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.legacy
// RUN: %t.legacy +translate | FileCheck %S/upf-legacy-supply-policy.test
// RUN: talos --upf %t/translate.upf --upf %t/modern.upf --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.modern
// RUN: %t.modern +translate | FileCheck %S/upf-legacy-supply-policy.test
// RUN: talos --upf %t/translate.upf --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc +translate | FileCheck %S/upf-legacy-supply-policy.test
// IEEE 1801-2018 6.43/6.47: the implicit supplier obeys the same global
// translation as an explicit supplier without changing raw supply snapshots.
