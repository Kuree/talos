// RUN: %split-file %s %t
// RUN: talos --vpi=off --saif=%t.saif --saif-input=%t/library.saif -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 && FileCheck %s --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif -o /dev/null
// Both a procedural #delay and an explicit delayed NBA must retain the
// cell state before A changed. B changes while that cause is suspended.
// CHECK-COUNT-3: (Y (T0 8000000) (T1 2000000) (TX 0) (TZ 0) (TC 1)(COND (!B) (RISE) (IOPATH A (TC 1)
//--- design.sv
module delay_gate(input logic A, B, output logic Y = 0);
  timeunit 1ns; timeprecision 1ns;
  always @(A) begin #3 Y = A; end
endmodule
module nba_gate(input logic A, B, output logic Y = 0);
  timeunit 1ns; timeprecision 1ns;
  always @(A) Y <= #3 A;
endmodule
module task_gate(input logic A, B, output logic Y = 0);
  timeunit 1ns; timeprecision 1ns;
  task automatic hold(); #1; endtask
  always @(A) begin hold(); #2 Y = A; end
endmodule
module top;
  timeunit 1ns; timeprecision 1ns;
  logic A = 0, B = 0;
  wire Y1, Y2, Y3;
  delay_gate u1(A, B, Y1);
  nba_gate u2(A, B, Y2);
  task_gate u3(A, B, Y3);
  initial begin #5 A = 1; #1 B = 1; #4 $finish; end
endmodule
//--- library.saif
(SAIFILE (SAIFVERSION "2.0" "lib") (DIRECTION "forward")
  (DESIGN) (DATE) (VENDOR) (PROGRAM_NAME) (PROGRAM_VERSION) (DIVIDER /)
  (LIBRARY "L"
    (MODULE delay_gate (PORT Y (COND !B RISE_FALL (IOPATH A IOPATH_DEFAULT)
      COND_DEFAULT RISE_FALL (IOPATH A IOPATH_DEFAULT))))
    (MODULE nba_gate (PORT Y (COND !B RISE_FALL (IOPATH A IOPATH_DEFAULT)
      COND_DEFAULT RISE_FALL (IOPATH A IOPATH_DEFAULT))))
    (MODULE task_gate (PORT Y (COND !B RISE_FALL (IOPATH A IOPATH_DEFAULT)
      COND_DEFAULT RISE_FALL (IOPATH A IOPATH_DEFAULT))))))
