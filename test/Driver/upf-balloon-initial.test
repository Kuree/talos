// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0
// RUN: %t.bc0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// IEEE 1801-2018 9.2.1 exempts initial-block writes to normal storage.
// 6.50/9.7.2 still power the output driver; B starts corrupt independently.
// CHECK: balloon initialization passed

//--- design.sv
module leaf(input logic clk, output logic [0:7] q, output bit [0:1][3:0] qb);
  always @(posedge clk) begin q <= 8'h55; qb <= 8'h55; end
endmodule
module top;
  import UPF::*;
  logic clk = 0, enable = 0, restore = 0;
  wire [7:0] q, qb;
  leaf dut(clk,q,qb);
  initial begin
    if (!supply_on("/top/AON.power") || !supply_on("/top/AON.ground", 0.0))
      $fatal(1, "supplies");
    dut.q[0:3] = 4'h1;
    dut.q[4:7] = 4'h3;
    dut.q[7] = ~dut.q[7];
    dut.qb[0] = 4'h1;
    dut.qb[1] = 4'h7;
    dut.qb[1][3] = ~dut.qb[1][3];
    if (dut.q !== 8'h12 || dut.qb !== 8'h1f) $fatal(1, "model initialization readback");
  end
  initial begin
    #1;
    if (q !== 'x || qb !== 0) $fatal(1, "initial block bypassed output power");
    enable = 1;
    #1;
    if (q !== 8'h12 || qb !== 8'h1f) $fatal(1, "initial normal value lost");
    restore = 1; #1 restore = 0; #1;
    if (q !== 'x || qb !== 0) $fatal(1, "initial write manufactured save");
    $display("balloon initialization passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_net VDD
create_supply_set AON -function {power VDD}
create_supply_set SW -function {ground AON.ground}
create_power_domain PD -elements dut -supply {primary SW}
create_power_switch PS -domain PD \
    -input_supply_port {vin AON.power} -output_supply_port {vout PD.primary.power} \
    -control_port {en enable} -on_state {ON vin en}
set_retention KEEP -domain PD -elements {dut/q dut/qb} -restore_signal {restore high}
