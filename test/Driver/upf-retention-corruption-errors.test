// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: not talos --upf %t/design.upf -O0 -emit-sim --mlir-verify-each %t/design.sv -o %t.bad.mlir 2>&1 | FileCheck %s
// A shared helper needs per-caller specialization to distinguish the writer's
// own normal-state read from other callers' externally powered output read.
// CHECK: retention-powered normal-state readback through helpers is not implemented

//--- design.sv
module leaf(input logic clk, output logic [7:0] q = 0);
  always @(posedge clk) q <= top.read_q() + 1;
endmodule
module top;
  logic clk = 0, rtc = 0;
  wire [7:0] q;
  leaf dut(clk,q);
  function automatic logic [7:0] read_q(); return dut.q; endfunction
endmodule

//--- design.upf
create_supply_set CORE
create_supply_set RET
create_power_domain PD -elements dut -supply {primary CORE}
set_retention LIVE -domain PD -elements dut/q -retention_supply RET \
    -retention_condition rtc -use_retention_as_primary -parameters NO_RET_SUP_COR
