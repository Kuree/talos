// REQUIRES: upf
// RUN: %split-file %S/upf-retention-corruption-parameters.test %t
// RUN: talos -DBLOCKING --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %S/upf-retention-corruption-parameters.test
// RUN: talos -DBLOCKING --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 | FileCheck %S/upf-retention-corruption-parameters.test
// RUN: talos -DBLOCKING --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0 && %t.bc0 | FileCheck %S/upf-retention-corruption-parameters.test
// RUN: talos -DBLOCKING --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %S/upf-retention-corruption-parameters.test
