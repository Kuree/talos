// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/private.upf -emit-slang --mlir-verify-each %t/design.sv -o %t.private | FileCheck %s --check-prefix=PRIVATE
// RUN: talos --upf %t/late-state.upf -emit-slang --mlir-verify-each %t/design.sv -o %t.state | FileCheck %s --check-prefix=STATE
// RUN: talos --upf %t/late-update.upf -emit-slang --mlir-verify-each %t/design.sv -o %t.update | FileCheck %s --check-prefix=UPDATE
// RUN: talos --upf %t/public.upf -emit-slang --mlir-verify-each %t/design.sv -o %t.public | FileCheck %s --check-prefix=PUBLIC
// References to public topmost UPF objects and supply interface integration
// remain legal. Private references and child-side refinement do not. Late
// macro flags must validate the original command authority and roll back.
// PRIVATE: private object checks passed
// STATE: late catalog checks passed
// UPDATE: late function checks passed
// PUBLIC: public interface checks passed

//--- design.sv
module leaf(input logic in,output logic out); assign out=in; endmodule
module wrapper(input logic in,output logic out); leaf inner(in,out); endmodule
module top; logic in=0,iso=0,rtc=0; wire out; wrapper w(in,out); endmodule
//--- helper.upf
proc expect_error {script pattern} {
  if {[catch {uplevel 1 $script} message] != 1 || ![string match $pattern $message]} {
    error "expected <$pattern>, got <$message>"
  }
}
//--- child.upf
create_supply_net VDD
create_supply_port P -direction in
create_supply_set PUBLIC
create_supply_set BIND
create_power_domain PD -elements {}
create_power_domain LEGACY -elements {}
set_retention_elements LIST -elements {}
set_scope inner
create_supply_net VDD
create_supply_port P -direction in
create_supply_set PRIVATE
create_power_domain PRIVATE_PD -elements {}
set_retention_elements PRIVATE_LIST -elements {}
//--- base.upf
source [file join [file dirname [info script]] helper.upf]
load_upf [file join [file dirname [info script]] child.upf] -scope w
create_supply_net VDD
create_supply_net VSS
create_supply_set OUT
create_power_domain TOP -elements {}
//--- private.upf
source [file join [file dirname [info script]] base.upf]
set_design_attributes -models wrapper -is_soft_macro
expect_error {create_supply_set BAD -function {power w/inner/PRIVATE.power}} {*UPF reference crosses macro terminal boundary*}
expect_error {associate_supply_set {OUT w/inner/PRIVATE}} {*UPF reference crosses macro terminal boundary*}
expect_error {create_power_domain BAD -elements {} -supply {primary w/inner/PRIVATE}} {*UPF reference crosses macro terminal boundary*}
expect_error {add_power_state w/inner/PRIVATE -state {SAFE -supply_expr {power == FULL_ON} -simstate NORMAL}} {*UPF reference crosses macro terminal boundary*}
expect_error {add_power_state w/PUBLIC -state {SAFE -supply_expr {power == FULL_ON} -simstate NORMAL}} {*UPF refinement crosses macro terminal boundary*}
expect_error {create_composite_domain C -subdomains w/inner/PRIVATE_PD} {*UPF reference crosses macro terminal boundary*}
expect_error {set_retention R -domain TOP -elements w/inner/PRIVATE_LIST -retention_condition rtc} {*UPF reference crosses macro terminal boundary*}
expect_error {set_retention RETRY -domain TOP -elements rtc -retention_supply w/inner/PRIVATE -retention_condition rtc} {*UPF reference crosses macro terminal boundary*}
set_retention RETRY -domain TOP -elements rtc -retention_condition rtc
expect_error {connect_supply_net VDD -ports w/inner/P} {*UPF reference crosses macro terminal boundary*}
expect_error {set_domain_supply_net w/inner/PRIVATE_PD -primary_power_net VDD -primary_ground_net VSS} {*UPF reference crosses macro terminal boundary*}
expect_error {set_isolation ISO -domain w/inner/PRIVATE_PD -applies_to outputs -location parent -isolation_signal iso -clamp_value 0} {*UPF reference crosses macro terminal boundary*}
puts "private object checks passed"
//--- late-state.upf
source [file join [file dirname [info script]] base.upf]
add_power_state w/PUBLIC -state {SAFE -supply_expr {power == FULL_ON} -simstate NORMAL}
expect_error {set_design_attributes -models wrapper -is_soft_macro} {*invalidates an earlier reference*}
puts "late catalog checks passed"
//--- late-update.upf
source [file join [file dirname [info script]] base.upf]
set_scope w
create_supply_set BIND -update -function {power VDD}
set_scope ..
expect_error {set_design_attributes -models wrapper -is_soft_macro} {*invalidates an earlier reference*}
puts "late function checks passed"
//--- public.upf
source [file join [file dirname [info script]] base.upf]
set_design_attributes -models wrapper -is_soft_macro
create_supply_set LINK -function {power w/PUBLIC.power}
associate_supply_set {OUT w/PUBLIC}
connect_supply_net VDD -ports w/P
create_composite_domain C -subdomains w/PD
set_domain_supply_net w/LEGACY -primary_power_net VDD -primary_ground_net VSS
set_retention R -domain TOP -elements w/LIST -retention_condition rtc
puts "public interface checks passed"
