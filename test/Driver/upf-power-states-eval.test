// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --native-scheduler=eval --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// CHECK: power-state eval handoff passed
// IEEE 1801-2018 6.5/9.6.7: driver-only level logic reevaluates on actual
// NORMAL restoration, including the native eval scheduler. Voltage changes
// between NORMAL states preserve the previous evaluation and side effects.

//--- design.sv
package audit;
 int calls=0;
 function logic sample();calls++;return 1;endfunction
endpackage
module leaf(output wire q);assign q=audit::sample();endmodule
module top;
 import UPF::*;
 wire q;leaf dut(q);
 initial begin
  #1;void'(supply_on("/top/CORE.power"));void'(supply_on("/top/CORE.ground",0.0));
  #1;if(q!==1 || audit::calls!=1) $fatal(1,"startup");
  void'(supply_on("/top/CORE.power",0.8));
  #1;if(q!==1 || audit::calls!=1) $fatal(1,"voltage handoff reevaluated");
  void'(supply_on("/top/CORE.power",0.9));
  #1;if(q!==1'bx || audit::calls!=1) $fatal(1,"gap active");
  void'(supply_on("/top/CORE.power",1.0));
  #1;if(q!==1 || audit::calls!=2) $fatal(1,"restore");
  $display("power-state eval handoff passed");$finish;
 end
endmodule

//--- design.upf
create_supply_set CORE
create_power_domain PD -elements dut -supply {primary CORE}
add_power_state CORE -supply -state {ON -supply_expr {(power == {FULL_ON 1.0} || power == {FULL_ON 0.8}) && ground == FULL_ON}}
