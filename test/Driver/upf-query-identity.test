// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: cp %S/Inputs/upf/assertions.tcl %t/assertions.tcl
// RUN: talos --upf %t/design.upf -emit-slang %t/design.sv -o %t.mlir | FileCheck %s
// IEEE 1801-2018 5.3.5/6.31 and IEEE 1800-2023 5.6.1/7.4:
// escaped literal indices and array selectors have separate identities;
// escaped navigation names remain literal, and enum selections are flat.
// CHECK: UPF query identity and declared types passed

//--- design.sv
module leaf;
  wire x;
endmodule
module top;
  leaf \normal[0] ();
  leaf normal[0:1]();
  leaf \arr.dot [0:1]();
  leaf \. ();
  leaf \.. ();
  typedef enum logic [1:3] {E=0} asc_t;
  wire asc_t en;
  typedef enum logic {ZERO, ONE} small_t;
  wire small_t se;
  typedef logic [4:2] range_t;
  wire range_t derived;
  logic [1:3] variable_value;
  reg [2:0] reg_value;
  int ints[1:0];
  wire [1:0] f, foo;
endmodule

//--- design.upf
source [file join [file dirname [info script]] assertions.tcl]
set instances [find_objects . -pattern * -object_type inst]
assert_equal [lsort $instances] [lsort [list {\.} {\.\.} {normal\[0\]} {normal[0]} {normal[1]} {arr\.dot[0]} {arr\.dot[1]}]]
assert_equal [find_objects {normal[0]} -pattern x -object_type net] [list {normal[0]/x}]
assert_equal [find_objects {normal\[0\]} -pattern x -object_type net] [list {normal\[0\]/x}]
assert_equal [find_objects {arr\.dot[0]} -pattern x -object_type net] [list {arr\.dot[0]/x}]
assert_equal [find_objects {arr\.dot[1]} -pattern x -object_type net] [list {arr\.dot[1]/x}]
assert_equal [find_objects {\.} -pattern x -object_type net] [list {\./x}]
assert_equal [find_objects {\.\.} -pattern x -object_type net] [list {\.\./x}]
assert_equal [set_scope {normal[0]}] /
assert_equal [find_objects . -pattern x -object_type net] x
assert_equal [set_scope /] {/normal[0]}
assert_equal [set_scope {normal\[0\]}] /
assert_equal [find_objects . -pattern x -object_type net] x
assert_equal [set_scope /] {/normal\[0\]}
assert_equal [set_scope {arr\.dot[0]}] /
assert_equal [set_scope ..] {/arr\.dot[0]}
assert_equal [set_scope {\.}] /
assert_equal [set_scope /] {/\.}
assert_equal [set_scope {\.\.}] /
assert_equal [set_scope /] {/\.\.}

assert_equal [find_objects . -pattern {en\[*\]} -object_type net] [list {en[2]} {en[1]} {en[0]}]
assert_equal [find_objects . -pattern {se\[*\]} -object_type net] [list {se[0]}]
assert_equal [find_objects . -pattern {derived\[*\]} -object_type net] [list {derived[4]} {derived[3]} {derived[2]}]
assert_equal [find_objects . -pattern {variable_value\[*\]} -object_type net] [list {variable_value[1]} {variable_value[2]} {variable_value[3]}]
assert_equal [find_objects . -pattern reg_value -object_type net] reg_value
assert_equal [find_objects . -pattern {ints\[*\]\[0\]} -object_type net] [list {ints[1][0]} {ints[0][0]}]
assert_equal [find_objects . -pattern variable_value] variable_value
assert_equal [find_objects . -pattern {^fo*\[0\]$} -regexp -object_type net] [list {f[0]} {foo[0]}]
assert_equal [find_objects . -pattern {^K*foo\[0\]$} -regexp -object_type net] [list {foo[0]}]
assert_equal [find_objects . -pattern {^missing|^en\[0\]$} -regexp -object_type net] [list {en[0]}]
puts "UPF query identity and declared types passed"
