// REQUIRES: native-elf
// RUN: %split-file %s %t
// RUN: %target_clang -fPIC -shared -nostdlib %t/reader.c -I%resource_dir/include -o %t/reader.so
// RUN: talos -O3 --vpi=read --native-scheduler=eval --nba-queue=generic --mlir-timing %S/eval-ranked-active-waits.sv %t/reader.so -o %t/sim 2> %t/plan
// RUN: FileCheck %S/eval-ranked-active-waits.sv --check-prefix=PLAN < %t/plan
// RUN: %t/sim > %t/out && FileCheck %S/eval-ranked-active-waits.sv < %t/out && FileCheck %s < %t/out
// RUN: talos -O3 --vpi=read --native-scheduler=generic %S/eval-ranked-active-waits.sv %t/reader.so -o %t/framed && %t/framed | diff -u %t/out -
// RUN: talos -O3 --vpi=read --execution-tier=bytecode %S/eval-ranked-active-waits.sv %t/reader.so -o %t/bytecode && %t/bytecode | diff -u %t/out -
// CHECK: VPI ticks=3

//--- reader.c
#include "vpi_user.h"
static PLI_INT32 finish(p_cb_data unused) {
  vpiHandle ticks = vpi_handle_by_name((PLI_BYTE8 *)"top.ticks", 0);
  s_vpi_value value = {.format = vpiIntVal};
  if (ticks)
    vpi_get_value(ticks, &value);
  vpi_printf("VPI ticks=%d\n", ticks ? value.value.integer : -1);
  return 0;
}
static void start(void) {
  s_cb_data cb = {.reason = cbEndOfSimulation, .cb_rtn = finish};
  vpi_register_cb(&cb);
}
void (*vlog_startup_routines[])(void) = {start, 0};
