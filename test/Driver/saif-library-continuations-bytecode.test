// RUN: %split-file %S/saif-library-continuations.test %t
// RUN: talos --vpi=off --saif=%t.saif --saif-input=%t/library.saif -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.exe && %t.exe && FileCheck %S/saif-library-continuations.test --input-file=%t.saif
// The bytecode tier collects through its own net, NBA, and task paths.
// Inputs and checks are shared with saif-library-continuations.test.
