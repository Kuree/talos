// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: not %t.o0 2>&1 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: not %t.o3 2>&1 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode %t/design.sv -o %t.bc
// RUN: not %t.bc 2>&1 | FileCheck %s
// IEEE 1801-2018 6.22: explicit OFF conflicts with ANY true ON state.
// CHECK: ON and OFF conditions are simultaneously true
// CHECK: multiple ON explicit OFF conflict passed

//--- design.sv
module leaf(output wire q);
  assign q = 1'b1;
endmodule
module top;
  logic a = 0, b = 1, off_signal = 0;
  wire q;
  leaf dut(q);
  initial begin
    #1;
    if (q !== 1'b1) $fatal(1, "second ON state failed");
    off_signal = 1;
    #1;
    if (q !== 1'bx) $fatal(1, "OFF missed second ON state");
    b = 0; off_signal = 0;
    #1;
    if (q !== 1'bx) $fatal(1, "explicit OFF false implied ON");
    a = 1;
    #1;
    if (q !== 1'b1) $fatal(1, "first ON recovery failed");
    $display("multiple ON explicit OFF conflict passed");
    $finish;
  end
endmodule

//--- design.upf
create_power_domain PD -elements dut
foreach net {VDD SW} {create_supply_net $net}
create_power_switch PS -domain PD \
    -input_supply_port {vin VDD} -output_supply_port {vout SW} \
    -control_port {a a} -control_port {b b} -control_port {disable off_signal} \
    -on_state {FIRST vin a} -on_state {SECOND vin b} -off_state {OFF disable}
