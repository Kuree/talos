// RUN: %split-file %s %t
// RUN: talos --vpi=off --saif=%t.saif -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 && FileCheck %s --input-file=%t.saif
// Each committed NBA is observable, even with no HDL consumer of q.
// CHECK: (DURATION 5000000)
// CHECK: (q (T0 2000000) (T1 3000000) (TX 0) (TZ 0) (TC 3))
//--- design.sv
module top;
  timeunit 1ns; timeprecision 1ns;
  logic q = 0;
  initial begin
    #2;
    q <= 1; q <= 0; q <= 1;
    #3 $finish;
  end
endmodule
