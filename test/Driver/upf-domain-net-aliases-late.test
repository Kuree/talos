// RUN: %t.o3 | FileCheck %S/upf-domain-net-aliases.test
// RUN: talos --upf %t/late.upf --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %S/upf-domain-net-aliases.test
