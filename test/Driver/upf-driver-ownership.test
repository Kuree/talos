// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 9.5.3/9.6.2 corrupt powered contributions, including one
// aliased to an input port, while preserving an external driver's contribution.
// CHECK: aliased driver ownership passed

//--- design.sv
module child(input wire d, output logic q);
  always_comb q = d;
endmodule
module wrapper(input logic drive, output logic q);
  wire w;
  assign w = drive;
  child u(w, q);
endmodule
module top;
  logic drive = 1, power_en = 1, iso = 0;
  wire q;
  wrapper dut(drive, q);
  assign dut.w = drive; // An independent contribution owned by the parent.
  initial begin
    #1;
    if (dut.w !== 1'b1 || q !== 1'b1) $fatal(1, "initial aliased driver failed");
    power_en = 0; iso = 1;
    #1;
    if (dut.w !== 1'bx || dut.u.q !== 1'bx || q !== 1'b0)
      $fatal(1, "powered contribution to an aliased input escaped corruption");
    power_en = 1; iso = 0;
    #1;
    if (dut.w !== 1'b1 || q !== 1'b1)
      $fatal(1, "external driver was corrupted or internal driver did not restore");
    drive = 0;
    #1;
    if (dut.w !== 1'b0 || q !== 1'b0) $fatal(1, "post-restoration drive failed");
    $display("aliased driver ownership passed");
    $finish;
  end
endmodule

//--- design.upf
create_power_domain PD -elements dut
foreach net {VDD VDD_SW} {create_supply_net $net}
create_power_switch SW -domain PD \
    -input_supply_port {vin VDD} -output_supply_port {vout VDD_SW} \
    -control_port {en power_en} -on_state {ON vin en}
set_isolation ISO -domain PD -isolation_signal iso -clamp_value 0 \
    -applies_to outputs -location parent
