# REQUIRES: upf
# RUN: %split-file %s %t
# RUN: not talos --upf %S/Inputs/upf/switchable.upf -O3 --native-scheduler=eval %S/upf-combinational-domain.sv -o %t/eval 2>&1 | FileCheck %s --check-prefix=AOT
# RUN: not talos --upf %S/Inputs/upf/two-domains.upf %S/Inputs/upf/design.sv -o %t/multi 2>&1 | FileCheck %s --check-prefix=MULTI
# RUN: not talos --upf %S/Inputs/upf/switchable.upf %t/mixed.sv -o %t/mixed 2>&1 | FileCheck %s --check-prefix=MIXED
# IEEE 1801-2018 9.5.3: generated NBA tables do not support cancellation yet.
# AOT: power-loss NBA cancellation requires generic ordering
# MULTI: initial UPF implementation supports one switchable domain
# MIXED: mixed level/edge sensitivity in a switchable domain is not implemented

#--- mixed.sv
module leaf(input logic clk, d, output logic q);
  always @(posedge clk or d) q = d;
endmodule
module upf_test;
  logic clk, d, power_en, iso;
  wire q;
  leaf dut(clk, d, q);
endmodule
