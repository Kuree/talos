// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 9.2.2/9.2.3/9.7.3: retention watches published switched
// rails. A raw driver glitch that coalesces before network evaluation cannot
// corrupt backing or invalidate pending writes while that rail stays FULL_ON.
// CHECK: coalesced retention q=1 plain=1 rail=1

//--- design.sv
module leaf(input logic clk,d,output logic q=0,plain=0);
 always @(posedge clk) begin q<=#3 d;plain<=#3 d;end
endmodule
module rail_dummy(output wire y);assign y=1'b1;endmodule
module top;
 import UPF::*;
 logic clk=0,d=1,enable=1,ret_enable=1,rtc=0;wire q,plain,y;
 leaf dut(clk,d,q,plain);rail_dummy dummy(y);
 initial begin
  if(!supply_on("/top/AON.power")||!supply_on("/top/AON.ground",0.0))$fatal(1,"supply");
  #1;clk=1;#1;
  ret_enable=0;ret_enable=1;
  #3;
  $display("coalesced retention q=%b plain=%b rail=%0d",q,plain,(get_supply_state(get_supply_value("/top/RAIL.power"))==FULL_ON));
  if(q!==1 || plain!==1)$fatal(1,"coalesced retention supply cancelled work");
  $finish;
 end
endmodule

//--- design.upf
create_supply_net VDD
create_supply_set AON -function {power VDD}
create_supply_set SW -function {ground AON.ground}
create_supply_set RAIL -function {ground AON.ground}
create_power_domain PD -elements dut -supply {primary SW}
create_power_domain RP -elements dummy -supply {primary RAIL}
create_power_switch PS -domain PD -input_supply_port {vin AON.power} -output_supply_port {vout PD.primary.power} -control_port {en enable} -on_state {ON vin en}
create_power_switch RS -domain RP -input_supply_port {vin AON.power} -output_supply_port {vout RP.primary.power} -control_port {en ret_enable} -on_state {ON vin en}
set_retention KEEP -domain PD -elements dut/q -retention_supply RAIL -retention_condition rtc
