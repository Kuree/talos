// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -emit-slang --mlir-verify-each %t/design.sv -o %t.mlir | FileCheck %s
// RUN: FileCheck %s --check-prefix=IR < %t.mlir
// IEEE 1801-2018 5.10/6.5: caught errors preserve command history, catalogs,
// required functions, and -complete. Refinements cannot contradict or broaden
// predicates, change fixed simstates, or cross the original execution scope.
// 5.4/6.5.4: SV operator widths/precedence and typed supply comparisons.
// CHECK: power-state errors and atomic refinement passed
// IR: upf.supply_set @"/top/Atomic" functions
// IR-SAME: required ["ground", "power"]
// IR-NOT: name = "Broken"

//--- design.sv
module leaf;
endmodule
module top;
  leaf dut(), child();
endmodule

//--- design.upf
proc expect_error {script pattern} {
    set code [catch {uplevel 1 $script} message]
    if {$code != 1 || ![string match $pattern $message]} {
        error "expected <$pattern>, got code $code <$message>"
    }
}
create_supply_set Atomic
create_power_domain PD -elements dut -supply {primary Atomic}
expect_error {add_power_state} {*missing argument*}
expect_error {add_power_state {} Atomic} {*one object name*}
expect_error {add_power_state {}} {*requires a supply set*}
expect_error {add_power_state missing} {*unknown supply set*}
expect_error {add_power_state Atomic -state} {*missing value*}
expect_error {add_power_state Atomic -domain} {*unsupported add_power_state option*}
expect_error {add_power_state Atomic -update -update} {*duplicate UPF option*}
expect_error {add_power_state Atomic -complete -complete} {*duplicate UPF option*}
expect_error {add_power_state Atomic -supply -supply} {*duplicate UPF option*}
expect_error {add_power_state Atomic -update} {*first command*omit -update*}
expect_error {add_power_state Atomic -update -state {NEW -simstate NORMAL}} {*first command*omit -update*}
expect_error {add_power_state Atomic -complete \
    -state {ON -supply_expr {power == FULL_ON && nwell == FULL_ON}} \
    -state {Broken -simstate invalid}} {*unsupported power-state simstate*}
# The failed command must not commit its nwell requirement or -complete bit.
add_power_state Atomic -state {ON -supply_expr {power == {FULL_ON 1.0}}}
expect_error {add_power_state Atomic -state {NEW}} {*subsequent*require -update*}
expect_error {add_power_state Atomic -update -state {ON -simstate CORRUPT}} {*simstate conflicts*}
expect_error {add_power_state Atomic -update -state {ON -supply_expr {power == FULL_ON}}} {*unsupported supply-expression refinement*}
expect_error {add_power_state Atomic -update -state {ON -supply_expr {power == {FULL_ON 1.0} && power == {FULL_ON 0.8}}}} {*contradictory supply expression*}
expect_error {add_power_state Atomic -update -state {ON -supply_expr {power == {FULL_ON 1.0} && power.voltage > power.voltage}}} {*contradictory supply expression*}
expect_error {add_power_state Atomic -update -state {ON -supply_expr {power == {FULL_ON 1.0} && FULL_ON == OFF}}} {*contradictory supply expression*}
add_power_state Atomic -update -state {SLEEP}
add_power_state Atomic -update -state {SLEEP -supply_expr {power == OFF} -simstate NOT_NORMAL}
expect_error {add_power_state Atomic -update -state {SLEEP -simstate NORMAL}} {*simstate conflicts*}
add_power_state Atomic -update -state {SLEEP -simstate CORRUPT -illegal}
expect_error {add_power_state Atomic -update -state {SLEEP -legal}} {*cannot be made legal*}
add_power_state Atomic -update -complete
expect_error {add_power_state Atomic -update -state {NEW -simstate NORMAL}} {*after -complete*}
set_scope child
expect_error {add_power_state /Atomic -update -state {ON}} {*original execution scope*}
set_scope /

create_supply_set Foreign
associate_supply_set {Atomic Foreign}
expect_error {add_power_state Foreign -state {ON -supply_expr {Atomic.power == FULL_ON}}} {*another supply set's function*6.5.6a*}

foreach expression {
    {!power == FULL_ON}
    {power.voltage == FULL_ON}
    {power < FULL_ON}
    {power == {FULL_ON 1.0 2.0}}
    {power == {BOGUS 1.0}}
    {power == {FULL_ON .5}}
    {power.voltage == 1.}
    {power.voltage == 1._0}
    {power.voltage == 1e+}
    {power.voltage == 1e999}
    {power == FULL_ON && unknown == FULL_ON}
    {power == FULL_ON && (~0 == 0)}
    {power == FULL_ON && (1 & (power == FULL_ON))}
    {power == FULL_ON || 9007199254740992 == 9007199254740993}
    {power == FULL_ON && (power == FULL_ON) == 3}
    {power == FULL_ON &&}
} {
    expect_error [list add_power_state Foreign -state [list ON -supply_expr $expression]] {*}
}
expect_error {add_power_state Foreign -state {}} {*requires a name*}
expect_error {add_power_state Foreign -state {ON.SUB -simstate NORMAL}} {*hierarchical*not implemented*}
expect_error {add_power_state Foreign -state {ERROR -simstate CORRUPT}} {*explicit edits*not implemented*}
expect_error {add_power_state Foreign -state {S -logic_expr {enable}}} {*unsupported power-state option*}
expect_error {add_power_state Foreign -state {S -power_expr {1.0}}} {*unsupported power-state option*}
expect_error {add_power_state Foreign -state {S -simstate CORRUPT_ON_ACTIVITY}} {*unsupported power-state simstate*}
expect_error {add_power_state Foreign -state {S -simstate}} {*missing value*}
expect_error {add_power_state Foreign -state {S -supply_expr}} {*missing value*}
expect_error {add_power_state Foreign -state {S -legal -illegal}} {*both -legal and -illegal*}
expect_error {add_power_state Foreign -state {S -legal -legal}} {*duplicate power-state option*}

# Explicit one-bit operations and comparison-result coercion retain SV widths.
add_power_state Foreign -state {ON -supply_expr {((power == FULL_ON) & 1'b1) == 1 && ~1'b0 && !(power == OFF)}}
create_supply_set FirstUpdate
add_power_state FirstUpdate -update -state {ON -supply_expr {power == {FULL_ON 1.0}}} \
    -state {LOW -supply_expr {power == {FULL_ON 0.8}} -simstate NORMAL}
create_supply_set FirstBase
add_power_state FirstBase -state {ON -supply_expr {power == {FULL_ON 1.0}}} \
    -state {LOW -supply_expr {power == {FULL_ON 0.8}} -simstate NORMAL}

# Successful refinements retain every old constraint in every OR branch (5.10).
create_supply_set Refined
add_power_state Refined -state {ON -supply_expr {power == FULL_ON}}
add_power_state Refined -update -state {ON -supply_expr {power == {FULL_ON 1.0}}}
add_power_state Refined -update -state {ON -supply_expr {power == {FULL_ON 1.0} && ground == FULL_ON}}
add_power_state Refined -update -state {ON -supply_expr {
    (power == {FULL_ON 1.0} && ground == FULL_ON && ground.voltage == 0.0) ||
    (power == {FULL_ON 1.0} && ground == FULL_ON && ground.voltage == 1.0)
}}
create_supply_set Negated
add_power_state Negated -state {ON -supply_expr {power != FULL_ON}}
# Aggregate != broadens state-only != by admitting FULL_ON at other voltages.
expect_error {add_power_state Negated -update -state {ON -supply_expr {power != {FULL_ON 1.0}}}} {*unsupported supply-expression refinement*}

create_supply_set Limits
set expression [string repeat x 65537]
expect_error [list add_power_state Limits -state [list ON -supply_expr $expression]] {*64 KiB*}
set expression "[string repeat ( 257]power == FULL_ON[string repeat ) 257]"
expect_error [list add_power_state Limits -state [list ON -supply_expr $expression]] {*nesting*256*}
set expression {power == FULL_ON}
for {set i 0} {$i < 10} {incr i} {set expression "($expression) && ($expression)"}
expect_error [list add_power_state Limits -state [list ON -supply_expr $expression]] {*4096 nodes*}
set expression {power == FULL_ON || power == OFF}
set expression [join [lrepeat 9 "($expression)"] { && }]
expect_error [list add_power_state Limits -state [list ON -supply_expr $expression]] {*consistency check exceeds*}
set args {}
for {set i 0} {$i < 257} {incr i} {lappend args -state [list S$i]}
expect_error [list add_power_state Limits {*}$args] {*256 states*}
set expression {power == FULL_ON}
for {set i 0} {$i < 7} {incr i} {set expression "($expression) && ($expression)"}
set args {}
for {set i 0} {$i < 129} {incr i} {lappend args -state [list S$i -supply_expr $expression -simstate NORMAL]}
expect_error [list add_power_state Limits {*}$args] {*65536 tokens*}
# Every rejected first command above must leave Limits usable as a new catalog.
add_power_state Limits -state {DRAFT}
puts {power-state errors and atomic refinement passed}
