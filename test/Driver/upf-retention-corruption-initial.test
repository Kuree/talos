// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0 && %t.bc0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// IEEE 1801-2018 9.2.1/6.50: initial model writes/readbacks use N;
// a RET-powered output remains corrupt while R is OFF despite NO_RET_SUP_COR.
// CHECK: retention parameter initialization passed

//--- design.sv
module leaf(input logic clk, output logic [0:7] q, output bit [0:1][3:0] qb);
  always @(posedge clk) begin q <= 8'h55; qb <= 8'h55; end
endmodule
module top;
  import UPF::*;
  logic clk = 0, rtc = 0;
  wire [7:0] q, qb;
  leaf dut(clk,q,qb);
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground", 0.0) ||
        !supply_on("/top/RET.ground", 0.0)) $fatal(1, "supplies");
    dut.q[0:3] = 4'h1; dut.q[4:7] = 4'h3;
    dut.q[7] = ~dut.q[7];
    dut.qb[0] = 4'h1; dut.qb[1] = 4'h7;
    dut.qb[1][3] = ~dut.qb[1][3];
    if (dut.q !== 8'h12 || dut.qb !== 8'h1f) $fatal(1, "normal initialization readback");
  end
  initial begin
    #1;
    if (q !== 'x || qb !== 0) $fatal(1, "initial write bypassed RET output power");
    if (!supply_on("/top/RET.power")) $fatal(1, "retention on");
    #1;
    if (q !== 8'h12 || qb !== 8'h1f) $fatal(1, "exempt normal initialization lost");
    $display("retention parameter initialization passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_set CORE
create_supply_set RET
create_power_domain PD -elements dut -supply {primary CORE}
set_retention LIVE -domain PD -elements {dut/q dut/qb} -retention_supply RET \
    -retention_condition rtc -use_retention_as_primary -parameters NO_RET_SUP_COR
