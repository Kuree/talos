// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0
// RUN: %t.bc0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// IEEE 1801-2018 6.50/9.7.3 accepts either control alone. An omitted
// operation does not manufacture a save or restore. Strategies sharing a
// sequential process keep distinct saved state and clock snapshots.
// CHECK: one-sided balloon passed

//--- design.sv
module leaf(input logic clk, d, output logic qs = 0, qr = 0);
  always @(posedge clk) begin qs <= d; qr <= d; end
endmodule
module top;
  import UPF::*;
  logic clk = 0, d = 1, save = 0, restore = 0;
  wire qs, qr;
  leaf dut(clk,d,qs,qr);
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground", 0.0))
      $fatal(1, "supplies");
    #1 clk = 1;
    #1 clk = 0;
    save = 1; #1 save = 0; #1;
    if (qs !== 1 || qr !== 1) $fatal(1, "save changed normal storage");
    if (!supply_off("/top/CORE.power")) $fatal(1, "off");
    #1;
    if (!supply_on("/top/CORE.power")) $fatal(1, "on");
    #1;
    if (qs !== 1'bx || qr !== 1'bx) $fatal(1, "implicit restore");
    d = 0; clk = 1; #1 clk = 0; #1;
    if (qs !== 0 || qr !== 0) $fatal(1, "normal recovery");
    restore = 1; #1 restore = 0; #1;
    if (qs !== 0 || qr !== 1'bx) $fatal(1, "missing save was manufactured");
    $display("one-sided balloon passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_set CORE
create_power_domain PD -elements dut -supply {primary CORE}
set_retention SAVE -domain PD -elements dut/qs -save_signal {save high}
set_retention RESTORE -domain PD -elements dut/qr -restore_signal {restore high}
