// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0 && %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3 && %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc0 && %t.bc0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc3 && %t.bc3 | FileCheck %s
// A protected source has no lifetime loss, even if it owns resolved drivers.
// The retained path needs no source ticket/epoch substitution; ordinary
// foreign-target writes may use the exact destination ticket directly.
// CHECK: protected retained source passed

//--- design.sv
module leaf; logic q = 0, plain = 0; endmodule
module producer(output wire trace);
  assign trace = top.clk ^ top.d;
  always @(posedge top.clk) begin
    top.dut.q <= #2 top.d;
    top.dut.plain <= #2 top.d;
    top.outside <= #2 top.d;
  end
endmodule
module top;
  import UPF::*;
  logic clk = 0, d = 1, hold = 0, outside;
  wire trace;
  leaf dut();
  producer src(trace);
  initial begin
    if (!supply_on("/top/P.power") || !supply_on("/top/P.ground", 0.0)) $fatal(1, "supplies");
    #1 clk = 1; #3 clk = 0;
    if (dut.q !== 1 || dut.plain !== 1 || outside !== 1) $fatal(1, "initial capture");
    hold = 1;
    if (!supply_off("/top/P.power")) $fatal(1, "target off");
    d = 0; #1 clk = 1; #3 clk = 0;
    if (dut.q !== 'x || dut.plain !== 'x || outside !== 0) $fatal(1, "protected producer neighbors");
    if (!supply_on("/top/P.power")) $fatal(1, "target restore");
    #1;
    if (dut.q !== 1 || dut.plain !== 'x) $fatal(1, "retained restore");
    hold = 0; #1 clk = 1; #3 clk = 0;
    if (dut.q !== 0 || dut.plain !== 0 || outside !== 0) $fatal(1, "fresh capture");
    $display("trace %b", trace);
    $display("protected retained source passed"); $finish;
  end
endmodule
//--- design.upf
create_supply_set P
create_power_domain PD -elements dut -supply {primary P}
set_retention RET -domain PD -elements dut/q -retention_condition hold
create_power_domain SOURCE -elements src -supply {primary PD.RET.retention_supply}
