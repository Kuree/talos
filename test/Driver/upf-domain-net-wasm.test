// REQUIRES: upf
// RUN: %split-file %S/upf-domain-net-aliases.test %t
// RUN: talos --upf %t/design.upf --target=wasm32 -O3 --mlir-verify-each -c %t/design.sv -o %t.o
// RUN: talos --upf %t/late.upf --upf %t/design.upf --target=wasm32 -O0 --execution-tier=bytecode --mlir-verify-each -c %t/design.sv -o %t.bc.o
// RUN: %llvm_dist/bin/llvm-readobj --file-headers %t.o %t.bc.o | FileCheck %s --check-prefix=HEADERS
// RUN: %llvm_dist/bin/llvm-nm --undefined-only %t.o %t.bc.o | FileCheck %s --check-prefix=SYMBOLS --implicit-check-not=Tcl_
// RUN: %llvm_dist/bin/llvm-nm --undefined-only %t.bc.o | FileCheck %s --check-prefix=BYTECODE --implicit-check-not=talos_rt_v1_power_nba
// IEEE 1801-2018 6.24.1/9.2.2: reuse and scoped aliases lower to existing
// fixed64 supply/guard handles with 32-bit pointers and no simulator Tcl.
// HEADERS-COUNT-2: AddressSize: 32bit
// SYMBOLS: talos_rt_v1_
// BYTECODE: talos_rt_v1_
