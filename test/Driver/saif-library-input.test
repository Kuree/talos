// RUN: %split-file %s %t
// RUN: talos --saif=%t.saif --saif-input=%t/library.saif -emit-sim %t/design.sv -o %t.mlir
// RUN: FileCheck %s --input-file=%t.mlir
// CHECK: saif.cells = []
//--- design.sv
module top;
  initial #1 $finish;
endmodule
//--- library.saif
(SAIFILE (SAIFVERSION "2.0" "lib") (DIRECTION "forward") (DESIGN) (DATE)
  (VENDOR) (PROGRAM_NAME) (PROGRAM_VERSION) (DIVIDER .) (LIBRARY "L"))
