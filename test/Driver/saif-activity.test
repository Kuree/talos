// RUN: %split-file %s %t
// RUN: talos --vpi=off --saif=%t.saif --mlir-verify-each -O3 %t/design.sv -o %t.o3 && %t.o3 && FileCheck %s --input-file=%t.saif
// RUN: talos-translate --import-saif %t.saif | talos-opt | FileCheck %s --check-prefix=IR
// Three changes at t2 must survive optimization and publication batching.
// TC excludes X/Z transitions (IEEE 1801-2018 I.3.5.1).
// CHECK: (TIMESCALE 1 fs) (DURATION 12000000)
// CHECK-DAG: (q (T0 4000000) (T1 3000000) (TX 2000000) (TZ 3000000) (TC 3))
// CHECK-DAG: (descending[1] (T0 2000000) (T1 10000000) (TX 0) (TZ 0) (TC 1))
// CHECK-DAG: (descending[2] (T0 12000000) (T1 0) (TX 0) (TZ 0) (TC 0))
// CHECK-DAG: (descending[3] (T0 2000000) (T1 10000000) (TX 0) (TZ 0) (TC 1))
// CHECK-DAG: (ascending[0] (T0 2000000) (T1 10000000) (TX 0) (TZ 0) (TC 1))
// CHECK-DAG: (ascending[2] (T0 12000000) (T1 0) (TX 0) (TZ 0) (TC 0))
// CHECK-DAG: (floating (T0 0) (T1 0) (TX 0) (TZ 12000000) (TC 0))
// CHECK-DAG: (literal\.dot (T0 2000000) (T1 10000000) (TX 0) (TZ 0) (TC 1))
// CHECK-DAG: (foo\$bar (T0 12000000) (T1 0) (TX 0) (TZ 0) (TC 0))
// CHECK-DAG: (\1foo (T0 12000000) (T1 0) (TX 0) (TZ 0) (TC 0))
// CHECK-DAG: (q\[0\] (T0 12000000) (T1 0) (TX 0) (TZ 0) (TC 0))
// IR: saif.file
// IR: saif.header duration {value = #saif.number<"12000000">}

//--- design.sv
module top;
  timeunit 1ns; timeprecision 1ns;
  logic q = 0;
  logic [3:1] descending = 0;
  bit [0:2] ascending = 0;
  wire floating;
  logic \literal.dot = 0;
  bit foo$bar = 0;
  bit \1foo = 0;
  bit \q[0] = 0;
  initial begin
    #2;
    q = 1; q = 0; q = 1;
    descending = 3'b101;
    ascending = 3'b100;
    \literal.dot = 1;
    #3 q = 'x;
    #2 q = 'z;
    #3 q = 0;
    #2 $finish;
  end
endmodule
