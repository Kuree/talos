// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: cp %S/Inputs/upf/assertions.tcl %t/assertions.tcl
// RUN: talos --upf %t/design.upf -emit-slang %t/design.sv -o %t.mlir | FileCheck %s
// RUN: FileCheck %s --check-prefix=IR < %t.mlir
// IEEE 1801-2018 5.3, 6.31 and 8.3.2: declared object identity,
// execution-time visibility, glob alternatives, model/direction queries and
// explicit bus element expansion. Query results remain usable as UPF names.
// CHECK: UPF design query semantics passed
// IR: upf.domain @top.PD elements ["top.a.b", "top.\\a.b ", "top.dutA", "top.dutB", "top.gen[0].child", "top.gen[1].child"]

//--- design.sv
module leaf #(parameter N=4)(input wire [1:3] din,
                             output wire [-2:1] dout, inout wire bus);
  wire [N-1:0] vec;
  wire [-2:1] alt;
  wire [1:0][-1:1] matrix;
  wire [1:0] unpacked[-1:1];
  wire [1:0] \tag[0] ;
  wire \literal.name , \slash/name , \vec[0] , \brace{1} ;
  initial begin : named_init
  end
  always @(din) begin : named_always
  end
endmodule
module middle(input wire [1:3] din, output wire [-2:1] dout, inout wire bus);
  leaf b(din,dout,bus);
endmodule
module top;
  wire [1:3] din;
  wire [-2:1] dout;
  wire bus;
  wire [1048576:0] unrelated_giant;
  leaf dutA(din,dout,bus);
  leaf #(.N(2)) dutB(din,dout,bus);
  leaf \a.b (din,dout,bus);
  middle a(din,dout,bus);
  for(genvar i=0;i<2;i++) begin : gen
    leaf child(din,dout,bus);
  end
  if(0) begin : absent
    leaf never_here(din,dout,bus);
  end
  initial begin
  end
endmodule

//--- design.upf
source [file join [file dirname [info script]] assertions.tcl]

# Alternatives may span hierarchy and nest; overlapping alternatives return
# each object only once. Empty alternatives keep the surrounding spelling.
assert_equal [find_objects . -pattern {{dutA,dutB}/vec} -object_type net] {dutA/vec dutB/vec}
assert_equal [find_objects . -pattern {{a/b,dutA}/vec} -object_type net] {a/b/vec dutA/vec}
assert_equal [find_objects . -pattern {dut{A,{B,A}}} -object_type inst] {dutA dutB}
assert_equal [find_objects . -pattern {dut{A,}} -object_type inst] dutA
assert_equal [find_objects . -pattern {{a/b,a\.b}/vec} -object_type net] [list a/b/vec {a\.b/vec}]
assert_equal [find_objects dutA -pattern {brace\{1\}} -object_type net] [list {dutA/brace{1}}]

# Model searches match the definition name, including parameter variants,
# and return instance paths rather than definition names.
set leaves [find_objects . -pattern leaf -object_type model -transitive]
assert_equal $leaves [list a/b {a\.b} dutA dutB {gen[0]/child} {gen[1]/child}]
assert_equal [find_objects . -pattern LEAF -exact -ignore_case -object_type model] [list {a\.b} dutA dutB]
assert_equal [find_objects . -pattern {^middle$} -regexp -object_type model] a
assert_equal [find_objects . -pattern never_here -object_type inst -transitive] {}
assert_equal [find_objects . -pattern {gen\[*\]/leaf} -object_type model] [list {gen[0]/child} {gen[1]/child}]

# Port metadata survives its backing variable/net declaration. Named process
# declarations join the default object kinds, without exposing helper locals.
assert_equal [find_objects dutA -pattern * -object_type port -direction in] dutA/din
assert_equal [find_objects dutA -pattern * -object_type port -direction out] dutA/dout
assert_equal [find_objects dutA -pattern * -object_type port -direction inout] dutA/bus
assert_equal [find_objects dutA -pattern din] dutA/din
assert_equal [find_objects dutA -pattern named* -object_type process] {dutA/named_always dutA/named_init}
assert_equal [find_objects dutA -pattern named*] {dutA/named_always dutA/named_init}
assert_equal [find_objects . -pattern * -object_type process] {}

# Default patterns return whole buses. Explicit brackets expand each
# alternative independently, in declaration order, including negative bounds.
assert_equal [find_objects dutA -pattern vec -object_type net] dutA/vec
assert_equal [find_objects dutA -pattern {alt\[*\]} -object_type net] [list {dutA/alt[-2]} {dutA/alt[-1]} {dutA/alt[0]} {dutA/alt[1]}]
assert_equal [find_objects dutA -pattern {{vec,alt\[*\]}} -object_type net] [list {dutA/alt[-2]} {dutA/alt[-1]} {dutA/alt[0]} {dutA/alt[1]} dutA/vec]
assert_equal [find_objects dutB -pattern {vec\[*\]} -object_type net] [list {dutB/vec[1]} {dutB/vec[0]} {dutB/vec\[0\]}]
assert_equal [find_objects dutA -pattern {din\[*\]} -object_type port -direction in] [list {dutA/din[1]} {dutA/din[2]} {dutA/din[3]}]
assert_equal [find_objects dutA -pattern {matrix\[1\]} -object_type net] [list {dutA/matrix[1]}]
assert_equal [find_objects dutA -pattern {matrix\[1\]\[*\]} -object_type net] [list {dutA/matrix[1][-1]} {dutA/matrix[1][0]} {dutA/matrix[1][1]}]
assert_equal [find_objects dutA -pattern {^alt\[[01]\]$} -regexp -object_type net] [list {dutA/alt[0]} {dutA/alt[1]}]
assert_equal [find_objects dutA -pattern {vec[2]} -exact -object_type net] [list {dutA/vec[2]}]
assert_equal [find_objects dutA -pattern {bus\[0\]} -object_type port] {}
assert_equal [find_objects dutA -pattern {unpacked\[*\]\[0\]} -object_type net] [list {dutA/unpacked[-1][0]} {dutA/unpacked[0][0]} {dutA/unpacked[1][0]}]
assert_equal [find_objects . -pattern {dutA/alt\[0\]} -object_type net -transitive] [list {dutA/alt[0]}]

# Escaped HDL identifiers are single components. Literal bracketed names
# remain distinct from bit selections of another declaration.
assert_equal [find_objects . -pattern {a.b} -exact -object_type inst] [list {a\.b}]
assert_equal [find_objects . -pattern a/b -exact -object_type inst] a/b
assert_equal [find_objects dutA -pattern {literal.name} -exact -object_type net] [list {dutA/literal\.name}]
assert_equal [find_objects dutA -pattern {slash\/name} -object_type net] [list {dutA/slash\/name}]
assert_equal [find_objects dutA -pattern {vec\[0\]} -object_type net] [list {dutA/vec[0]} {dutA/vec\[0\]}]
assert_equal [find_objects dutA -pattern {tag\[0\]} -object_type net] [list {dutA/tag\[0\]}]
assert_equal [find_objects dutA -pattern {tag\[0\]\[*\]} -object_type net] [list {dutA/tag\[0\][1]} {dutA/tag\[0\][0]}]
assert_equal [set_scope {a\.b}] /
assert_equal [find_objects . -pattern literal.name -exact -object_type net] [list {literal\.name}]
assert_equal [set_scope /] {/a\.b}
assert_equal [set_scope {gen[0]}] /
assert_equal [find_objects . -pattern leaf -object_type model] child
expect_error {create_power_domain Forbidden -elements child} {*cannot create UPF objects in a generate block*}
expect_error {create_supply_net Forbidden} {*cannot create UPF objects in a generate block*}
expect_error {create_supply_port Forbidden} {*cannot create UPF objects in a generate block*}
expect_error {create_supply_set Forbidden} {*cannot create UPF objects in a generate block*}
assert_equal [set_scope /] {/gen[0]}

# UPF supply ports become visible only when their command executes, and are
# separate from logic ports and the default find_objects object set.
assert_equal [find_objects . -pattern * -object_type supply_port] {}
create_supply_port PIN -direction in
create_supply_port POUT -direction out
create_supply_port PIO -direction inout
assert_equal [find_objects . -pattern * -object_type supply_port -direction in] PIN
assert_equal [find_objects . -pattern * -object_type supply_port -direction out] POUT
assert_equal [find_objects . -pattern * -object_type supply_port -direction inout] PIO
assert_equal [find_objects . -pattern P*] {}
set_scope dutA
create_supply_port LOCAL
set_scope /
assert_equal [find_objects . -pattern * -object_type supply_port -transitive] {PIN PIO POUT dutA/LOCAL}

expect_error {find_objects . -pattern * -direction in} {*requires port or supply_port*}
expect_error {find_objects . -pattern * -object_type port -direction bad} {*direction must be*}
expect_error {find_objects . -pattern * -object_type {}} {*unsupported*}
set bad [format {%c%s} 123 a,b]
expect_error [list find_objects . -pattern $bad] {*unmatched open brace*}
set bad [format {%s%c} bad 125]
expect_error [list find_objects . -pattern $bad] {*unmatched close brace*}
set huge [string repeat {{a,b}} 13]
expect_error [list find_objects . -pattern $huge] {*exceeds 4096 patterns*}
assert_equal [find_objects . -pattern dutA -exact -object_type inst] dutA
assert_equal [find_objects . -pattern {^missing\[0\]$} -regexp -object_type net] {}
expect_error {find_objects . -pattern {.*\[[0-9]+\]} -regexp -object_type net} {*bit expansion exceeds 1048576 elements*}
set nul [format {%s%c%s} dutA 0 suffix]
expect_error [list find_objects . -pattern $nul] {*no NUL characters*}
assert_equal [find_objects . -pattern dutA -exact -object_type inst] dutA

# The full query result can be used by a later power-intent declaration.
create_power_domain PD -elements $leaves
set_scope {gen[0]}
create_supply_port FROM_GEN -domain /PD
create_supply_net FROM_GEN_NET -domain /PD
set_scope /
assert_equal [find_objects . -pattern FROM_GEN -object_type supply_port] FROM_GEN
puts "UPF design query semantics passed"
