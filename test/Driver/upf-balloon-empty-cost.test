// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O3 --vpi=off -emit-sim %t/design.sv -o %t.empty.mlir
// RUN: talos --upf %t/baseline.upf -O3 --vpi=off -emit-sim %t/design.sv -o %t.base.mlir
// RUN: FileCheck %s --check-prefix=IR --input-file=%t.empty.mlir --implicit-check-not=__upf_balloon && FileCheck %s --check-prefix=IR --input-file=%t.base.mlir --implicit-check-not=__upf_balloon
// RUN: talos --upf %t/design.upf -O3 --vpi=off %t/design.sv -o %t.exe
// RUN: %t.exe | FileCheck %s --check-prefix=OUTPUT
// RUN: talos --upf %t/design.upf -O3 --vpi=off --execution-tier=bytecode %t/design.sv -o %t.bc && %t.bc | FileCheck %s --check-prefix=OUTPUT
// Empty retention adds no owner or registration beyond the ordinary-domain
// exact-loss policy. Compare the same nonempty domain without retention.
// True empty domains and ordinary no-UPF links retain no-service checks.
// IR-COUNT-1: simulation.event.snapshot.register
// IR-NOT: simulation.event.snapshot.register
// OUTPUT: empty retention cost passed

//--- design.sv
module leaf(input logic clk, output logic q = 0);
  always @(posedge clk) q <= !q;
endmodule
module top;
  import UPF::*;
  logic clk = 0, save = 0;
  wire q;
  leaf dut(clk,q);
  initial begin
    if (!supply_on("/top/CORE.power") || !supply_on("/top/CORE.ground", 0.0))
      $fatal(1, "supplies");
    #1 clk = 1;
    #1;
    $display("empty retention cost passed");
    $finish;
  end
endmodule

//--- baseline.upf
create_supply_set CORE
create_power_domain PD -elements dut -supply {primary CORE}
//--- design.upf
source [file join [file dirname [info script]] baseline.upf]
set_retention UNUSED -domain PD -elements {} -save_signal {save high}
