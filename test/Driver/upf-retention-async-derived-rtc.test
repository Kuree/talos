// REQUIRES: upf
// RUN: %split-file %s %t
// RUN: talos --upf %t/design.upf -O0 --mlir-verify-each %t/design.sv -o %t.o0
// RUN: %t.o0 | FileCheck %s
// RUN: talos --upf %t/design.upf -O3 --mlir-verify-each %t/design.sv -o %t.o3
// RUN: %t.o3 | FileCheck %s
// RUN: talos --upf %t/design.upf -O0 --execution-tier=bytecode --mlir-verify-each %t/design.sv -o %t.bc
// RUN: %t.bc | FileCheck %s
// IEEE 1801-2018 6.50/9.7.3: RTC can require parked clocks and resets.
// Deasserting that condition while primary is OFF destroys backing even
// though the ordinary reset writer is power-gated. Returning to NORMAL does
// not invent a reset edge; a new async edge recovers without a clock.
// CHECK: asynchronous derived RTC passed

//--- design.sv
module leaf(input logic clk, rst_n, input logic [7:0] d,
            output logic [7:0] q = 8'h13, output bit [7:0] qb = 8'h17);
  always_ff @(posedge clk or negedge rst_n) begin
    if (!rst_n) begin q <= 0; qb <= 0; end
    else begin q <= d; qb <= d; end
  end
endmodule
module top;
  import UPF::*;
  logic clk = 0, rst_n = 1, enable = 1;
  logic [7:0] d = 8'h53;
  wire [7:0] q, qb;
  leaf dut(clk,rst_n,d,q,qb);
  initial begin
    if (!supply_on("/top/AON.power") || !supply_on("/top/AON.ground", 0.0))
      $fatal(1, "initial supplies");
    #1 clk = 1;
    #1;
    if (q !== 8'h53 || qb !== 8'h53) $fatal(1, "clock admitted after RTC falls");
    clk = 0;
    #1 enable = 0;
    #1 enable = 1;
    #1;
    if (q !== 8'h53 || qb !== 8'h53) $fatal(1, "parked clock/reset lost backing");
    enable = 0;
    #1 rst_n = 0;
    #1 rst_n = 1;
    enable = 1;
    #1;
    if (q !== 'x || qb !== 0) $fatal(1, "reset while OFF did not destroy backing");
    rst_n = 0;
    #1;
    if (q !== 0 || qb !== 0) $fatal(1, "fresh async reset after RTC loss");
    $display("asynchronous derived RTC passed");
    $finish;
  end
endmodule

//--- design.upf
create_supply_net VDD
create_supply_set AON -function {power VDD}
create_supply_set SW -function {ground AON.ground}
create_power_domain PD -elements dut -supply {primary SW}
create_power_switch PS -domain PD \
    -input_supply_port {vin AON.power} -output_supply_port {vout PD.primary.power} \
    -control_port {en enable} -on_state {ON vin en}
set_retention KEEP -domain PD -retention_condition {!clk && rst_n}
