// RUN: not talos-translate --import-sdf %s 2>&1 | FileCheck %s

(DELAYFILE
  (SDFVERSION "4.0")
  (TIMESCALE 1ns)
  (CELL
    (CELLTYPE "dut")
    (INSTANCE)
    (TIMINGCHECK
      (HOLD (COND data==1 data ignored) clk (1)))))

// CHECK: error: conditional timing event requires exactly one expression and port
