// RUN: not talos-translate --import-saif %s 2>&1 | FileCheck %s
// RUN: talos-translate --import-saif --saif-verify=false --mlir-print-op-generic %s | FileCheck %s --check-prefix=IR
// RUN: talos-translate --import-saif --saif-verify=false %s | not talos-opt 2>&1 | FileCheck %s

(SAIFILE (SAIFVERSION "2.0") (DIRECTION "backward")
  (DESIGN) (DATE) (VENDOR) (PROGRAM_NAME) (PROGRAM_VERSION)
  (DIVIDER /) (TIMESCALE) (DURATION 100) (INSTANCE top (PORT (Y (IOPATH A (T1 1))))))

// CHECK-NOT: SAIF syntax:
// CHECK: error: {{.*}}requires exactly one toggle metric
// IR: "saif.file"
