// RUN: talos-translate --import-saif %s | talos-opt | FileCheck %s

(SAIFILE
  (SAIFVERSION "2.0") (DIRECTION "backward")
  (DESIGN) (DATE) (VENDOR) (PROGRAM_NAME) (PROGRAM_VERSION)
  (DIVIDER) (TIMESCALE) (DURATION 100)
  (INSTANCE top
    (NET (q (TC 1))) (NET (r (TC 2)))
    (PORT (q (TC 3))) (PORT (r (TC 4)))
    (INSTANCE child (NET (q (TC 5))))))

// CHECK: saif.nets
// CHECK: saif.metric TC #saif.number<"1">
// CHECK: saif.nets
// CHECK: saif.metric TC #saif.number<"2">
// CHECK: saif.ports
// CHECK: saif.metric TC #saif.number<"3">
// CHECK: saif.ports
// CHECK: saif.metric TC #saif.number<"4">
// CHECK: saif.instance #saif.path<[#saif.identifier<name = "child">]>
// CHECK: saif.metric TC #saif.number<"5">
