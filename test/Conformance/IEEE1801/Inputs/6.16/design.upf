create_supply_net VDD
create_supply_net VDD2
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_power_domain P -elements u0
create_supply_set SECOND -function {power VDD2} -function {ground VSS}
set_equivalent -function_only -sets {CORE SECOND}
create_power_domain Q -elements u1 -supply {primary SECOND}
create_composite_domain C -subdomains {P Q} -supply {primary CORE}
