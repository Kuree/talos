create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_power_domain PD -elements dut -supply {primary CORE}
add_power_state CORE -state {ON -supply_expr {power == {FULL_ON 1.0} && ground == {FULL_ON 0}}} -state {LOW -supply_expr {power == {FULL_ON 0.8}} -simstate NORMAL -illegal} -complete
if {[catch {add_power_state CORE -state {NEW -supply_expr {power == {FULL_ON 0.5}} -simstate NORMAL} -update}]} {create_supply_net closed}
