create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}
set_isolation ISO -domain PD -isolation_signal iso -clamp_value 0 -applies_to outputs -location parent
proc sv {text} {return "\"$text\""}
set h /top/PD.ISO
set parent [upf_query_object_properties $h -property upf_parent]
set kind [upf_query_object_type $parent]
set inStrategy [upf_object_in_class $parent -class upfStrategyT]
set absolute [upf_query_object_pathname $parent]
bind_checker show -module show -parameters [list [list parent [sv $parent]] [list kind [sv $kind]] [list inStrategy [sv $inStrategy]] [list absolute [sv $absolute]]]
