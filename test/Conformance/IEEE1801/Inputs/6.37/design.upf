create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_supply_net VRET
create_supply_set RET -function {power VRET} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}
set_retention KEEP -domain PD -elements dut/q -retention_supply RET -retention_condition rtc
map_retention_cell KEEP -domain PD -lib_model_name ret_model
