create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}
proc sv {text} {return "\"$text\""}
set path [upf_query_object_properties /top/PD -property upf_parent]
set extent [upf_query_object_properties $path -property upf_effective_extents]
bind_checker show -module show -parameters [list [list path [sv $path]] [list extent [sv $extent]]]
