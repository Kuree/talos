create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}
proc sv {text} {return "\"$text\""}
set upf [upf_query_object_type /top/PD]
set hdl [upf_query_object_type /top/dut]
set relationship [upf_query_object_type [upf_query_object_properties /top/PD -property upf_effective_extents]]
bind_checker show -module show -parameters [list [list upf [sv $upf]] [list hdl [sv $hdl]] [list relationship [sv $relationship]]]
