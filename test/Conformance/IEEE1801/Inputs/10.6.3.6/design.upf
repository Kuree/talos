set_scope u1
create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_power_domain PD -elements {.} -supply {primary CORE}
set_scope ..
set_scope u2
create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_power_domain PD -elements {.} -supply {primary CORE}
set_scope ..
set_partial_on_translation FULL_ON
