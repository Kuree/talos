create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_power_domain PD -elements dut -supply {primary CORE}
define_diode_clamp -cells clamp -data_pins d -type both -power VDDA -ground VSSA
if {![catch {define_diode_clamp -cells clamp -data_pins nope -type both}]} {error "unknown pin accepted"}
