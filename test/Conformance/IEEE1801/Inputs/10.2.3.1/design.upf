create_supply_net rail
proc object {name type} {
  if {![llength [info commands upf_query_object_type]]} {error "required query upf_query_object_type is unavailable"}
  foreach candidate [list /$name /top/$name] {
    if {![catch {upf_query_object_type $candidate} actual] && $actual eq $type} {return $candidate}
  }
  error "information-model handle unavailable: $name"
}
set h [object rail upfSupplyNetT]
if {[upf_query_object_properties $h -property upf_name] ne "rail"} {error "string property"}
if {![string is integer -strict [upf_query_object_properties $h -property upf_line]]} {error "integer property"}
set scope [upf_query_object_properties $h -property upf_creation_scope]
if {[upf_query_object_type $scope] ne "upfHdlScopeT"} {error "handle property"}
puts PASS
