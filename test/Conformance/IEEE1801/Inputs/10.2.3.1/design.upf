create_supply_port PAD -direction in
proc sv {text} {return "\"$text\""}
set name [upf_query_object_properties /top/PAD -property upf_name]
set line [upf_query_object_properties /top/PAD -property upf_line]
set dir [upf_query_object_properties /top/PAD -property upf_port_dir]
set parent [upf_query_object_properties /top/PAD -property upf_parent]
bind_checker show -module show -parameters [list [list name [sv $name]] [list line [sv $line]] [list dir [sv $dir]] [list parent [sv $parent]]]
