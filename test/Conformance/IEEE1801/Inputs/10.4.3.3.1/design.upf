proc object {name type} {
  if {![llength [info commands upf_query_object_type]]} {error "required query upf_query_object_type is unavailable"}
  foreach candidate [list /$name /top/$name] {
    if {![catch {upf_query_object_type $candidate} actual] && $actual eq $type} {return $candidate}
  }
  error "information-model handle unavailable: $name"
}
set h [object signal_value upfHdlNetMultiBitT]
if {[upf_query_object_properties $h -property upf_hdl_width] != 5} {error "normalized width"}
set bits [upf_query_object_properties $h -property upf_normalized_bits]
if {[llength $bits] != 5} {error "normalized bit list"}
puts PASS
