create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_supply_net VAUX
create_supply_set AUX -function {power VAUX} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE} -supply {aux AUX}
add_power_state CORE -state {ON -supply_expr {power == {FULL_ON 1.0} && ground == {FULL_ON 0}}} -state {LOW -supply_expr {power == {FULL_ON 0.7}} -simstate CORRUPT_ON_ACTIVITY}
add_power_state AUX -state {ON -supply_expr {power == {FULL_ON 1.0} && ground == {FULL_ON 0}}} -state {LOW -supply_expr {power == {FULL_ON 0.7}} -simstate CORRUPT_ON_CHANGE}
