create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_supply_net VAON
create_supply_set AON -function {power VAON} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}

set_port_attributes -ports dut/a -driver_supply AON
set_isolation ISO -domain PD -isolation_signal iso -clamp_value 0 -applies_to outputs -location parent -source CORE
