create_supply_net VDD
create_supply_set CORE -function {power VDD}
create_supply_net VSS
create_supply_set CORE -update -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}
proc sv {text} {return "\"$text\""}
set functions [lsort [upf_query_object_properties /top/CORE -property upf_functions]]
bind_checker show -module show -parameters [list [list functions [sv $functions]]]
