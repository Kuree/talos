create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_supply_net VMAC
create_supply_set MACS -function {power VMAC} -function {ground VSS}
define_power_model MACRO -for leaf {
  create_supply_set S
  create_power_domain INNER -elements . -supply {primary S}
}
create_power_domain PD -elements dut -supply {primary CORE}
apply_power_model MACRO -elements dut/mac -supply_map {{INNER.primary MACS}}
