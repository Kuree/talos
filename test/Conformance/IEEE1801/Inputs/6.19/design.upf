create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_power_domain PD -elements dut -supply {primary CORE}

set_scope dut
create_logic_port iso_p -direction in
set_scope /
create_logic_net iso_n
connect_logic_net iso_n -ports {ctl dut/iso_p}
set_isolation ISO -domain PD -isolation_signal dut/iso_p -clamp_value 0 -applies_to outputs -location parent
