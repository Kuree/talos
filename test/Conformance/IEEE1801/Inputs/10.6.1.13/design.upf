create_supply_net VDD
create_supply_net VSS
create_supply_set AON -function {power VDD} -function {ground VSS}
create_supply_set SW -function {ground VSS}
create_power_domain PD -elements dut -supply {primary SW}
create_power_switch PS -domain PD -input_supply_port {vin AON.power} -output_supply_port {vout SW.power} -control_port {ss_ctrl en} -on_state {ss_on vin {ss_ctrl}} -off_state {ss_off {!ss_ctrl}} -ack_port {ts_ack ack} -ack_delay {ts_ack 100ns}
