# create_supply_set CORE is commented out here, so the set below is the first
create_supply_net VDD ;# a trailing comment
create_supply_net \
  VSS
create_supply_net vdd
create_supply_set CORE -function {power VDD} \
                       -function {ground VSS}
create_power_domain PD -elements {dut} -supply {primary CORE}
