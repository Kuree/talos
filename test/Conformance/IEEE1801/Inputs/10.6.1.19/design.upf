create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}
add_power_state CORE -state {FAST -supply_expr {power == {FULL_ON 1.0}} -simstate NORMAL} -state {SLEEP -supply_expr {power == OFF} -simstate CORRUPT}
add_state_transition -supply CORE -transition {turn_on -from SLEEP -to FAST -illegal}
