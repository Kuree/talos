create_supply_net VDD
create_supply_net VSS
create_supply_set CORE -function {power VDD} -function {ground VSS}

create_supply_net VLS
create_supply_set LS -function {power VLS} -function {ground VSS}
create_power_domain PD -elements dut -supply {primary CORE}

set_isolation ISO -domain PD -isolation_signal iso -clamp_value 0 -applies_to outputs -location parent
set_level_shifter SHIFT -domain PD -applies_to outputs -location parent -input_supply_set CORE -output_supply_set LS
