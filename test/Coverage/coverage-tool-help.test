# HELP-DAG: report

# MERGE-DAG: --discard-test-detail
# MERGE-DAG: --output

# REPORT-DAG: --format
# REPORT-DAG: --test
# REPORT-DAG: --source-root
# REPORT-DAG: --std
# REPORT-DAG: --fail-under
# REPORT-DAG: --output

# INSPECT: --help
