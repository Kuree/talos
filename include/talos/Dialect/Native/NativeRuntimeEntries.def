TALOS_NATIVE_RUNTIME(ControlEnter, talos_rt_v1_control_enter,
                     SIG(I32, Ptr, I64, Ptr), ObservesThread)
TALOS_NATIVE_RUNTIME(ControlEscapePending, talos_rt_v1_control_escape_pending,
                     SIG(I32, Ptr), ObservesThread)
TALOS_NATIVE_RUNTIME(ControlLeave, talos_rt_v1_control_leave,
                     SIG(I32, Ptr, I64), ObservesThread)
TALOS_NATIVE_RUNTIME(ImportCall, talos_rt_v1_import_call,
                     SIG(I32, Ptr, Ptr, Ptr, I32, Ptr, I32), ObservesThread)
TALOS_NATIVE_RUNTIME(ImportCallGuarded, talos_rt_v1_import_call_guarded,
                     SIG(I32, I32, Ptr, Ptr, Ptr, I32, Ptr, I32),
                     ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessControl, talos_rt_v1_process_control,
                     SIG(I32, Ptr, I64, I32, Ptr), ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessCurrent, talos_rt_v1_process_current, SIG(I64, Ptr),
                     ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessEventPending, talos_rt_v1_process_event_pending,
                     SIG(I32, Ptr, I64, Ptr), ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessInstanceCreate, talos_rt_v1_process_instance_create,
                     SIG(I32, Ptr, Ptr), ObservesThread)
// Declared in runtime/lib/PrivateEntries.h, not in the public headers.
TALOS_NATIVE_RUNTIME(ProcessInstanceCreateForContext,
                     talos_rt_v1_process_instance_create_for_context,
                     SIG(I32, Ptr, Ptr, Ptr), ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessInstanceDestroy,
                     talos_rt_v1_process_instance_destroy, SIG(I32, Ptr),
                     ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessInstanceExecute,
                     talos_rt_v1_process_instance_execute,
                     SIG(I32, Ptr, Ptr, I32, Ptr), ObservesThread)
TALOS_NATIVE_RUNTIME(ProcessInstanceFrame, talos_rt_v1_process_instance_frame,
